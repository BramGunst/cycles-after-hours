diff --git a/intern/cycles/kernel/svm/geometry_distance.h b/intern/cycles/kernel/svm/geometry_distance.h
new file mode 100644
--- /dev/null
+++ b/intern/cycles/kernel/svm/geometry_distance.h
@@ -0,0 +1,50 @@
+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+#include "kernel/bvh/geometry_distance.h"
+#include "kernel/svm/node_types.h"
+#include "kernel/svm/util.h"
+
+CCL_NAMESPACE_BEGIN
+
+ccl_device_noinline void svm_node_geometry_distance(KernelGlobals kg,
+                                                    ccl_private ShaderData *sd,
+                                                    ccl_private float *stack,
+                                                    const ccl_global SVMNodeGeometryDistance &node)
+{
+  const float3 position = stack_valid(node.position_offset) ?
+                              stack_load_float3(stack, node.position_offset) :
+                              sd->P;
+  const float max_distance = fmaxf(stack_load(stack, node.max_distance), 0.0f);
+  const GeometryDistanceResult result = geometry_distance_scene(
+      kg, position, sd->object, max_distance, sd->time);
+  const bool found = result.supported && result.found;
+  const float distance = found ? result.distance : max_distance;
+  float factor = !found              ? 0.0f :
+                 max_distance > 0.0f ? saturatef(1.0f - distance / max_distance) :
+                 distance <= 0.0f    ? 1.0f :
+                                       0.0f;
+  if (found && max_distance > 0.0f) {
+    if (node.falloff == NODE_GEOMETRY_DISTANCE_SMOOTH) {
+      factor = factor * factor * (3.0f - 2.0f * factor);
+    }
+    else if (node.falloff == NODE_GEOMETRY_DISTANCE_SPHERE) {
+      const float t = saturatef(distance / max_distance);
+      factor = sqrtf(fmaxf(0.0f, 1.0f - t * t));
+    }
+  }
+  if (stack_valid(node.distance_offset)) {
+    stack_store_float(stack, node.distance_offset, distance);
+  }
+  if (stack_valid(node.factor_offset)) {
+    stack_store_float(stack, node.factor_offset, factor);
+  }
+  if (stack_valid(node.found_offset)) {
+    stack_store_float(stack, node.found_offset, found ? 1.0f : 0.0f);
+  }
+}
+
+CCL_NAMESPACE_END
