+TEST(geometry_distance_scene, public_node_svm)
+{
+  for (const bool connected : {false, true}) {
+    BuiltScene b;
+    b.object(b.mesh(plane()), transform_identity());
+    auto graph = make_unique<ShaderGraph>();
+    auto *node = graph->create_node<GeometryDistanceNode>();
+    ASSERT_EQ(node->inputs.size(), 2);
+    ASSERT_EQ(node->outputs.size(), 3);
+    EXPECT_EQ(node->inputs[0]->name(), "Position");
+    EXPECT_EQ(node->inputs[1]->name(), "Max Distance");
+    EXPECT_EQ(node->outputs[0]->name(), "Distance");
+    EXPECT_EQ(node->outputs[1]->name(), "Factor");
+    EXPECT_EQ(node->outputs[2]->name(), "Found");
+    EXPECT_EQ(node->get_feature(), KERNEL_FEATURE_GEOMETRY_DISTANCE);
+    if (connected) {
+      auto *vector = graph->create_node<CombineXYZNode>();
+      graph->connect(vector->output("Vector"), node->input("Position"));
+    }
+    auto *combine = graph->create_node<CombineXYZNode>();
+    graph->connect(node->output("Distance"), combine->input("X"));
+    graph->connect(node->output("Factor"), combine->input("Y"));
+    graph->connect(node->output("Found"), combine->input("Z"));
+    auto *emission = graph->create_node<EmissionNode>();
+    graph->connect(combine->output("Vector"), emission->input("Color"));
+    graph->connect(emission->output("Emission"), graph->output()->input("Surface"));
+    b.scene->default_surface->set_graph(std::move(graph));
+    b.scene->default_surface->tag_update(b.scene.get());
+    b.publish();
+    ASSERT_FALSE(::testing::Test::HasFatalFailure());
+    EXPECT_TRUE(b.scene->dscene.data.kernel_features & KERNEL_FEATURE_GEOMETRY_DISTANCE);
+    ASSERT_TRUE(b.scene->dscene.data.svm_usage.NODE_GEOMETRY_DISTANCE);
+    auto &nodes = b.scene->dscene.svm_nodes;
+    bool seen = false;
+    for (size_t i = 0; i + 2 < nodes.size(); i++) {
+      if (nodes[i] != NODE_GEOMETRY_DISTANCE)
+        continue;
+      const auto &op = *reinterpret_cast<const SVMNodeGeometryDistance *>(&nodes[i + 1]);
+      EXPECT_NE(op.position_offset, SVM_STACK_INVALID);
+      EXPECT_NE(op.distance_offset, SVM_STACK_INVALID);
+      EXPECT_NE(op.factor_offset, SVM_STACK_INVALID);
+      EXPECT_NE(op.found_offset, SVM_STACK_INVALID);
+      seen = true;
+      break;
+    }
+    EXPECT_TRUE(seen);
+  }
+}
