+  b.object(cloud, transform_identity());
+  b.object(cloud, translation(0, 0, 5));
+  const int later = b.cloud({{make_float4(20, 0, 1, 0.25f)}});
+  b.object(later, transform_identity());
+  auto verify = [&]() {
+    b.publish();
+    ASSERT_FALSE(::testing::Test::HasFatalFailure());
+    for (const float3 query : {zero_float3(),
+                               make_float3(2, 0, 0),
+                               make_float3(10, 0, 0),
+                               make_float3(20, 0, 0),
+                               make_float3(2, 0, 5)})
+    {
+      b.compare(query, 0, 20);
