+  ShaderData sd = {};
+  sd.P = make_float3(0, 0, 0.25f);
+  sd.object = OBJECT_NONE;
+  sd.time = 0.5f;
+  float stack[SVM_STACK_SIZE] = {};
+  SVMNodeGeometryDistance op = {{__float_as_uint(1.0f)}, SVM_STACK_INVALID, 0, 1, 2};
+  svm_node_geometry_distance(&(*globals)[0], &sd, stack, op);
+  EXPECT_NEAR(stack[0], 0.25f, 1e-6f);
+  EXPECT_NEAR(stack[1], 0.75f, 1e-6f);
+  EXPECT_EQ(stack[2], 1.0f);
+  op.position_offset = 3; /* Explicitly connected world origin, not sd.P. */
+  svm_node_geometry_distance(&(*globals)[0], &sd, stack, op);
+  EXPECT_EQ(stack[0], 0.0f);
+  EXPECT_EQ(stack[1], 1.0f);
+  EXPECT_EQ(stack[2], 1.0f);
+  sd.object = 0; /* Automatic current-object exclusion. */
+  svm_node_geometry_distance(&(*globals)[0], &sd, stack, op);
+  EXPECT_EQ(stack[0], 1.0f);
+  EXPECT_EQ(stack[1], 0.0f);
+  EXPECT_EQ(stack[2], 0.0f);
+  sd.object = OBJECT_NONE;
+  op.max_distance.bits = __float_as_uint(0.1f);
+  op.position_offset = SVM_STACK_INVALID;
+  svm_node_geometry_distance(&(*globals)[0], &sd, stack, op);
+  EXPECT_EQ(stack[0], 0.1f);
+  EXPECT_EQ(stack[1], 0.0f);
+  EXPECT_EQ(stack[2], 0.0f);
+  op.max_distance.bits = __float_as_uint(0.0f);
+  svm_node_geometry_distance(&(*globals)[0], &sd, stack, op);
+  EXPECT_EQ(stack[0], 0.0f);
+  EXPECT_EQ(stack[1], 0.0f);
+  EXPECT_EQ(stack[2], 0.0f);
+  b.device->release_cpu_kernel_thread_globals();
+}
