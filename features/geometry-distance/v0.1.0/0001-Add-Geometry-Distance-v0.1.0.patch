+  const Record b = f.leaf(1, 2, right, PRIMITIVE_TRIANGLE);
+  f.scene_records = {f.join(a, b)};
+  compare("spatial_split_right", f, make_float3(0.5f, -1, 0.25f), -1, 0.3f, 0.25f);
+  compare("spatial_split_left", f, make_float3(-0.5f, -1, 0.25f), -1, 0.3f, 0.25f);
+}
