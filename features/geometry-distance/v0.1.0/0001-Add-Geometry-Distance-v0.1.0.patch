+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+// clang-format off
+#include "kernel/device/optix/compat.h"
+#include "kernel/device/optix/globals.h"
+#include "kernel/device/gpu/image.h"
+#include "kernel/bvh/bvh.h"
+#include "kernel/bvh/geometry_distance.h"
+#include "test/geometry_distance_production.h"
+// clang-format on
+
+extern "C" __global__ void __raygen__geometry_distance_production()
+{
+  auto &query = reinterpret_cast<GeometryDistanceProductionQuery *>(
+      kernel_params.render_buffer)[optixGetLaunchIndex().x];
+  for (int i = 0; i < 4; i++) {
+    Ray ray = {};
+    ray.P = make_float3(query.position_radius) - make_float3(0, 0, 4);
+    ray.D = make_float3(0, 0, 1);
+    ray.tmax = 100;
+    ray.time = query.time;
+    ray.self = {PRIM_NONE, OBJECT_NONE, PRIM_NONE, OBJECT_NONE};
+    Intersection intersection = {};
+    const bool hit = scene_intersect(nullptr, &ray, PATH_RAY_VISIBILITY_CAMERA, &intersection);
+    query.ray[i] = {intersection.t, int(hit), intersection.object, intersection.prim};
+    if (i < 3) {
+      query.result[i] = geometry_distance_scene(nullptr,
+                                                make_float3(query.position_radius),
+                                                query.current_object,
+                                                query.position_radius.w,
+                                                query.time,
+                                                &query.stats[i]);
+    }
+  }
+}
