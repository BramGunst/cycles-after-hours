+    b.compare(make_float3(0, 0, 0.1f), -1, 20);
+    b.compare(make_float3(0, 0, 5), 1, 20);
+    EXPECT_EQ(b.scene->dscene.object_node[1], b.scene->dscene.object_node[2]);
+  };
+  auto update = [&](const std::vector<float4> &points, const bool topology) {
+    PointCloud *native = b.pointclouds[cloud];
+    if (topology) {
+      native->resize(int(points.size()));
+    }
+    for (int i = 0; i < int(points.size()); i++) {
+      native->get_position_for_write()[i] = make_float3(points[i]);
+      native->get_radius_for_write()[i] = points[i].w;
+      native->get_shader()[i] = 0;
+    }
+    native->tag_position_modified();
+    native->tag_radius_modified();
+    native->tag_update(b.scene.get(), topology);
+    b.source.point_keys[cloud][0] = points;
+    b.source.primitive_base[later] = int(points.size());
+    verify();
+  };
+  verify();
+  update({make_float4(2, 0, 1, 0.25f), make_float4(10, 0, 1, 0.5f)}, false);
+  update({make_float4(2, 0, 1, 0.75f), make_float4(10, 0, 1, 0.5f)}, false);
+  update({make_float4(2, 0, 1, 0.75f), make_float4(10, 0, 1, 0.5f), make_float4(0, 0, 0.2f, 0.1f)},
+         true);
+  update({make_float4(2, 0, 1, 0.75f)}, true);
+  for (int i = 0; i < 3; i++) {
+    b.meshes[mesh]->get_position_for_write()[i].z = -2;
+    b.source.meshes[mesh][0][i].z = -2;
+  }
+  b.meshes[mesh]->tag_position_modified();
+  b.meshes[mesh]->tag_update(b.scene.get(), false);
+  verify();
+}
