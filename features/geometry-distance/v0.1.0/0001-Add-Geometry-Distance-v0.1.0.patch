+  mesh->set_use_motion_blur(true);
+  Attribute *positions = mesh->attributes.find(ATTR_STD_POSITION);
+  positions->add_motion(mesh);
+  positions->data_for_write<packed_float3>(1)[0] = make_float3(0.25f, 0.5f, 0);
+  positions->data_for_write<packed_float3>(2)[0] = make_float3(0.25f, 0.5f, 2);
+  b.scene->integrator->set_motion_blur(true);
+  mesh->tag_update(b.scene.get(), true);
+  b.publish();
+  ASSERT_FALSE(HasFatalFailure());
+  globals = b.device->acquire_cpu_kernel_thread_globals();
+  for (const float time : {0.0f, 0.25f, 0.5f, 0.75f, 1.0f}) {
+    const float3 p = transform_point(&tfm, make_float3(0.25f, 0.5f, 2 * time));
+    const auto hit = geometry_distance_scene(&(*globals)[0], p, 0, 0.1f, time);
+    EXPECT_TRUE(hit.found);
+    EXPECT_NEAR(hit.distance, 0.0f, 1e-6f);
+  }
+  b.device->release_cpu_kernel_thread_globals();
+}
