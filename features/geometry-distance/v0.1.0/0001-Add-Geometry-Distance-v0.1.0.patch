+  EXPECT_TRUE(excluded.found);
+  EXPECT_EQ(excluded.object, 2);
+  b.device->release_cpu_kernel_thread_globals();
+  /* Only the loose vertices are point references; normal face vertices stay triangles. */
+  int points = 0;
+  for (size_t i = 0; i < b.scene->dscene.geometry_distance_prim_type.size(); i++) {
+    const int type = b.scene->dscene.geometry_distance_prim_type[i];
+    points += (type & GEOMETRY_DISTANCE_LOOSE_VERTEX) == GEOMETRY_DISTANCE_LOOSE_VERTEX;
