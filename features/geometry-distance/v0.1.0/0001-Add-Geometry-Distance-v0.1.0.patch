+                                             make_float4(offset, offset, offset, 2),
+                                             identity, &distance));
+    EXPECT_FLOAT_EQ(distance, 2);
+  }
+  float distance;
+  ASSERT_TRUE(point_affine_sphere_distance(make_float3(3, 4, 0), make_float4(0, 0, 0, 0),
+                                           identity, &distance));
+  EXPECT_FLOAT_EQ(distance, 5);
+}
+
+TEST(math_distance, affine_sphere_surface)
+{
+  /* Independent normal construction: outside a convex surface, moving along
+   * its outward normal preserves the closest point. */
+  for (const float aspect : {1.0f, 2.0f, 100.0f, 1000.0f}) {
+    for (const float shear : {0.0f, 0.75f}) {
+      for (const float reflection : {-1.0f, 1.0f}) {
+        Transform tfm = transform_identity();
+        tfm.x = make_float4(reflection * aspect, shear, 0, -3);
+        tfm.y = make_float4(0, 1, 0, 2);
+        tfm.z = make_float4(0, 0, 0.5f, -1);
+        for (const float3 direction : {make_float3(1, 0, 0), make_float3(0, 1, 0),
+                                      make_float3(0, 0, 1), normalize(make_float3(1, 2, 3))}) {
+          const float3 surface = transform_point(&tfm, direction);
+          const float nx = direction.x / (reflection * aspect);
+          const float3 normal = normalize(make_float3(nx, direction.y - shear * nx,
+                                                     2 * direction.z));
+          for (const float offset : {0.0f, 0.0001f, 0.125f, 3.0f}) {
+            const float3 query = surface + offset * normal;
+            float distance;
+            ASSERT_TRUE(point_affine_sphere_distance(query, make_float4(0, 0, 0, 1),
+                                                     tfm, &distance));
+            EXPECT_NEAR(distance, offset, 3e-5f * std::max(1.0f, aspect / 100));
+          }
+        }
+        float distance;
+        ASSERT_TRUE(point_affine_sphere_distance(make_float3(-3, 2, -1),
+                                                 make_float4(0, 0, 0, 1), tfm, &distance));
+        EXPECT_NEAR(distance, 0.5f, 1e-6f);
+      }
+    }
+  }
+  Transform tfm = transform_identity();
+  tfm.x.x = 2;
+  float distance;
+  /* Interior pole solution: x=(4/3*y, sqrt(1-x*x/4), 0). */
+  ASSERT_TRUE(point_affine_sphere_distance(make_float3(0.5f, 0, 0), make_float4(0, 0, 0, 1),
+                                           tfm, &distance));
+  EXPECT_NEAR(distance, std::sqrt(11.0 / 12.0), 1e-6);
+  ASSERT_TRUE(point_affine_sphere_distance(make_float3(0.5f, 1e-12f, 0),
+                                           make_float4(0, 0, 0, 1), tfm, &distance));
+  EXPECT_NEAR(distance, std::sqrt(11.0 / 12.0), 1e-6);
+  tfm.z.z = 0;
+  EXPECT_FALSE(point_affine_sphere_distance(zero_float3(), make_float4(0, 0, 0, 1),
+                                            tfm, &distance));
+  EXPECT_TRUE(std::isfinite(distance));
+}
+
+CCL_NAMESPACE_END
