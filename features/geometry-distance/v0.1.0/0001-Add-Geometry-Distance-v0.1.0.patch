+TEST(geometry_distance, point_affine_and_motion)
+{
+  for (int mode = 0; mode < 6; mode++) {
+    Fixture f;
+    const int cloud = f.point_geometry({{make_float4(0.25f, 0, 0, 0.5f)}});
+    Transform tfm = translation(-2, 3, 1);
+    if (mode == 1) {
+      tfm.x = make_float4(0, -1, 0, -2);
+      tfm.y = make_float4(1, 0, 0, 3);
+    }
+    if (mode == 2 || mode == 3) {
+      tfm.x.x = tfm.y.y = tfm.z.z = mode == 2 ? 2.0f : -2.0f;
+    }
+    if (mode >= 4) {
+      tfm.x.x = 3;
+      tfm.z.z = 0.25f;
+      tfm.x.y = mode == 5 ? 0.75f : 0.0f;
+    }
+    f.object(cloud, tfm);
+    for (const float3 p : {make_float3(-2, 3, 1),
+                           make_float3(0, 2, 3),
+                           make_float3(-1.75f, 3, 1),
+                           make_float3(-2, 3, 1.01f)})
+    {
+      compare("point_affine", f, p, -1, 20, oracle(f, p, -1, 20).distance);
+    }
+  }
+  for (int motion = 0; motion < 3; motion++) {
+    Fixture f;
+    std::vector<std::vector<float4>> keys;
+    for (int k = 0; k < 5; k++) {
+      keys.push_back({make_float4(
+          motion == 1 ? 0.0f : float(k % 2) * 4, 0, 0, motion == 0 ? 0.5f : 0.5f + float(k % 2))});
+    }
+    const int cloud = f.point_geometry(keys);
+    f.object(cloud, transform_identity());
+    for (const float time : {0.0f, 0.125f, 0.25f, 0.5f, 0.75f, 1.0f}) {
+      const float3 p = make_float3(2, 0, 0);
+      compare("point_motion", f, p, -1, 10, oracle(f, p, -1, 10, time).distance, true, time);
+    }
+  }
+  Fixture unsupported;
+  const int cloud = unsupported.point_geometry({{make_float4(0, 0, 0, 1)}});
+  Transform singular = transform_identity();
+  singular.z.z = 0;
+  unsupported.object(cloud, singular);
+  unsupported.finish();
+  const auto result = geometry_distance_other_geometry(
+      unsupported.view(), zero_float3(), -1, 10, 0);
+  EXPECT_FALSE(result.supported);
+  EXPECT_FALSE(result.found);
+  compare_cuda(unsupported, zero_float3(), -1, 10, 0, {false, false, 10, -1, -1, 0});
+  EXPECT_TRUE(
+      geometry_distance_other_geometry(unsupported.view(), zero_float3(), 0, 10, 0).supported);
+}
