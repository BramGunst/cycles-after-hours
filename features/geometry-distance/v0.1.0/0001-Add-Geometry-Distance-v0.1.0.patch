+CCL_NAMESPACE_BEGIN
+
+namespace {
+
+TEST(kernel_features, values_and_storage)
+{
+  const KernelFeatures bits[] = {KERNEL_FEATURE_NODE_BSDF,
+                                 KERNEL_FEATURE_NODE_EMISSION,
+                                 KERNEL_FEATURE_NODE_VOLUME,
+                                 KERNEL_FEATURE_NODE_BUMP,
+                                 KERNEL_FEATURE_NODE_BUMP_STATE,
+                                 KERNEL_FEATURE_NODE_VORONOI_EXTRA,
+                                 KERNEL_FEATURE_NODE_RAYTRACE,
+                                 KERNEL_FEATURE_NODE_AOV,
+                                 KERNEL_FEATURE_NODE_LIGHT_PATH,
+                                 KERNEL_FEATURE_NODE_PRINCIPLED_HAIR,
+                                 KERNEL_FEATURE_NODE_PORTAL,
+                                 KERNEL_FEATURE_PATH_TRACING,
+                                 KERNEL_FEATURE_POINTCLOUD,
+                                 KERNEL_FEATURE_HAIR_RIBBON,
+                                 KERNEL_FEATURE_HAIR_THICK,
+                                 KERNEL_FEATURE_OBJECT_MOTION,
+                                 KERNEL_FEATURE_BAKING,
+                                 KERNEL_FEATURE_SUBSURFACE,
+                                 KERNEL_FEATURE_VOLUME,
+                                 KERNEL_FEATURE_TRANSPARENT,
+                                 KERNEL_FEATURE_SHADOW_CATCHER,
+                                 KERNEL_FEATURE_LIGHT_PASSES,
+                                 KERNEL_FEATURE_AO_PASS,
+                                 KERNEL_FEATURE_AO_ADDITIVE,
+                                 KERNEL_FEATURE_MNEE,
+                                 KERNEL_FEATURE_PATH_GUIDING,
+                                 KERNEL_FEATURE_OSL_SHADING,
+                                 KERNEL_FEATURE_OSL_CAMERA,
+                                 KERNEL_FEATURE_LIGHT_LINKING,
+                                 KERNEL_FEATURE_SHADOW_LINKING,
+                                 KERNEL_FEATURE_DENOISING,
+                                 KERNEL_FEATURE_LIGHT_TREE,
+                                 KERNEL_FEATURE_GEOMETRY_DISTANCE};
+  for (int i = 0; i < 33; i++) {
+    EXPECT_EQ(bits[i], KernelFeatures(1) << i);
+  }
+  const KernelFeatures mixed = bits[0] | bits[31] | bits[32];
+  EXPECT_EQ(mixed, 0x180000001ULL);
+  EXPECT_EQ(mixed & ~bits[31], bits[0] | bits[32]);
+  EXPECT_EQ((~KernelFeatures(0)) & mixed, mixed);
+  EXPECT_TRUE(KernelFeatureRequest(bits[32], bits[1]).test(mixed));
+  EXPECT_FALSE(KernelFeatureRequest(bits[32], bits[0]).test(mixed));
+  KernelData data = {};
+  data.kernel_features = mixed;
+  EXPECT_EQ(data.kernel_features, mixed);
+  std::printf("feature_layout size=%zu align=%zu features=%zu camera=%zu bvh=%zu mask=%llu\n",
+              sizeof(data),
+              alignof(KernelData),
+              offsetof(KernelData, kernel_features),
+              offsetof(KernelData, cam),
+              offsetof(KernelData, device_bvh),
+              static_cast<unsigned long long>(data.kernel_features));
+#ifdef WITH_GEOMETRY_DISTANCE_CUDA
+  unsigned long long observed[4] = {};
+  ASSERT_EQ(geometry_distance_cuda_features(&data, sizeof(data), observed), 0);
+  EXPECT_EQ(observed[0], mixed);
+  EXPECT_EQ(observed[1], sizeof(KernelData));
+  EXPECT_EQ(observed[2], offsetof(KernelData, cam));
+  EXPECT_EQ(observed[3], offsetof(KernelData, device_bvh));
+#endif
+}
+
+#ifdef WITH_GEOMETRY_DISTANCE_CUDA
+int cuda_queries = 0;
+float cuda_max_error = 0;
+int cuda_point_queries = 0;
+float cuda_point_max_error = 0;
+int cuda_mismatches[5] = {};
+#endif
+
+using Triangle = std::array<float3, 3>;
+
+struct Bounds {
+  float3 lo = make_float3(FLT_MAX, FLT_MAX, FLT_MAX);
+  float3 hi = make_float3(-FLT_MAX, -FLT_MAX, -FLT_MAX);
+  void grow(const float3 p)
+  {
+    lo = min(lo, p);
+    hi = max(hi, p);
+  }
+};
+
+struct Record {
+  int address;
+  Bounds bounds;
+};
+
+/* Small deterministic fixtures in the layout of BVH2::pack_leaf and
+ * BVH2::pack_aligned_node. This does not replace the scene BVH builder. */
+struct Fixture {
+  std::vector<float4> nodes, leaves;
+  std::vector<uint> roots, types, indices, owners, flags;
+  std::vector<KernelObject> objects;
+  std::vector<packed_uint3> tri_indices;
+  std::vector<packed_float3> vertices;
+  std::vector<float2> times;
+  std::vector<std::vector<Triangle>> meshes;
+  std::vector<std::vector<std::vector<Triangle>>> motion_keys;
+  std::vector<std::vector<std::vector<float4>>> point_keys;
+  std::vector<float4> packed_points;
+  std::vector<int> point_offsets;
+  int num_source_points = 0;
+  std::vector<int> object_mesh, primitive_base;
+  std::vector<Record> scene_records;
+  int root = -1;
+
+  Record leaf(const int begin, const int end, const Bounds bounds, const uint type)
+  {
+    const int address = ~int(leaves.size());
+    leaves.push_back(make_float4(
+        __int_as_float(begin), __int_as_float(end), __uint_as_float(~0u), __uint_as_float(type)));
+    return {address, bounds};
+  }
+
+  Record join(const Record a, const Record b)
+  {
+    const int address = int(nodes.size());
+    nodes.push_back(make_float4(0, 0, __int_as_float(a.address), __int_as_float(b.address)));
+    nodes.push_back(make_float4(a.bounds.lo.x, b.bounds.lo.x, a.bounds.hi.x, b.bounds.hi.x));
+    nodes.push_back(make_float4(a.bounds.lo.y, b.bounds.lo.y, a.bounds.hi.y, b.bounds.hi.y));
+    nodes.push_back(make_float4(a.bounds.lo.z, b.bounds.lo.z, a.bounds.hi.z, b.bounds.hi.z));
+    Bounds bounds = a.bounds;
+    bounds.grow(b.bounds.lo);
+    bounds.grow(b.bounds.hi);
+    return {address, bounds};
+  }
+
+  int mesh(const std::vector<Triangle> &triangles)
+  {
+    const int mesh = int(meshes.size());
+    meshes.push_back(triangles);
+    motion_keys.emplace_back();
+    point_keys.emplace_back();
+    point_offsets.push_back(0);
+    primitive_base.push_back(int(tri_indices.size()));
+    for (const Triangle &tri : triangles) {
+      const uint n = uint(vertices.size());
+      tri_indices.push_back(make_uint3(n, n + 1, n + 2));
+      for (const float3 v : tri) {
+        vertices.push_back(v);
+      }
+    }
+    return mesh;
+  }
+
+  int object(const int mesh, const Transform tfm, const bool applied = false)
+  {
+    if (!point_keys[mesh].empty()) {
+      return point_object(mesh, tfm, applied);
+    }
+    const int object = int(objects.size());
+    KernelObject ob = {};
+    ob.tfm = tfm;
+    ob.numprims = int(meshes[mesh].size());
+    ob.num_geom_steps = motion_keys[mesh].empty() ? 1 : uint16_t(motion_keys[mesh].size());
+    ob.numverts = int(meshes[mesh].size()) * 3;
+    objects.push_back(ob);
+    object_mesh.push_back(mesh);
+    flags.push_back(applied ? SD_OBJECT_TRANSFORM_APPLIED : 0);
+    roots.push_back(0);
+    Bounds world;
+    std::vector<Record> mesh_records;
+    for (int i = 0; i < ob.numprims; i++) {
+      Bounds local;
+      for (const float3 v : meshes[mesh][i]) {
+        local.grow(v);
+        world.grow(applied ? v : transform_point(&tfm, v));
+      }
+      for (const auto &key : motion_keys[mesh]) {
+        for (const float3 v : key[i]) {
+          local.grow(v);
+          world.grow(applied ? v : transform_point(&tfm, v));
+        }
+      }
+      const int ref = int(indices.size());
+      indices.push_back(primitive_base[mesh] + i);
+      owners.push_back(object);
+      const uint type = ob.num_geom_steps > 1 ? PRIMITIVE_MOTION_TRIANGLE : PRIMITIVE_TRIANGLE;
+      types.push_back(type);
+      mesh_records.push_back(leaf(ref, ref + 1, local, type));
+    }
+    Record mesh_root = mesh_records[0];
+    for (size_t i = 1; i < mesh_records.size(); i++) {
+      mesh_root = join(mesh_root, mesh_records[i]);
+    }
+    roots[object] = mesh_root.address;
+    if (applied) {
+      scene_records.push_back(mesh_root);
+    }
+    else {
+      const int ref = int(indices.size());
+      indices.push_back(uint(-1));
+      owners.push_back(object);
+      types.push_back(PRIMITIVE_TRIANGLE);
+      scene_records.push_back(leaf(~ref, 0, world, PRIMITIVE_TRIANGLE));
+    }
+    return object;
+  }
+
+  int point_geometry(const std::vector<std::vector<float4>> &keys)
+  {
+    const int geometry = int(meshes.size());
+    meshes.emplace_back();
+    motion_keys.emplace_back();
+    point_keys.push_back(keys);
+    primitive_base.push_back(num_source_points);
+    point_offsets.push_back(int(packed_points.size()) - num_source_points);
+    num_source_points += int(keys[0].size());
+    const int center = int(keys.size()) / 2;
+    packed_points.insert(packed_points.end(), keys[center].begin(), keys[center].end());
+    for (int k = 0; k < int(keys.size()); k++) {
+      if (k != center) {
+        packed_points.insert(packed_points.end(), keys[k].begin(), keys[k].end());
+      }
+    }
+    return geometry;
+  }
+
+  int point_object(const int geometry, const Transform tfm, const bool applied)
+  {
+    const int object = int(objects.size());
+    const auto &keys = point_keys[geometry];
+    KernelObject ob = {};
+    ob.tfm = tfm;
+    ob.position_offset = point_offsets[geometry];
+    ob.num_geom_steps = uint16_t(keys.size());
+    ob.numprims = ob.numverts = int(keys[0].size());
+    objects.push_back(ob);
+    object_mesh.push_back(geometry);
+    flags.push_back(applied ? SD_OBJECT_TRANSFORM_APPLIED : 0);
+    const int type = keys.size() > 1 ? PRIMITIVE_MOTION_POINT : PRIMITIVE_POINT;
+    Bounds world;
+    std::vector<Record> records;
+    for (int p = 0; p < ob.numverts; p++) {
+      Bounds local;
+      for (const auto &key : keys) {
+        const float3 lo = make_float3(key[p]) - make_float3(key[p].w);
+        const float3 hi = make_float3(key[p]) + make_float3(key[p].w);
+        local.grow(lo);
+        local.grow(hi);
+        float3 world_lo = lo, world_hi = hi;
+        if (!applied) {
+          geometry_distance_transform_bounds(tfm, lo, hi, &world_lo, &world_hi);
+        }
+        world.grow(world_lo);
+        world.grow(world_hi);
+      }
+      const int ref = int(indices.size());
+      indices.push_back(primitive_base[geometry] + p);
+      owners.push_back(object);
+      types.push_back(type);
+      records.push_back(leaf(ref, ref + 1, local, type));
+    }
+    Record root = records[0];
+    for (size_t i = 1; i < records.size(); i++) {
+      root = join(root, records[i]);
+    }
+    roots.push_back(root.address);
+    if (applied) {
+      scene_records.push_back(root);
+    }
+    else {
+      const int ref = int(indices.size());
+      indices.push_back(uint(-1));
+      owners.push_back(object);
+      types.push_back(type);
+      scene_records.push_back(leaf(~ref, 0, world, type));
+    }
+    return object;
+  }
+
+  void finish()
+  {
+    if (scene_records.empty()) {
+      return;
+    }
+    Record r = scene_records[0];
+    for (size_t i = 1; i < scene_records.size(); i++) {
+      r = join(r, scene_records[i]);
+    }
+    root = r.address;
+  }
+
+  GeometryDistanceBVH view() const
+  {
+    return {nodes.data(),
+            leaves.data(),
+            roots.data(),
+            types.data(),
+            indices.data(),
+            owners.data(),
+            objects.data(),
+            flags.data(),
+            tri_indices.data(),
+            vertices.data(),
+            times.empty() ? nullptr : times.data(),
+            root,
+            int(objects.size()),
+            int(indices.size()),
+            packed_points.data()};
+  }
+};
+
+/* Independent double-precision oracle. It enumerates source object triangles,
+ * never packed references, leaves, bounds, or object roots. */
+struct D3 {
+  double x, y, z;
+  D3 operator-(D3 b) const
+  {
+    return {x - b.x, y - b.y, z - b.z};
+  }
+  D3 operator+(D3 b) const
+  {
+    return {x + b.x, y + b.y, z + b.z};
+  }
+  D3 operator*(double b) const
+  {
+    return {x * b, y * b, z * b};
+  }
+};
+double dotd(D3 a, D3 b)
+{
+  return a.x * b.x + a.y * b.y + a.z * b.z;
+}
+D3 crossd(D3 a, D3 b)
+{
+  return {a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x};
+}
+D3 d3(float3 a)
+{
+  return {a.x, a.y, a.z};
+}
+double oracle_triangle(D3 p, D3 a, D3 b, D3 c)
+{
+  double best = DBL_MAX;
+  const D3 v[3] = {a, b, c};
+  for (int i = 0; i < 3; i++) {
+    const D3 e = v[(i + 1) % 3] - v[i];
+    const double ee = dotd(e, e);
+    const double t = ee == 0 ? 0 : std::max(0.0, std::min(1.0, dotd(p - v[i], e) / ee));
+    const D3 d = p - (v[i] + e * t);
+    best = std::min(best, dotd(d, d));
+  }
+  const D3 n = crossd(b - a, c - a);
+  const double nn = dotd(n, n);
+  if (nn > 0) {
+    const double h = dotd(p - a, n) / nn;
+    const D3 q = p - n * h;
+    if (dotd(crossd(b - a, q - a), n) >= 0 && dotd(crossd(c - b, q - b), n) >= 0 &&
+        dotd(crossd(a - c, q - c), n) >= 0)
+    {
+      best = std::min(best, h * h * nn);
+    }
+  }
+  return best;
+}
+
+/* Independent surface minimization in unit-sphere coordinates. No eigensystem
+ * or multiplier root from the production implementation is used. */
+double oracle_point(D3 query, const float4 point, const Transform &tfm)
+{
+  const D3 rows[3] = {
+      {tfm.x.x, tfm.x.y, tfm.x.z}, {tfm.y.x, tfm.y.y, tfm.y.z}, {tfm.z.x, tfm.z.y, tfm.z.z}};
+  const D3 center = {point.x, point.y, point.z};
+  const D3 y = query - D3{dotd(rows[0], center) + tfm.x.w,
+                          dotd(rows[1], center) + tfm.y.w,
+                          dotd(rows[2], center) + tfm.z.w};
+  auto mul = [&](D3 u) {
+    return D3{dotd(rows[0], u), dotd(rows[1], u), dotd(rows[2], u)} * point.w;
+  };
+  auto normalize_d = [](D3 u) { return u * (1.0 / std::sqrt(dotd(u, u))); };
+  const double scale = dotd(rows[0], rows[0]);
+  if (point.w == 0) {
+    return dotd(y, y);
+  }
+  if (dotd(rows[0], rows[1]) == 0 && dotd(rows[0], rows[2]) == 0 && dotd(rows[1], rows[2]) == 0 &&
+      dotd(rows[1], rows[1]) == scale && dotd(rows[2], rows[2]) == scale)
+  {
+    const double distance = std::sqrt(dotd(y, y)) - point.w * std::sqrt(scale);
+    return distance * distance;
+  }
+  double best = DBL_MAX;
+  for (int seed = 0; seed < 70; seed++) {
+    D3 u;
+    if (seed < 6) {
+      const double sign = seed % 2 ? -1.0 : 1.0;
+      u = seed < 2 ? D3{sign, 0, 0} : seed < 4 ? D3{0, sign, 0} : D3{0, 0, sign};
+    }
+    else {
+      const double z = 1 - 2 * (seed - 5.5) / 64;
+      const double phi = seed * 2.399963229728653;
+      const double r = std::sqrt(1 - z * z);
+      u = {r * std::cos(phi), r * std::sin(phi), z};
+    }
+    for (int iteration = 0; iteration < 100; iteration++) {
+      const D3 residual = mul(u) - y;
+      const double value = dotd(residual, residual);
+      const D3 gradient = (rows[0] * residual.x + rows[1] * residual.y + rows[2] * residual.z) *
+                          point.w;
+      const double lambda = dotd(gradient, u);
+      const D3 tangent = gradient - u * lambda;
+      if (dotd(tangent, tangent) < 1e-28) {
+        break;
+      }
+      const D3 b0 = normalize_d(crossd(u, std::fabs(u.x) < 0.8 ? D3{1, 0, 0} : D3{0, 1, 0}));
+      const D3 b1 = crossd(u, b0);
+      const D3 ab0 = mul(b0), ab1 = mul(b1);
+      const double h00 = dotd(ab0, ab0) - lambda;
+      const double h11 = dotd(ab1, ab1) - lambda;
+      const double h01 = dotd(ab0, ab1);
+      const double g0 = dotd(tangent, b0), g1 = dotd(tangent, b1);
+      const double det = h00 * h11 - h01 * h01;
+      D3 delta;
+      if (h00 > 0 && det > 1e-24) {
+        delta = b0 * ((h01 * g1 - h11 * g0) / det) + b1 * ((h01 * g0 - h00 * g1) / det);
+      }
+      else {
+        delta = tangent * (-1.0 / std::sqrt(dotd(tangent, tangent)));
+      }
+      const double size = std::sqrt(dotd(delta, delta));
+      if (size > 0.5) {
+        delta = delta * (0.5 / size);
+      }
+      bool improved = false;
+      for (int line = 0; line < 40; line++) {
+        const D3 next = normalize_d(u + delta);
+        const D3 r = mul(next) - y;
+        if (dotd(r, r) < value) {
+          u = next;
+          improved = true;
+          break;
+        }
+        delta = delta * 0.5;
+      }
+      if (!improved) {
+        break;
+      }
+    }
+    const D3 residual = mul(u) - y;
+    best = std::min(best, dotd(residual, residual));
+  }
+  return best;
+}
+
+GeometryDistanceResult oracle(const Fixture &f,
+                              float3 p,
+                              int current,
+                              float radius,
+                              float time = 0.5f,
+                              const std::vector<bool> *eligible = nullptr)
+{
+  GeometryDistanceResult result = {true, false, std::max(0.0f, radius), -1, -1};
+  if (radius <= 0) {
+    return result;
+  }
+  double best = double(radius) * radius;
+  for (int o = 0; o < int(f.objects.size()); o++) {
+    if (o == current || (eligible && !(*eligible)[o])) {
+      continue;
+    }
+    const int mesh = f.object_mesh[o];
+    if (!f.point_keys[mesh].empty()) {
+      const auto &keys = f.point_keys[mesh];
+      for (int i = 0; i < int(keys[0].size()); i++) {
+        float4 point = keys[0][i];
+        if (keys.size() > 1) {
+          const double position = double(time) * (keys.size() - 1);
+          const int k = std::min(int(position), int(keys.size()) - 2);
+          const double weight = position - k;
+          for (int axis = 0; axis < 4; axis++) {
+            point[axis] = float((1 - weight) * keys[k][i][axis] + weight * keys[k + 1][i][axis]);
+          }
+        }
+        const Transform tfm = f.flags[o] & SD_OBJECT_TRANSFORM_APPLIED ? transform_identity() :
+                                                                         f.objects[o].tfm;
+        const double d = oracle_point(d3(p), point, tfm);
+        const int prim = f.primitive_base[mesh] + i;
+        if (d < best ||
+            (d == best && (!result.found || o < result.object ||
+                           (o == result.object && (PRIMITIVE_POINT < result.primitive_type ||
+                                                   (PRIMITIVE_POINT == result.primitive_type &&
+                                                    prim < result.primitive))))))
+        {
+          best = d;
+          result.found = true;
+          result.object = o;
+          result.primitive = prim;
+          result.primitive_type = PRIMITIVE_POINT;
+        }
+      }
+      continue;
+    }
+    for (int i = 0; i < int(f.meshes[mesh].size()); i++) {
+      D3 v[3];
+      for (int j = 0; j < 3; j++) {
+        float3 p = f.meshes[mesh][i][j];
+        if (!f.motion_keys[mesh].empty()) {
+          const auto &keys = f.motion_keys[mesh];
+          const double position = double(time) * (keys.size() - 1);
+          const int step = std::min(int(position), int(keys.size()) - 2);
+          const double t = position - step;
+          const D3 a = d3(keys[step][i][j]);
+          const D3 b = d3(keys[step + 1][i][j]);
+          const D3 interpolated = a * (1 - t) + b * t;
+          p = make_float3(float(interpolated.x), float(interpolated.y), float(interpolated.z));
+        }
+        const Transform &t = f.objects[o].tfm;
+        v[j] = (f.flags[o] & SD_OBJECT_TRANSFORM_APPLIED) ?
+                   d3(p) :
+                   D3{double(t.x.x) * p.x + double(t.x.y) * p.y + double(t.x.z) * p.z + t.x.w,
+                      double(t.y.x) * p.x + double(t.y.y) * p.y + double(t.y.z) * p.z + t.y.w,
+                      double(t.z.x) * p.x + double(t.z.y) * p.y + double(t.z.z) * p.z + t.z.w};
+      }
+      const double d = oracle_triangle(d3(p), v[0], v[1], v[2]);
+      const int prim = f.primitive_base[mesh] + i;
+      if (d < best || (d == best && (!result.found || o < result.object ||
+                                     (o == result.object && prim < result.primitive))))
+      {
+        best = d;
+        result.found = true;
+        result.object = o;
+        result.primitive = prim;
+        result.primitive_type = PRIMITIVE_TRIANGLE;
+      }
+    }
+  }
+  if (result.found) {
+    result.distance = float(std::sqrt(best));
+  }
+  return result;
+}
+
+Transform translation(float x, float y, float z)
+{
+  Transform t = transform_identity();
+  t.x.w = x;
+  t.y.w = y;
+  t.z.w = z;
+  return t;
+}
+
+std::vector<Triangle> plane(float size = 2)
+{
+  return {{make_float3(-size, -size, 0), make_float3(size, -size, 0), make_float3(0, size, 0)}};
+}
+
+std::vector<Triangle> cube()
+{
+  const float3 v[8] = {make_float3(-1, -1, -1),
+                       make_float3(1, -1, -1),
+                       make_float3(1, 1, -1),
+                       make_float3(-1, 1, -1),
+                       make_float3(-1, -1, 1),
+                       make_float3(1, -1, 1),
+                       make_float3(1, 1, 1),
+                       make_float3(-1, 1, 1)};
+  const int faces[12][3] = {{0, 2, 1},
+                            {0, 3, 2},
+                            {4, 5, 6},
+                            {4, 6, 7},
+                            {0, 1, 5},
+                            {0, 5, 4},
+                            {1, 2, 6},
+                            {1, 6, 5},
+                            {2, 3, 7},
+                            {2, 7, 6},
+                            {3, 0, 4},
+                            {3, 4, 7}};
+  std::vector<Triangle> result;
+  for (const auto &f : faces) {
+    result.push_back({v[f[0]], v[f[1]], v[f[2]]});
+  }
+  return result;
+}
+
+void compare_cuda(const Fixture &f,
+                  float3 p,
+                  int current,
+                  float radius,
+                  float time,
+                  const GeometryDistanceResult &expected)
+{
+#ifdef WITH_GEOMETRY_DISTANCE_CUDA
+  const GeometryDistanceBVH view = f.view();
+  const size_t counts[] = {f.nodes.size(),
+                           f.leaves.size(),
+                           f.tri_indices.size(),
+                           f.vertices.size(),
+                           f.packed_points.size()};
+  GeometryDistanceResult actual = {};
+  ASSERT_EQ(geometry_distance_cuda_query(&view,
+                                         sizeof(view),
+                                         sizeof(KernelObject),
+                                         sizeof(actual),
+                                         counts,
+                                         p.x,
+                                         p.y,
+                                         p.z,
+                                         current,
+                                         radius,
+                                         time,
+                                         &actual),
+            0);
+  EXPECT_EQ(actual.supported, expected.supported);
+  EXPECT_EQ(actual.found, expected.found);
+  EXPECT_NEAR(actual.distance, expected.distance, 2e-5f * std::max(1.0f, expected.distance));
+  EXPECT_EQ(actual.object, expected.object);
+  EXPECT_EQ(actual.primitive, expected.primitive);
+  EXPECT_EQ(actual.primitive_type, expected.primitive_type);
+  cuda_queries++;
+  cuda_max_error = std::max(cuda_max_error, fabsf(actual.distance - expected.distance));
+  if (!f.packed_points.empty()) {
+    cuda_point_queries++;
+    cuda_point_max_error = std::max(cuda_point_max_error,
+                                    fabsf(actual.distance - expected.distance));
+    cuda_mismatches[0] += actual.supported != expected.supported;
+    cuda_mismatches[1] += actual.found != expected.found;
+    cuda_mismatches[2] += actual.object != expected.object;
+    cuda_mismatches[3] += actual.primitive != expected.primitive;
+    cuda_mismatches[4] += actual.primitive_type != expected.primitive_type;
+  }
+#else
+  (void)f;
+  (void)p;
+  (void)current;
+  (void)radius;
+  (void)time;
+  (void)expected;
+#endif
+}
+
+void compare(const char *name,
+             Fixture &f,
+             float3 p,
+             int current,
+             float radius,
+             float expected,
+             bool found = true,
+             float time = 0.5f)
+{
+  SCOPED_TRACE(name);
+  f.finish();
+  const auto reference = oracle(f, p, current, radius, time);
+  GeometryDistanceStats stats;
+  const auto actual = geometry_distance_other_geometry(f.view(), p, current, radius, time, &stats);
+  ASSERT_TRUE(actual.supported);
+  EXPECT_EQ(reference.found, found);
+  EXPECT_EQ(actual.found, reference.found);
+  EXPECT_NEAR(reference.distance, expected, 2e-5f * std::max(1.0f, expected));
+  EXPECT_NEAR(actual.distance, reference.distance, 2e-5f * std::max(1.0f, reference.distance));
+  EXPECT_EQ(actual.object, reference.object);
+  EXPECT_EQ(actual.primitive, reference.primitive);
+  EXPECT_EQ(actual.primitive_type, reference.primitive_type);
+  compare_cuda(f, p, current, radius, time, reference);
+  std::printf(
+      "%s oracle=%.9g bvh=%.9g abs=%.9g object=%d prim=%d nodes=%d leaves=%d triangles=%d\n",
+      name,
+      reference.distance,
+      actual.distance,
+      fabsf(actual.distance - reference.distance),
+      actual.object,
+      actual.primitive,
+      stats.nodes,
+      stats.leaves,
+      stats.triangles);
+}
