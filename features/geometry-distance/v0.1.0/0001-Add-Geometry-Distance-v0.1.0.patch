@@ -0,0 +1,135 @@
+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+/* Standalone research runner, intentionally not part of normal render kernels. */
+#include <cuda_runtime.h>
+#include <vector>
+
+#include "kernel/device/cuda/compat.h"
+
+/* Device qualifiers must be defined before any shared kernel headers. */
+#include "kernel/bvh/closest_point.h"
+
+__global__ void geometry_distance_test_kernel(GeometryDistanceBVH bvh,
+                                              float x,
+                                              float y,
+                                              float z,
+                                              int object,
+                                              float radius,
+                                              float time,
+                                              GeometryDistanceResult *result)
+{
+  *result = geometry_distance_other_geometry(bvh, make_float3(x, y, z), object, radius, time);
+}
+
+struct DeviceBuffers {
+  std::vector<void *> buffers;
+  cudaError_t error = cudaSuccess;
+
+  template<typename T> T *copy(const T *source, const size_t count)
+  {
+    if (count == 0 || error != cudaSuccess) {
+      return nullptr;
+    }
+    T *buffer = nullptr;
+    error = cudaMalloc(&buffer, count * sizeof(T));
+    if (error != cudaSuccess) {
+      return nullptr;
+    }
+    buffers.push_back(buffer);
+    if (source) {
+      error = cudaMemcpy(buffer, source, count * sizeof(T), cudaMemcpyHostToDevice);
+    }
+    return buffer;
+  }
+
+  ~DeviceBuffers()
+  {
+    for (void *buffer : buffers) {
+      cudaFree(buffer);
+    }
+  }
+};
+
+__global__ void geometry_distance_feature_kernel(const KernelData *data,
+                                                 unsigned long long *observed)
+{
+  observed[0] = data->kernel_features;
+  observed[1] = sizeof(KernelData);
+  observed[2] = offsetof(KernelData, cam);
+  observed[3] = offsetof(KernelData, device_bvh);
+}
+
+extern "C" int geometry_distance_cuda_features(const void *host_data,
+                                               const size_t size,
+                                               unsigned long long *observed)
+{
+  if (size != sizeof(KernelData)) {
+    return -1;
+  }
+  DeviceBuffers buffers;
+  const auto *data = buffers.copy(static_cast<const KernelData *>(host_data), 1);
+  auto *output = buffers.copy<unsigned long long>(nullptr, 4);
+  if (buffers.error != cudaSuccess) {
+    return int(buffers.error);
+  }
+  geometry_distance_feature_kernel<<<1, 1>>>(data, output);
+  cudaError_t error = cudaGetLastError();
+  if (error == cudaSuccess) {
+    error = cudaDeviceSynchronize();
+  }
+  if (error == cudaSuccess) {
+    error = cudaMemcpy(observed, output, 4 * sizeof(*observed), cudaMemcpyDeviceToHost);
+  }
+  return int(error);
+}
+
+extern "C" int geometry_distance_cuda_query(const void *host_view,
+                                            const size_t view_size,
+                                            const size_t object_size,
+                                            const size_t result_size,
+                                            const size_t *counts,
+                                            const float x,
+                                            const float y,
+                                            const float z,
+                                            const int current,
+                                            const float radius,
+                                            const float time,
+                                            void *host_result)
+{
+  if (view_size != sizeof(GeometryDistanceBVH) || object_size != sizeof(KernelObject) ||
+      result_size != sizeof(GeometryDistanceResult))
+  {
+    return -1;
+  }
+  GeometryDistanceBVH bvh = *static_cast<const GeometryDistanceBVH *>(host_view);
+  DeviceBuffers buffers;
+  bvh.nodes = buffers.copy(bvh.nodes, counts[0]);
+  bvh.leaf_nodes = buffers.copy(bvh.leaf_nodes, counts[1]);
+  bvh.tri_vindex = buffers.copy(bvh.tri_vindex, counts[2]);
+  bvh.tri_verts = buffers.copy(bvh.tri_verts, counts[3]);
+  bvh.points = buffers.copy(bvh.points, counts[4]);
+  bvh.object_node = buffers.copy(bvh.object_node, bvh.num_objects);
+  bvh.objects = buffers.copy(bvh.objects, bvh.num_objects);
+  bvh.object_flag = buffers.copy(bvh.object_flag, bvh.num_objects);
+  bvh.prim_type = buffers.copy(bvh.prim_type, bvh.num_references);
+  bvh.prim_index = buffers.copy(bvh.prim_index, bvh.num_references);
+  bvh.prim_object = buffers.copy(bvh.prim_object, bvh.num_references);
+  if (bvh.prim_time) {
+    bvh.prim_time = buffers.copy(bvh.prim_time, bvh.num_references);
+  }
+  auto *result = buffers.copy<GeometryDistanceResult>(nullptr, 1);
+  if (buffers.error != cudaSuccess) {
+    return int(buffers.error);
+  }
+  geometry_distance_test_kernel<<<1, 1>>>(bvh, x, y, z, current, radius, time, result);
+  cudaError_t error = cudaGetLastError();
+  if (error == cudaSuccess) {
+    error = cudaDeviceSynchronize();
+  }
+  if (error == cudaSuccess) {
+    error = cudaMemcpy(host_result, result, sizeof(*result), cudaMemcpyDeviceToHost);
+  }
+  return int(error);
+}
