+TEST(geometry_distance_scene, public_node_falloff_and_world_position)
+{
+  BuiltScene b;
+  b.object(b.mesh(plane()), transform_identity());
+  request_geometry_distance(b, true);
+  b.publish();
+  ASSERT_FALSE(HasFatalFailure());
+  auto *globals = b.device->acquire_cpu_kernel_thread_globals();
+  ShaderData sd = {};
+  sd.object = OBJECT_NONE;
+  sd.time = 0.5f;
+  float stack[SVM_STACK_SIZE] = {};
+  SVMNodeGeometryDistance op = {};
+  op.max_distance.bits = __float_as_uint(1.0f);
+  op.position_offset = 3;
+  op.distance_offset = 0;
+  op.factor_offset = 1;
+  op.found_offset = 2;
+  for (const float distance : {0.0f, 0.25f, 0.5f, 0.75f, 1.0f, 1.25f}) {
+    stack_store_float3(stack, 3, make_float3(0, 0, distance));
+    for (const int mode : {0, 1, 2}) {
+      op.falloff = mode;
+      /* A connected constant is a fixed world-space query, regardless of sd.P. */
+      for (const float3 position : {make_float3(7, 8, 9), make_float3(-3, -4, -5)}) {
+        sd.P = position;
+        svm_node_geometry_distance(&(*globals)[0], &sd, stack, op);
+        EXPECT_FLOAT_EQ(stack[0], std::min(distance, 1.0f));
+        EXPECT_EQ(stack[2], distance <= 1.0f ? 1.0f : 0.0f);
+        const float x = std::max(0.0f, 1.0f - distance);
+        const float expected = mode == 0 ? x : mode == 1 ? x * x * (3 - 2 * x) :
+                                   std::sqrt(std::max(0.0f, 1 - distance * distance));
+        EXPECT_NEAR(stack[1], expected, 1e-6f);
+      }
+      op.max_distance.bits = __float_as_uint(0.0f);
+      svm_node_geometry_distance(&(*globals)[0], &sd, stack, op);
+      EXPECT_EQ(stack[0], 0.0f);
+      EXPECT_EQ(stack[1], 0.0f);
+      EXPECT_EQ(stack[2], 0.0f);
+      op.max_distance.bits = __float_as_uint(1.0f);
+    }
+  }
+  b.device->release_cpu_kernel_thread_globals();
+}
