+void BVHBuild::add_reference_loose_vertices(BoundBox &root,
+                                           BoundBox &center,
+                                           Mesh *mesh,
+                                           const int object_index)
+{
+  vector<bool> used(mesh->num_verts(), false);
+  for (const int vertex : mesh->get_triangles()) {
+    used[vertex] = true;
+  }
+  /* Undiced subdivision control vertices still belong to faces. */
+  for (const int vertex : mesh->get_subd_face_corners()) {
+    used[vertex] = true;
+  }
+  const Attribute *positions = mesh->attributes.find(ATTR_STD_POSITION);
+  const bool motion = mesh->has_motion_blur() && positions->has_motion();
+  for (int vertex = 0; vertex < int(used.size()); vertex++) {
+    if (used[vertex]) {
+      continue;
+    }
+    BoundBox bounds = BoundBox::empty;
+    bounds.grow(mesh->get_position()[vertex]);
+    if (motion) {
+      for (int step = 1; step < positions->num_motion_steps(); step++) {
+        bounds.grow(positions->data<packed_float3>(step)[vertex]);
+      }
+    }
+    if (bounds.valid()) {
+      const int type = GEOMETRY_DISTANCE_LOOSE_VERTEX | (motion ? PRIMITIVE_MOTION : 0);
+      references.push_back(BVHReference(bounds, vertex, object_index, type));
+      root.grow(bounds);
+      center.grow(bounds.center2());
+    }
+  }
+}
