+static void check_companion_transition(BuiltScene &b)
+{
+  b.object(b.mesh(plane()), transform_identity());
+  b.object(b.cloud({{make_float4(0, 0, 2, 0.25f)}}), transform_identity());
+  b.publish();
+  ASSERT_FALSE(::testing::Test::HasFatalFailure());
+  GeometryManager *manager = b.scene->geometry_manager.get();
+  DeviceScene &d = b.scene->dscene;
+  EXPECT_FALSE(manager->geometry_distance_has_cache());
+  EXPECT_EQ(manager->geometry_distance_host_bytes(), 0);
+  EXPECT_EQ(manager->geometry_distance_build_count(), 0);
+  EXPECT_EQ(companion_bytes(d), 0);
+  EXPECT_EQ(d.geometry_distance_nodes.device_pointer, 0);
+  EXPECT_EQ(d.data.geometry_distance.valid, 0);
+#  ifdef WITH_OPTIX
+  if (b.device->info.type == DEVICE_OPTIX && std::getenv("GEOMETRY_DISTANCE_PRODUCTION_PTX")) {
+    check_production_queries(b, false);
+  }
+#  endif
+  request_geometry_distance(b, true);
+  b.publish();
+  ASSERT_FALSE(::testing::Test::HasFatalFailure());
+  EXPECT_TRUE(manager->geometry_distance_has_cache());
+  EXPECT_EQ(manager->geometry_distance_build_count(), 1);
+  EXPECT_GT(companion_bytes(d), 0);
+  EXPECT_NE(d.geometry_distance_nodes.device_pointer, 0);
+  EXPECT_EQ(d.data.geometry_distance.valid, 1);
+  EXPECT_EQ(b.scene->bvh->params.bvh_layout, b.scene->params.bvh_layout);
+  for (Geometry *geometry : b.scene->geometry) {
+    if (geometry->bvh) {
+      EXPECT_EQ(geometry->bvh->params.bvh_layout, b.scene->params.bvh_layout);
+    }
+  }
+  std::printf("production_companion device=%d host_estimate=%zu arrays=%zu builds=%zu\n",
+              int(b.device->info.type),
+              manager->geometry_distance_host_bytes(),
+              companion_bytes(d),
+              manager->geometry_distance_build_count());
+  if (b.device->info.type == DEVICE_CPU) {
+    auto *globals = b.device->acquire_cpu_kernel_thread_globals();
+    for (float radius : {0.1f, 1.0f, 10.0f}) {
+      const float3 position = make_float3(0, 0, 1);
+      const auto expected = oracle(b.source, position, -1, radius, 0.5f);
+      const auto result = geometry_distance_scene(&(*globals)[0], position, -1, radius, 0.5f);
+      EXPECT_TRUE(result.supported);
+      EXPECT_EQ(result.found, expected.found);
+      EXPECT_EQ(result.object, expected.object);
+      EXPECT_EQ(result.primitive, expected.primitive);
+      EXPECT_EQ(result.primitive_type, expected.primitive_type);
+      EXPECT_NEAR(result.distance, expected.distance, 2e-5f);
+    }
+    b.device->release_cpu_kernel_thread_globals();
+  }
+#  ifdef WITH_OPTIX
+  if (b.device->info.type == DEVICE_OPTIX && std::getenv("GEOMETRY_DISTANCE_PRODUCTION_PTX")) {
+    check_production_queries(b);
+    ASSERT_FALSE(::testing::Test::HasFatalFailure());
+    check_production_updates(b);
+  }
+#  endif
+  const size_t builds = manager->geometry_distance_build_count();
+  b.publish();
+  EXPECT_EQ(manager->geometry_distance_build_count(), builds);
+  request_geometry_distance(b, false);
+  b.publish();
+  ASSERT_FALSE(::testing::Test::HasFatalFailure());
+  EXPECT_FALSE(manager->geometry_distance_has_cache());
+  EXPECT_EQ(companion_bytes(d), 0);
+  EXPECT_EQ(d.geometry_distance_nodes.device_pointer, 0);
+  EXPECT_EQ(d.data.geometry_distance.valid, 0);
+#  ifdef WITH_OPTIX
+  if (b.device->info.type == DEVICE_OPTIX && std::getenv("GEOMETRY_DISTANCE_PRODUCTION_PTX")) {
+    check_production_queries(b, false);
+  }
+#  endif
+}
