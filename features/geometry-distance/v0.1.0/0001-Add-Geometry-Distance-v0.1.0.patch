+static void check_production_queries(BuiltScene &b, const bool enabled = true)
+{
+  const char *ptx_path = std::getenv("GEOMETRY_DISTANCE_PRODUCTION_PTX");
+  ASSERT_NE(ptx_path, nullptr);
+  std::ifstream file(ptx_path);
+  const std::string ptx((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
+  ASSERT_FALSE(ptx.empty());
+  auto *device = static_cast<OptiXDevice *>(b.device.get());
+  CUDAContextScope scope(device);
+  ProductionOptixQuery query;
+  OptixModuleCompileOptions module_options = {};
+  char log[8192];
+  size_t log_size = sizeof(log);
+  ASSERT_EQ(optixModuleCreate(device->context,
+                              &module_options,
+                              &device->pipeline_options,
+                              ptx.data(),
+                              ptx.size(),
+                              log,
+                              &log_size,
+                              &query.module),
+            OPTIX_SUCCESS)
+      << log;
+  OptixProgramGroupDesc desc = {};
+  desc.kind = OPTIX_PROGRAM_GROUP_KIND_RAYGEN;
+  desc.raygen.module = query.module;
+  desc.raygen.entryFunctionName = "__raygen__geometry_distance_production";
+  OptixProgramGroupOptions options = {};
+  log_size = sizeof(log);
+  ASSERT_EQ(
+      optixProgramGroupCreate(device->context, &desc, 1, &options, log, &log_size, &query.raygen),
+      OPTIX_SUCCESS)
+      << log;
+  vector<OptixProgramGroup> groups = {query.raygen};
+  for (int i = PG_MISS; i < NUM_PROGRAM_GROUPS; i++) {
+    if (device->groups[i])
+      groups.push_back(device->groups[i]);
+  }
+  OptixPipelineLinkOptions link = {};
+  link.maxTraceDepth = 1;
+  log_size = sizeof(log);
+  ASSERT_EQ(optixPipelineCreate(device->context,
+                                &device->pipeline_options,
+                                &link,
+                                groups.data(),
+                                unsigned(groups.size()),
+                                log,
+                                &log_size,
+                                &query.pipeline),
+            OPTIX_SUCCESS)
+      << log;
+  ASSERT_EQ(optixPipelineSetStackSize(
+                query.pipeline, 0, 0, 16384, device->pipeline_options.usesMotionBlur ? 3 : 2),
+            OPTIX_SUCCESS);
+  SbtRecord record = {};
+  ASSERT_EQ(optixSbtRecordPackHeader(query.raygen, &record), OPTIX_SUCCESS);
+  ASSERT_EQ(cuMemAlloc(&query.record, sizeof(record)), CUDA_SUCCESS);
+  ASSERT_EQ(cuMemcpyHtoD(query.record, &record, sizeof(record)), CUDA_SUCCESS);
+  OptixShaderBindingTable sbt = {};
+  sbt.raygenRecord = query.record;
+  const CUdeviceptr sbt_data = device->sbt_data.device_pointer;
+  sbt.missRecordBase = sbt_data + MISS_PROGRAM_GROUP_OFFSET * sizeof(SbtRecord);
+  sbt.missRecordStrideInBytes = sizeof(SbtRecord);
+  sbt.missRecordCount = NUM_MISS_PROGRAM_GROUPS;
+  sbt.hitgroupRecordBase = sbt_data + HIT_PROGAM_GROUP_OFFSET * sizeof(SbtRecord);
+  sbt.hitgroupRecordStrideInBytes = sizeof(SbtRecord);
+  sbt.hitgroupRecordCount = NUM_HIT_PROGRAM_GROUPS;
+  sbt.callablesRecordBase = sbt_data + CALLABLE_PROGRAM_GROUPS_BASE * sizeof(SbtRecord);
+  sbt.callablesRecordStrideInBytes = sizeof(SbtRecord);
+  sbt.callablesRecordCount = NUM_CALLABLE_PROGRAM_GROUPS;
+  vector<GeometryDistanceProductionQuery> inputs(30);
+  for (int i = 0; i < int(inputs.size()); i++) {
+    inputs[i] = {};
+    inputs[i].position_radius = make_float4(
+        float(i % 4) * 0.3f, 0, float(i % 3), i % 4 == 0 ? 0.1f : 5.0f);
+    inputs[i].time = float(i % 6) / 5;
+    inputs[i].current_object = i % 3 == 0 ? 0 : -1;
+  }
+  const size_t bytes = inputs.size() * sizeof(inputs[0]);
+  ASSERT_EQ(cuMemAlloc(&query.output, bytes), CUDA_SUCCESS);
+  ASSERT_EQ(cuMemcpyHtoD(query.output, inputs.data(), bytes), CUDA_SUCCESS);
+  /* Clone the actual renderer launch block, changing only its ordinary output argument.
+   * Scene globals and the native traversable come from OptiXDevice publication. */
+  vector<unsigned char> launch(device->launch_params.device_size);
+  ASSERT_EQ(cuMemcpyDtoH(launch.data(), device->launch_params.device_pointer, launch.size()),
+            CUDA_SUCCESS);
+  ASSERT_GE(launch.size(), 2 * sizeof(CUdeviceptr));
+  memcpy(launch.data() + sizeof(CUdeviceptr), &query.output, sizeof(query.output));
+  ASSERT_EQ(cuMemAlloc(&query.params, launch.size()), CUDA_SUCCESS);
+  ASSERT_EQ(cuMemcpyHtoD(query.params, launch.data(), launch.size()), CUDA_SUCCESS);
+  ASSERT_EQ(optixLaunch(query.pipeline,
+                        nullptr,
+                        query.params,
+                        launch.size(),
+                        &sbt,
+                        unsigned(inputs.size()),
+                        1,
+                        1),
+            OPTIX_SUCCESS);
+  ASSERT_EQ(cuCtxSynchronize(), CUDA_SUCCESS);
+  ASSERT_EQ(cuMemcpyDtoH(inputs.data(), query.output, bytes), CUDA_SUCCESS);
+  BuiltScene reference;
+  for (int i = 0; i < int(b.source.meshes.size()); i++) {
+    if (!b.source.point_keys[i].empty())
+      reference.cloud(b.source.point_keys[i]);
+    else
+      reference.mesh(b.source.meshes[i]);
+  }
+  for (int i = 0; i < int(b.source.objects.size()); i++) {
+    reference.object(b.source.object_mesh[i], b.source.objects[i].tfm);
+  }
+  reference.publish();
+  ASSERT_FALSE(::testing::Test::HasFatalFailure());
+  auto *globals = reference.device->acquire_cpu_kernel_thread_globals();
+  float max_error = 0, max_relative = 0;
+  size_t point_evaluations = 0;
+  for (const auto &input : inputs) {
+    const auto expected = oracle(b.source,
+                                 make_float3(input.position_radius),
+                                 input.current_object,
+                                 input.position_radius.w,
+                                 input.time);
+    for (int i = 0; i < 3; i++) {
+      const auto &result = input.result[i];
+      EXPECT_EQ(result.supported, enabled);
+      if (!enabled)
+        continue;
+      point_evaluations += input.stats[i].points;
+      EXPECT_EQ(result.found, expected.found);
+      EXPECT_EQ(result.object, expected.object);
+      EXPECT_EQ(result.primitive, expected.primitive);
+      EXPECT_EQ(result.primitive_type, expected.primitive_type);
+      const float error = std::fabs(result.distance - expected.distance);
+      max_error = std::max(max_error, error);
+      if (expected.distance > 1e-8f)
+        max_relative = std::max(max_relative, error / expected.distance);
+      EXPECT_NEAR(result.distance, expected.distance, 2e-5f);
+      EXPECT_EQ(result.distance, input.result[0].distance);
+    }
+    Ray ray = {};
+    ray.P = make_float3(input.position_radius) - make_float3(0, 0, 4);
+    ray.D = make_float3(0, 0, 1);
+    ray.tmax = 100;
+    ray.time = input.time;
+    ray.self = {PRIM_NONE, OBJECT_NONE, PRIM_NONE, OBJECT_NONE};
+    Intersection hit = {};
+    const bool found = scene_intersect(&(*globals)[0], &ray, PATH_RAY_VISIBILITY_CAMERA, &hit);
+    EXPECT_EQ(input.ray[0].hit, int(found));
+    if (found) {
+      EXPECT_NEAR(input.ray[0].distance, hit.t, 2e-5f);
+      EXPECT_EQ(input.ray[0].object, hit.object);
+      EXPECT_EQ(input.ray[0].primitive, hit.prim);
+    }
+    for (int i = 1; i < 4; i++) {
+      EXPECT_EQ(input.ray[i].hit, input.ray[0].hit);
+      EXPECT_EQ(input.ray[i].distance, input.ray[0].distance);
+      EXPECT_EQ(input.ray[i].object, input.ray[0].object);
+      EXPECT_EQ(input.ray[i].primitive, input.ray[0].primitive);
+    }
+  }
+  reference.device->release_cpu_kernel_thread_globals();
+  std::printf(
+      "production_optix distances=%d rays=120 max_error=%.9g max_relative=%.9g points=%zu "
+      "arrays=%zu\n",
+      enabled ? 90 : 0,
+      max_error,
+      max_relative,
+      point_evaluations,
+      companion_bytes(b.scene->dscene));
+  if (enabled && b.scene->dscene.points.size() >= 512) {
+    EXPECT_LT(point_evaluations, size_t(90 * 512));
+  }
+}
+#  endif
