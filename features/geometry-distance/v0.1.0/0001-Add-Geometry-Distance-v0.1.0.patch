+TEST(geometry_distance_scene, public_node_displacement_shadow_normals)
+{
+  for (const bool geometry_query : {false, true}) {
+    for (const DisplacementMethod method : {DISPLACE_BUMP, DISPLACE_TRUE, DISPLACE_BOTH}) {
+      BuiltScene b;
+      const int index = b.mesh(plane(0.1f));
+      Mesh *mesh = b.meshes[index];
+      mesh->get_smooth()[0] = true;
+      b.object(index, transform_identity());
+      auto graph = make_unique<ShaderGraph>();
+      ShaderOutput *height;
+      if (geometry_query) {
+        b.object(b.cloud({{make_float4(0, 0, 0, 0.25f)}}), translation(0.5f, 0, 1));
+        auto *distance = graph->create_node<GeometryDistanceNode>();
+        distance->set_max_distance(2.0f);
+        height = distance->output("Distance");
+      }
+      else {
+        auto *position = graph->create_node<GeometryNode>();
+        auto *distance = graph->create_node<VectorMathNode>();
+        distance->set_math_type(NODE_VECTOR_MATH_DISTANCE);
+        distance->set_vector2(make_float3(0.5f, 0, 1));
+        graph->connect(position->output("Position"), distance->input("Vector1"));
+        height = distance->output("Value");
+      }
+      auto *displacement = graph->create_node<DisplacementNode>();
+      displacement->set_midlevel(0.0f);
+      displacement->set_scale(0.2f);
+      graph->connect(height, displacement->input("Height"));
+      graph->connect(displacement->output("Displacement"), graph->output()->input("Displacement"));
+      auto *emission = graph->create_node<EmissionNode>();
+      graph->connect(emission->output("Emission"), graph->output()->input("Surface"));
+      b.scene->default_surface->set_displacement_method(method);
+      b.scene->default_surface->set_graph(std::move(graph));
+      b.scene->default_surface->tag_update(b.scene.get());
+      b.publish();
+      ASSERT_FALSE(::testing::Test::HasFailure());
+      const float3 normal = mesh->get_triangle(0).compute_normal(mesh->get_position());
+      const Attribute *normals = mesh->attributes.find(ATTR_STD_VERTEX_NORMAL);
+      ASSERT_NE(normals, nullptr);
+      for (int i = 0; i < mesh->num_verts(); i++) {
+        const float3 p = mesh->get_position()[i];
+        const float height = sqrtf((p.x - 0.5f) * (p.x - 0.5f) + p.y * p.y + 1.0f) -
+                             (geometry_query ? 0.25f : 0.0f);
+        EXPECT_NEAR(p.z, method == DISPLACE_BUMP ? 0.0f : 0.2f * height, 2e-5f);
+        /* Shadow offsets consume these mesh normals, independently of shader bump. */
+        EXPECT_GT(dot(normals->data<packed_normal>()[i].decode(), normal), 0.99999f);
+      }
+      if (method == DISPLACE_BOTH) {
+        const Attribute *undisplaced = mesh->attributes.find(ATTR_STD_NORMAL_UNDISPLACED);
+        ASSERT_NE(undisplaced, nullptr);
+        for (int i = 0; i < mesh->num_verts(); i++) {
+          /* Bump must still start from the original normal, avoiding double perturbation. */
+          EXPECT_GT(undisplaced->data<packed_normal>()[i].decode().z, 0.99999f);
+        }
+        EXPECT_LT(normal.z, 0.999f);
+      }
+    }
+  }
+}
