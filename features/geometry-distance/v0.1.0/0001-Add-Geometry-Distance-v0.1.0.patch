+/* Input copies belong to the oracle. No fixture packing functions are called. */
+struct BuiltScene {
+  Stats stats;
+  Profiler profiler;
+  unique_ptr<Device> device;
+  unique_ptr<Scene> scene;
+  Fixture source;
+  std::vector<Mesh *> meshes;
+  std::vector<PointCloud *> pointclouds;
+
+  BuiltScene(const DeviceInfo *requested_device = nullptr)
+  {
+    TaskScheduler::init(4);
+    ColorSpaceManager::init_fallback_config();
+    DeviceInfo info;
+    info.cpu_threads = 4;
+    if (requested_device) {
+      info = *requested_device;
+    }
+    device = Device::create(info, stats, profiler, true);
+    SceneParams params;
+    params.bvh_layout = requested_device ? BVH_LAYOUT_OPTIX : BVH_LAYOUT_BVH2;
+    params.use_bvh_unaligned_nodes = false;
+    scene = make_unique<Scene>(params, device.get());
+  }
+
+  ~BuiltScene()
+  {
+    scene.reset();
+    device.reset();
+    TaskScheduler::exit();
+  }
+
+  int mesh(const std::vector<Triangle> &triangles)
+  {
+    Mesh *mesh = scene->create_node<Mesh>();
+    mesh->resize_mesh(int(triangles.size()) * 3, int(triangles.size()));
+    packed_float3 *position = mesh->get_position_for_write();
+    auto &indices = mesh->get_triangles();
+    auto &shaders = mesh->get_shader();
+    auto &smooth = mesh->get_smooth();
+    for (int i = 0; i < int(triangles.size()); i++) {
+      for (int j = 0; j < 3; j++) {
+        position[3 * i + j] = triangles[i][j];
+        indices[3 * i + j] = 3 * i + j;
+      }
+      shaders[i] = 0;
+      smooth[i] = false;
+    }
+    array<Node *> used;
+    used.push_back_slow(scene->default_surface);
+    mesh->set_used_shaders(used);
+    mesh->tag_update(scene.get(), true);
+    const int id = int(meshes.size());
+    meshes.push_back(mesh);
+    pointclouds.push_back(nullptr);
+    source.meshes.push_back(triangles);
+    source.motion_keys.emplace_back();
+    source.point_keys.emplace_back();
+    source.point_offsets.push_back(0);
+    int base = 0;
+    for (int i = 0; i < id; i++) {
+      base += int(source.meshes[i].size());
+    }
+    source.primitive_base.push_back(base);
+    return id;
+  }
+
+  int cloud(const std::vector<std::vector<float4>> &keys)
+  {
+    const int id = source.point_geometry(keys);
+    PointCloud *cloud = scene->create_node<PointCloud>();
+    pointclouds.push_back(cloud);
+    meshes.push_back(nullptr);
+    cloud->resize(int(keys[0].size()));
+    cloud->set_motion_steps(int(keys.size()));
+    cloud->set_use_motion_blur(keys.size() > 1);
+    Attribute *position = cloud->attributes.find(ATTR_STD_POSITION);
+    Attribute *radius = cloud->attributes.find(ATTR_STD_RADIUS);
+    if (keys.size() > 1) {
+      scene->integrator->set_motion_blur(true);
+      position->add_motion(cloud);
+      radius->add_motion(cloud);
+    }
+    for (int k = 0; k < int(keys.size()); k++) {
+      const int center = int(keys.size()) / 2;
+      const int slot = k == center ? 0 : k < center ? k + 1 : k;
+      for (int p = 0; p < int(keys[k].size()); p++) {
+        position->data_for_write<packed_float3>(slot)[p] = make_float3(keys[k][p]);
+        radius->data_for_write<float>(slot)[p] = keys[k][p].w;
+        cloud->get_shader()[p] = 0;
+      }
+    }
+    cloud->tag_update(scene.get(), true);
+    return id;
+  }
+
+  void object(const int mesh, const Transform tfm)
+  {
+    Object *object = scene->create_node<Object>();
+    object->set_geometry(meshes[mesh] ? static_cast<Geometry *>(meshes[mesh]) :
+                                        static_cast<Geometry *>(pointclouds[mesh]));
+    object->set_tfm(tfm);
+    object->tag_update(scene.get());
+    KernelObject input = {};
+    input.tfm = tfm;
+    source.objects.push_back(input);
+    source.flags.push_back(0);
+    source.object_mesh.push_back(mesh);
+  }
+
+  void publish()
+  {
+    Progress progress;
+    thread_scoped_lock lock(scene->mutex);
+    scene->device_update(device.get(), progress);
+    ASSERT_FALSE(progress.get_cancel());
+    ASSERT_FALSE(device->have_error()) << device->error_message();
+    ASSERT_EQ(scene->dscene.data.bvh.bvh_layout, scene->params.bvh_layout);
+    /* Model the established baked point representation from source inputs. */
+    for (int o = 0; o < int(source.objects.size()); o++) {
+      const int geometry = source.object_mesh[o];
+      if (pointclouds[geometry] && pointclouds[geometry]->transform_applied) {
+        const Transform tfm = source.objects[o].tfm;
+        const double determinant =
+            double(tfm.x.x) * (double(tfm.y.y) * tfm.z.z - double(tfm.y.z) * tfm.z.y) -
+            double(tfm.x.y) * (double(tfm.y.x) * tfm.z.z - double(tfm.y.z) * tfm.z.x) +
+            double(tfm.x.z) * (double(tfm.y.x) * tfm.z.y - double(tfm.y.y) * tfm.z.x);
+        const float radius_scale = float(std::cbrt(std::fabs(determinant)));
+        for (auto &key : source.point_keys[geometry]) {
+          for (float4 &point : key) {
+            const float3 center = transform_point(&tfm, make_float3(point));
+            point = make_float4(center, point.w * radius_scale);
+          }
+        }
+        source.flags[o] |= SD_OBJECT_TRANSFORM_APPLIED;
+      }
+    }
+  }
+
+  GeometryDistanceBVH view()
+  {
+    DeviceScene &d = scene->dscene;
+    return {reinterpret_cast<const float4 *>(d.bvh_nodes.data()),
+            reinterpret_cast<const float4 *>(d.bvh_leaf_nodes.data()),
+            reinterpret_cast<const uint *>(d.object_node.data()),
+            reinterpret_cast<const uint *>(d.prim_type.data()),
+            reinterpret_cast<const uint *>(d.prim_index.data()),
+            reinterpret_cast<const uint *>(d.prim_object.data()),
+            d.objects.data(),
+            d.object_flag.data(),
+            d.tri_vindex.data(),
+            d.tri_verts.data(),
+            d.prim_time.size() == 0 ? nullptr : d.prim_time.data(),
+            d.data.bvh.root,
+            int(d.objects.size()),
+            int(d.prim_index.size()),
+            d.points.data()};
+  }
+
+  void compare(const float3 p, const int current, const float radius, const float time = 0.5f)
+  {
+    /* Match scene eligibility without deriving oracle targets from packed references.
+     * Direct fixtures still exercise degenerate triangle math independently. */
+    std::vector<bool> eligible;
+    for (const Object *object : scene->objects) {
+      eligible.push_back(object->is_traceable());
+    }
+    const auto expected = oracle(source, p, current, radius, time, &eligible);
+    GeometryDistanceStats counts;
+    const auto actual = geometry_distance_other_geometry(
+        view(), p, current, radius, time, &counts);
+    std::printf(
+        "real_builder radius=%.9g oracle=%.9g bvh=%.9g object=%d/%d prim=%d/%d "
+        "nodes=%d leaves=%d triangles=%d points=%d\n",
+        radius,
+        expected.distance,
+        actual.distance,
+        expected.object,
+        actual.object,
+        expected.primitive,
+        actual.primitive,
+        counts.nodes,
+        counts.leaves,
+        counts.triangles,
+        counts.points);
+    EXPECT_TRUE(actual.supported);
+    EXPECT_EQ(actual.found, expected.found);
+    EXPECT_EQ(actual.object, expected.object);
+    EXPECT_EQ(actual.primitive, expected.primitive);
+    EXPECT_EQ(actual.primitive_type, expected.primitive_type);
+    EXPECT_NEAR(actual.distance, expected.distance, 2e-5f * std::max(1.0f, expected.distance));
+  }
+};
+
