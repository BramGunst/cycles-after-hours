+++ b/intern/cycles/util/math_distance.h
@@ -0,0 +1,254 @@
+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+#include "util/math.h"
+#include "util/transform.h"
+
+CCL_NAMESPACE_BEGIN
+
+ccl_device_inline float point_segment_distance_squared(const float3 p,
+                                                       const float3 a,
+                                                       const float3 b)
+{
+  const float3 e = b - a;
+  const float scale = max(max(fabsf(e.x), fabsf(e.y)), fabsf(e.z));
+  if (scale == 0.0f) {
+    return len_squared(p - a);
+  }
+  const float3 n = e / scale;
+  const float t = clamp(dot((p - a) / scale, n) / dot(n, n), 0.0f, 1.0f);
+  return len_squared((p - a) - t * e);
+}
+
+ccl_device_inline float point_triangle_distance_squared(const float3 p,
+                                                        const float3 a,
+                                                        const float3 b,
+                                                        const float3 c)
+{
+  /* Edge tests also cover vertices and collapsed triangles. Scale the face test
+   * to avoid squaring the area of a very small triangle in world units. */
+  float result = min(
+      point_segment_distance_squared(p, a, b),
+      min(point_segment_distance_squared(p, b, c), point_segment_distance_squared(p, c, a)));
+  const float3 ab = b - a;
+  const float3 ac = c - a;
+  const float scale = max(reduce_max(fabs(ab)), reduce_max(fabs(ac)));
+  if (scale == 0.0f) {
+    return result;
+  }
+  const float3 u = ab / scale;
+  const float3 v = ac / scale;
+  const float3 n = cross(u, v);
+  const float nn = dot(n, n);
+  if (nn > 0.0f) {
+    const float3 q = (p - a) / scale;
+    const float s = dot(cross(q, v), n) / nn;
+    const float t = dot(cross(u, q), n) / nn;
+    if (s >= 0.0f && t >= 0.0f && s + t <= 1.0f) {
+      result = min(result, len_squared((p - a) - s * ab - t * ac));
+    }
+  }
+  return result;
+}
+
+ccl_device_inline float point_aabb_distance_squared(const float3 p,
+                                                    const float3 lower,
+                                                    const float3 upper)
+{
+  const float3 d = max(max(lower - p, p - upper), zero_float3());
+  return dot(d, d);
+}
+
+/* World-space distance to T(center + radius*u), |u|=1. A failed numerical
+ * certificate is unsupported, never a radius approximation. */
+ccl_device_inline bool point_affine_sphere_distance(const float3 p,
+                                                    const float4 point,
+                                                    const Transform tfm,
+                                                    ccl_private float *distance)
+{
+  *distance = 0.0f;
+  if (!isfinite_safe(p) || !isfinite_safe(make_float3(point)) ||
+      !isfinite_safe(point.w) || point.w < 0.0f)
+  {
+    return false;
+  }
+  const float4 rows[3] = {tfm.x, tfm.y, tfm.z};
+  const double query[3] = {p.x, p.y, p.z};
+  const double center[3] = {point.x, point.y, point.z};
+  double a[3][3], y[3], scale = 0.0;
+  for (int i = 0; i < 3; i++) {
+    if (!isfinite_safe(make_float3(rows[i])) || !isfinite_safe(rows[i].w)) {
+      return false;
+    }
+    a[i][0] = rows[i].x;
+    a[i][1] = rows[i].y;
+    a[i][2] = rows[i].z;
+    y[i] = query[i] - rows[i].w;
+    for (int j = 0; j < 3; j++) {
+      y[i] -= a[i][j] * center[j];
+      if (::fabs(a[i][j]) > scale) {
+        scale = ::fabs(a[i][j]);
+      }
+    }
+  }
+  if (point.w == 0.0f) {
+    const double d = ::sqrt(y[0] * y[0] + y[1] * y[1] + y[2] * y[2]);
+    if (d > FLT_MAX) {
+      return false;
+    }
+    *distance = float(d);
+    return true;
+  }
+  if (scale == 0.0) {
+    return false;
+  }
+  const double unit = scale * double(point.w);
+  double q[3][3] = {}, basis[3][3] = {};
+  for (int i = 0; i < 3; i++) {
+    y[i] /= unit;
+    basis[i][i] = 1.0;
+    for (int j = 0; j < 3; j++) {
+      for (int k = 0; k < 3; k++) {
+        q[i][j] += (a[i][k] / scale) * (a[j][k] / scale);
+      }
+    }
+  }
+  /* Symmetric Jacobi eigensystem of A*A^T. Eigenvectors are world-space axes. */
+  for (int iteration = 0; iteration < 64; iteration++) {
+    int u = 0, v = 1;
+    if (::fabs(q[0][2]) > ::fabs(q[u][v])) {
+      u = 0;
+      v = 2;
+    }
+    if (::fabs(q[1][2]) > ::fabs(q[u][v])) {
+      u = 1;
+      v = 2;
+    }
+    if (q[u][v] == 0.0) {
+      break;
+    }
+    const double tau = (q[v][v] - q[u][u]) / (2.0 * q[u][v]);
+    if (::fabs(tau) > 1e150) {
+      return false;
+    }
+    const double t = (tau < 0.0 ? -1.0 : 1.0) / (::fabs(tau) + ::sqrt(1.0 + tau * tau));
+    const double c = 1.0 / ::sqrt(1.0 + t * t), s = t * c;
+    const double off = q[u][v];
+    q[u][u] -= t * off;
+    q[v][v] += t * off;
+    q[u][v] = q[v][u] = 0.0;
+    for (int k = 0; k < 3; k++) {
+      if (k != u && k != v) {
+        const double ku = q[k][u], kv = q[k][v];
+        q[k][u] = q[u][k] = c * ku - s * kv;
+        q[k][v] = q[v][k] = s * ku + c * kv;
+      }
+      const double bu = basis[k][u], bv = basis[k][v];
+      basis[k][u] = c * bu - s * bv;
+      basis[k][v] = s * bu + c * bv;
+    }
+    if (::fabs(q[0][1]) + ::fabs(q[0][2]) + ::fabs(q[1][2]) <=
+        4.0 * DBL_EPSILON * (q[0][0] + q[1][1] + q[2][2]))
+    {
+      break;
+    }
+  }
+  double d[3], z[3] = {};
+  int smallest = 0;
+  double largest = 0.0;
+  for (int i = 0; i < 3; i++) {
+    d[i] = q[i][i];
+    if (d[i] < q[smallest][smallest]) {
+      smallest = i;
+    }
+    if (d[i] > largest) {
+      largest = d[i];
+    }
+    for (int j = 0; j < 3; j++) {
+      z[i] += basis[j][i] * y[j];
+    }
+  }
+  if (!(d[smallest] > 1e-10 * largest) ||
+      ::fabs(q[0][1]) + ::fabs(q[0][2]) + ::fabs(q[1][2]) > 16.0 * DBL_EPSILON * largest)
+  {
+    return false;
+  }
+  if (d[0] == d[1] && d[1] == d[2]) {
+    const double result = unit * ::fabs(::sqrt(y[0] * y[0] + y[1] * y[1] + y[2] * y[2]) -
+                                      ::sqrt(d[0]));
+    if (result > FLT_MAX) {
+      return false;
+    }
+    *distance = float(result);
+    return true;
+  }
+  /* Shift the multiplier by the smallest squared semiaxis. This avoids
+   * subtracting nearly equal numbers for interior queries close to a pole. */
+  const double pole = d[smallest];
+  double pole_norm = 0.0, weighted_norm = 0.0;
+  bool hard_case = true;
+  for (int i = 0; i < 3; i++) {
+    weighted_norm += d[i] * z[i] * z[i];
+    if (d[i] == pole) {
+      hard_case &= z[i] == 0.0;
+    }
+    else {
+      const double ratio = ::sqrt(d[i]) * z[i] / (d[i] - pole);
+      pole_norm += ratio * ratio;
+    }
+  }
+  double x[3] = {};
+  if (hard_case && pole_norm <= 1.0) {
+    for (int i = 0; i < 3; i++) {
+      if (d[i] != pole) {
+        x[i] = d[i] * z[i] / (d[i] - pole);
+      }
+    }
+    x[smallest] = ::sqrt(pole * (1.0 - pole_norm));
+  }
+  else {
+    double lo = 0.0, hi = pole + ::sqrt(weighted_norm);
+    bool converged = false;
+    for (int iteration = 0; iteration < 256; iteration++) {
+      const double mid = lo + (hi - lo) * 0.5;
+      if (mid == lo || mid == hi || hi - lo <= 8.0 * DBL_EPSILON * hi) {
+        converged = true;
+        break;
+      }
+      double norm = 0.0;
+      for (int i = 0; i < 3; i++) {
+        const double ratio = ::sqrt(d[i]) * z[i] / (d[i] - pole + mid);
+        norm += ratio * ratio;
+      }
+      if (norm > 1.0) {
+        lo = mid;
+      }
+      else {
+        hi = mid;
+      }
+    }
+    if (!converged) {
+      return false;
+    }
+    const double multiplier = lo + (hi - lo) * 0.5;
+    for (int i = 0; i < 3; i++) {
+      x[i] = d[i] * z[i] / (d[i] - pole + multiplier);
+    }
+  }
+  double square = 0.0, surface = 0.0;
+  for (int i = 0; i < 3; i++) {
+    square += (x[i] - z[i]) * (x[i] - z[i]);
+    surface += x[i] * x[i] / d[i];
+  }
+  const double result = unit * ::sqrt(square);
+  if (::fabs(surface - 1.0) > 1e-10 || !(result <= FLT_MAX)) {
+    return false;
+  }
+  *distance = float(result);
+  return true;
+}
+
+CCL_NAMESPACE_END
