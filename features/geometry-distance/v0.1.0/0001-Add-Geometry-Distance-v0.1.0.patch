+# SPDX-FileCopyrightText: 2026 Blender Authors
+#
+# SPDX-License-Identifier: Apache-2.0
+
+param(
+  [Parameter(Mandatory=$true)][string]$BuildDirectory,
+  [string]$OptixRoot = $env:OPTIX_ROOT_DIR,
+  [string]$CudaRoot = $env:CUDA_PATH,
+  [string]$CudaArchitecture = 'compute_89',
+  [Parameter(Mandatory=$true)][string]$DependencyDirectory,
+  [string]$TestFilter = '*'
+)
+$ErrorActionPreference = 'Stop'
+if (!$OptixRoot -or !(Test-Path "$OptixRoot\include\optix.h") -or
+    !$CudaRoot -or !(Test-Path "$CudaRoot\bin\nvcc.exe")) {
+  Write-Output 'SKIP: Set OPTIX_ROOT_DIR and CUDA_PATH, or pass SDK root parameters.'
+  return
+}
+$sourceRoot = [IO.Path]::GetFullPath((Join-Path $PSScriptRoot '..\..\..'))
+$cyclesRoot = Join-Path $sourceRoot 'intern\cycles'
+$vswhere = Join-Path ${env:ProgramFiles(x86)} 'Microsoft Visual Studio\Installer\vswhere.exe'
+$visualStudio = & $vswhere -latest -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath
+$vcvars = Join-Path $visualStudio 'VC\Auxiliary\Build\vcvars64.bat'
+$runtime = Join-Path $BuildDirectory 'runtime'
+$runtimeSource = Join-Path $runtime 'source'
+New-Item -ItemType Directory -Path $runtimeSource -Force | Out-Null
+Copy-Item -LiteralPath (Join-Path $cyclesRoot 'kernel') -Destination $runtimeSource -Recurse -Force
+Copy-Item -LiteralPath (Join-Path $cyclesRoot 'util') -Destination $runtimeSource -Recurse -Force
+$dependencyBins = Get-ChildItem -LiteralPath $DependencyDirectory -Directory |
+  ForEach-Object { Join-Path $_.FullName 'bin' } | Where-Object { Test-Path -LiteralPath $_ }
+$env:PATH = ($dependencyBins -join ';') + ';' + $env:PATH
+$env:GEOMETRY_DISTANCE_RUNTIME_DIR = $runtime
+$env:GEOMETRY_DISTANCE_PRODUCTION_PTX = Join-Path $BuildDirectory 'geometry_distance_production.ptx'
+$env:GEOMETRY_DISTANCE_SNAPSHOT_DIR = $BuildDirectory
+$env:OPTIX_ROOT_DIR = $OptixRoot
+$env:CUDA_PATH = $CudaRoot
+$openvdbInclude = Join-Path $DependencyDirectory 'openvdb/include'
+$env:CYCLES_CUDA_EXTRA_CFLAGS = "-allow-unsupported-compiler -D_ALLOW_COMPILER_AND_STL_VERSION_MISMATCH -I`"$openvdbInclude`""
+$executable = Join-Path $BuildDirectory 'integration/bin/tests/Release/cycles_geometry_distance_test.exe'
+if (!(Test-Path -LiteralPath $executable)) { throw "Build cycles_geometry_distance_test first: $executable" }
+$commands = @('@echo off', "call `"$vcvars`" >nul", 'if errorlevel 1 exit /b %errorlevel%',
+              "cd /d `"$BuildDirectory`"")
+$commands += "`"$CudaRoot\bin\nvcc.exe`" -std=c++17 -arch=$CudaArchitecture --use_fast_math -allow-unsupported-compiler -D_ALLOW_COMPILER_AND_STL_VERSION_MISMATCH -I `"$cyclesRoot`" -I `"$OptixRoot\include`" -ptx `"$PSScriptRoot\geometry_distance_production.cu`" -o geometry_distance_production.ptx"
+$commands += 'if errorlevel 1 exit /b %errorlevel%'
+$commands += "`"$executable`" --gtest_filter=$TestFilter"
+$commands += 'exit /b %errorlevel%'
+$commandFile = Join-Path $BuildDirectory 'run_production_tests.cmd'
+$commands | Set-Content -Encoding ascii -LiteralPath $commandFile
+& cmd.exe /d /c $commandFile 2>&1 | Tee-Object -FilePath (Join-Path $BuildDirectory 'results_production.log')
+if ($LASTEXITCODE -ne 0) { throw "Production Geometry Distance tests failed with exit code $LASTEXITCODE." }
