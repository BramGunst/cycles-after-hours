+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include "UI_interface_layout.hh"
+#include "UI_resources.hh"
+#include "node_shader_util.hh"
+
+namespace blender {
+namespace nodes::node_shader_geometry_distance_cc {
+
+static void node_declare(NodeDeclarationBuilder &b)
+{
+  b.add_input<decl::Vector>("Position"_ustr)
+      .hide_value()
+      .description(
+          "World-space position from which to measure. When unconnected, uses the current shading "
+          "position");
+  b.add_input<decl::Float>("Max Distance"_ustr)
+      .default_value(1.0f)
+      .min(0.0f)
+      .subtype(PROP_DISTANCE);
+  b.add_output<decl::Float>("Distance"_ustr).subtype(PROP_DISTANCE);
+  b.add_output<decl::Float>("Factor"_ustr);
+  b.add_output<decl::Float>("Found"_ustr);
+}
+
+static void node_layout(ui::Layout &layout, bContext * /*C*/, PointerRNA *ptr)
+{
+  layout.prop(ptr, "falloff", ui::ITEM_R_SPLIT_EMPTY_NAME, std::nullopt, ICON_NONE);
+}
+
+}  // namespace nodes::node_shader_geometry_distance_cc
+
+void register_node_type_sh_geometry_distance()
+{
+  static bke::bNodeType ntype;
+  sh_node_type_base(&ntype, "ShaderNodeGeometryDistance"_ustr, SH_NODE_GEOMETRY_DISTANCE);
+  ntype.ui_name = "Geometry Distance";
+  ntype.ui_description =
+      "Distance to another object's mesh or point sphere surface. Cycles SVM only";
+  ntype.enum_name_legacy = "GEOMETRY_DISTANCE";
+  ntype.nclass = NODE_CLASS_INPUT;
+  ntype.declare = nodes::node_shader_geometry_distance_cc::node_declare;
+  ntype.draw_buttons = nodes::node_shader_geometry_distance_cc::node_layout;
+  bke::node_register_type(ntype);
+}
+
+}  // namespace blender
