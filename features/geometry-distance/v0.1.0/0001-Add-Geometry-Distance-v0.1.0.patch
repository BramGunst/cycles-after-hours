+CCL_NAMESPACE_BEGIN
+
+ccl_device_inline GeometryDistanceResult geometry_distance_scene(
+    KernelGlobals kg, const float3 position, const int current_object,
+    const float max_distance, const float time, GeometryDistanceStats *stats = nullptr)
+{
+  if (!kernel_data.geometry_distance.valid) {
+    GeometryDistanceResult result = {};
+    result.supported = false;
+    return result;
+  }
+  const GeometryDistanceBVH view = {
+      kernel_data_array(geometry_distance_nodes),
+      kernel_data_array(geometry_distance_leaf_nodes),
+      kernel_data_array(geometry_distance_object_node),
+      kernel_data_array(geometry_distance_prim_type),
+      kernel_data_array(geometry_distance_prim_index),
+      kernel_data_array(geometry_distance_prim_object),
+      kernel_data_array(objects), kernel_data_array(object_flag),
+      kernel_data_array(tri_vindex), kernel_data_array(tri_verts),
+      kernel_data_array(geometry_distance_prim_time),
+      kernel_data.geometry_distance.root, kernel_data.geometry_distance.num_objects,
+      kernel_data.geometry_distance.num_references, kernel_data_array(points)};
+  return geometry_distance_other_geometry(view, position, current_object, max_distance, time, stats);
+}
+
+CCL_NAMESPACE_END
