diff --git a/intern/cycles/test/geometry_distance_optix_kernel.cu b/intern/cycles/test/geometry_distance_optix_kernel.cu
new file mode 100644
--- /dev/null
+++ b/intern/cycles/test/geometry_distance_optix_kernel.cu
@@ -0,0 +1,81 @@
+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#include <optix.h>
+#define __KERNEL_OPTIX__
+#include "kernel/device/cuda/compat.h"
+#include "test/geometry_distance_optix_launch.h"
+#include <optix_device.h>
+
+extern "C" {
+__constant__ GeometryDistanceOptixLaunch proximity_params;
+}
+
+extern "C" __global__ void __raygen__proximity()
+{
+  const unsigned int index = optixGetLaunchIndex().x;
+  const auto query = proximity_params.queries[index];
+  auto &out = proximity_params.output[index];
+  out.feature_observation[0] = proximity_params.data->kernel_features;
+  out.feature_observation[1] = sizeof(KernelData);
+  out.feature_observation[2] = offsetof(KernelData, cam);
+  out.feature_observation[3] = offsetof(KernelData, device_bvh);
+  for (int pass = 0; pass < 4; pass++) {
+    unsigned int t = __float_as_uint(100.0f), object = unsigned(-1), prim = unsigned(-1);
+    optixTrace(proximity_params.scene,
+               make_float3(query.x, query.y, query.z - 4),
+               make_float3(0, 0, 1),
+               0.0f,
+               100.0f,
+               query.time,
+               255,
+               OPTIX_RAY_FLAG_NONE,
+               0,
+               1,
+               0,
+               t,
+               object,
+               prim);
+    out.ray_t[pass] = __uint_as_float(t);
+    out.ray_object[pass] = int(object);
+    out.ray_primitive[pass] = int(prim);
+    if (pass < 3) {
+      out.distance[pass] = geometry_distance_other_geometry(*proximity_params.view,
+                                                            make_float3(query.x, query.y, query.z),
+                                                            query.current,
+                                                            query.maximum,
+                                                            query.time,
+                                                            &out.stats[pass]);
+    }
+  }
+}
+
+extern "C" __global__ void __miss__proximity() {}
+
+extern "C" __global__ void __closesthit__proximity()
+{
+  optixSetPayload_0(__float_as_uint(optixGetRayTmax()));
+  optixSetPayload_1(optixGetInstanceId());
+  optixSetPayload_2(optixGetPrimitiveIndex());
+}
+
+extern "C" __global__ void __intersection__point()
+{
+  const int object = optixGetInstanceId();
+  const int prim = optixGetPrimitiveIndex();
+  const float4 point = geometry_distance_point(
+      *proximity_params.view, object, prim, optixGetRayTime(), true);
+  const float3 origin = optixGetObjectRayOrigin(), direction = optixGetObjectRayDirection();
+  const float3 delta = make_float3(point) - origin;
+  const float inverse = 1.0f / dot(direction, direction);
+  const float projection = dot(delta, direction) * inverse;
+  const float3 perpendicular = delta - projection * direction;
+  const float square = point.w * point.w - dot(perpendicular, perpendicular);
+  if (square >= 0) {
+    const float t = projection - sqrtf(square * inverse);
+    if (t >= optixGetRayTmin() && t <= optixGetRayTmax()) {
+      optixReportIntersection(t, 0);
+    }
+  }
+}
