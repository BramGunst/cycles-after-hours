+  if (!directory) {
+    GTEST_SKIP() << "Set GEOMETRY_DISTANCE_SNAPSHOT_DIR for the opt-in runtime prototype.";
+  }
+  for (int mode = 0; mode < 9; mode++) {
+    BuiltScene b;
+    if (mode == 4) {
+      b.scene->params.bvh_type = BVH_TYPE_STATIC;
+    }
+    if (mode == 0 || mode == 2 || mode == 8) {
+      Transform tfm = translation(0, 0, -1);
+      if (mode == 8) {
+        tfm.x.x = -2;
+        tfm.y.y = 0.5f;
+        tfm.z.x = 0.3f;
+      }
+      b.object(b.mesh(plane()), tfm);
+    }
+    if (mode != 0 && mode != 8) {
+      if (mode >= 5) {
+        b.scene->params.num_bvh_time_steps = 1;
+        b.object(b.cloud({{make_float4(100, 0, 0, 1)}}), transform_identity());
+      }
+      std::vector<float4> points;
+      const int count = mode == 3 ? 512 : 4;
+      for (int i = 0; i < count; i++) {
+        points.push_back(
+            make_float4(float(i % 16) * 0.3f, float(i / 16) * 0.3f, 0.1f, 0.01f * (1 + i % 4)));
+      }
+      std::vector<std::vector<float4>> keys = {points};
+      if (mode >= 5) {
+        keys.resize(5, points);
+        for (int step = 0; step < 5; step++) {
+          for (auto &point : keys[step]) {
+            if (mode != 6) {
+              point.z += float(step % 2) * 0.25f;
+            }
+            if (mode != 5) {
+              point.w += float(step % 2) * 0.05f;
+            }
+          }
+        }
+      }
+      const int cloud = b.cloud(keys);
+      b.object(cloud, transform_identity());
+      Transform affine = translation(0, 0, 2);
+      affine.x.x = -2;
+      affine.y.y = 0.5f;
+      affine.x.y = 0.75f;
+      if (mode == 4) {
+        affine.x = make_float4(-2, 0, 0, 0);
+        affine.y.y = -2;
+        affine.z.z = -2;
+        b.object(b.cloud({points}), affine);
+      }
+      else {
+        b.object(cloud, affine);
+      }
+    }
+    b.publish();
+    ASSERT_FALSE(HasFatalFailure());
+    DeviceScene &d = b.scene->dscene;
+    std::vector<GeometryDistanceSnapshotQuery> queries;
+    auto *globals = b.device->acquire_cpu_kernel_thread_globals();
+    for (int i = 0; i < 30; i++) {
+      const float3 p = make_float3(
+          float(i % 4) * (i < 16 ? 0.3f : -0.6f), 0, i < 16 ? 0.0f : 2.0f);
+      const float time = float(i % 6) / 5;
+      const int current = i % 3 == 0 ? 0 : -1;
+      const float maximum = i % 4 == 0 ? 0.1f : 5.0f;
+      b.compare(p, current, maximum, time);
+      Ray ray = {};
+      ray.P = p - make_float3(0, 0, 4);
+      ray.D = make_float3(0, 0, 1);
+      ray.tmax = 100;
+      ray.time = time;
+      ray.self = {PRIM_NONE, OBJECT_NONE, PRIM_NONE, OBJECT_NONE};
+      Intersection hit;
+      scene_intersect(&(*globals)[0], &ray, PATH_RAY_VISIBILITY_CAMERA, &hit);
+      queries.push_back({p.x,
+                         p.y,
+                         p.z,
+                         maximum,
+                         time,
+                         current,
+                         oracle(b.source, p, current, maximum, time),
+                         hit.t,
+                         hit.object,
+                         hit.prim});
+    }
+    b.device->release_cpu_kernel_thread_globals();
+    GeometryDistanceSnapshotHeader header;
+    header.root = d.data.bvh.root;
+    const size_t counts[] = {d.bvh_nodes.size(),
+                             d.bvh_leaf_nodes.size(),
+                             d.objects.size(),
+                             d.prim_index.size(),
+                             d.tri_vindex.size(),
+                             d.tri_verts.size(),
+                             d.points.size(),
+                             d.prim_time.size()};
+    for (int i = 0; i < 8; i++) {
+      header.counts[i] = unsigned(counts[i]);
+    }
+    header.queries = unsigned(queries.size());
+    std::ofstream file(std::string(directory) + "/scene_" + std::to_string(mode) + ".bin",
+                       std::ios::binary);
+    auto write = [&](const auto *data, const size_t count) {
+      if (count) {
+        file.write(reinterpret_cast<const char *>(data), count * sizeof(*data));
+      }
+    };
+    write(&header, 1);
+    write(d.bvh_nodes.data(), counts[0]);
+    write(d.bvh_leaf_nodes.data(), counts[1]);
+    write(d.object_node.data(), counts[2]);
+    write(d.objects.data(), counts[2]);
+    write(d.object_flag.data(), counts[2]);
+    write(d.object_prim_offset.data(), counts[2]);
+    write(d.prim_type.data(), counts[3]);
+    write(d.prim_index.data(), counts[3]);
+    write(d.prim_object.data(), counts[3]);
+    write(d.tri_vindex.data(), counts[4]);
+    write(d.tri_verts.data(), counts[5]);
+    write(d.points.data(), counts[6]);
+    write(d.prim_time.data(), counts[7]);
+    write(queries.data(), queries.size());
+    ASSERT_TRUE(file.good());
+  }
+}
