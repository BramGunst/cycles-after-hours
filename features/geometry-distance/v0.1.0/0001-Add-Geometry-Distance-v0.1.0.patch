+static void request_geometry_distance(BuiltScene &b, bool enabled)
+{
+  auto graph = make_unique<ShaderGraph>();
+  EmissionNode *node = enabled ? graph->create_node<FeatureTestNode>() :
+                                 graph->create_node<EmissionNode>();
+  graph->connect(node->output("Emission"), graph->output()->input("Surface"));
+  b.scene->default_surface->set_graph(std::move(graph));
+  b.scene->default_surface->tag_update(b.scene.get());
+}
