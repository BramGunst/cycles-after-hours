+static void check_companion_cleanup(BuiltScene &b)
+{
+  b.object(b.mesh(plane()), transform_identity());
+  b.object(b.cloud({{make_float4(0, 0, 2, 0.2f)}}), transform_identity());
+  request_geometry_distance(b, true);
+  b.publish();
+  ASSERT_FALSE(::testing::Test::HasFatalFailure());
+  auto *manager = b.scene->geometry_manager.get();
+  const size_t builds = manager->geometry_distance_build_count();
+  const Transform tfm = translation(0.2f, 0, 0);
+  b.scene->objects[1]->set_tfm(tfm);
+  b.scene->objects[1]->tag_update(b.scene.get());
+  b.source.objects[1].tfm = tfm;
+  Progress progress;
+  progress.set_cancel_callback([&]() {
+    string status, substatus;
+    progress.get_status(status, substatus);
+    if (status == "Updating Geometry Distance")
+      progress.set_cancel("Companion cancellation test");
+  });
+  {
+    thread_scoped_lock lock(b.scene->mutex);
+    b.scene->device_update(b.device.get(), progress);
+  }
+  EXPECT_TRUE(progress.get_cancel());
+  EXPECT_EQ(b.scene->dscene.data.geometry_distance.valid, 0);
+  EXPECT_EQ(manager->geometry_distance_build_count(), builds);
+  b.publish();
+  ASSERT_FALSE(::testing::Test::HasFatalFailure());
+  EXPECT_EQ(b.scene->dscene.data.geometry_distance.valid, 1);
+  EXPECT_EQ(manager->geometry_distance_build_count(), builds + 1);
+#  ifdef WITH_OPTIX
+  if (b.device->info.type == DEVICE_OPTIX)
+    check_production_queries(b);
+#  endif
+  Object *object = b.scene->objects[1];
+  PointCloud *cloud = b.pointclouds[1];
+  b.scene->delete_node(object);
+  EXPECT_FALSE(manager->geometry_distance_has_cache());
+  EXPECT_EQ(companion_bytes(b.scene->dscene), 0);
+  EXPECT_EQ(b.scene->dscene.data.geometry_distance.valid, 0);
+  b.scene->delete_node(cloud);
+  b.source.objects.resize(1);
+  b.source.object_mesh.resize(1);
+  b.source.flags.resize(1);
+  b.source.meshes.resize(1);
+  b.source.motion_keys.resize(1);
+  b.source.point_keys.resize(1);
+  b.source.point_offsets.resize(1);
+  b.source.primitive_base.resize(1);
+  b.meshes.resize(1);
+  b.pointclouds.resize(1);
+  b.publish();
+  ASSERT_FALSE(::testing::Test::HasFatalFailure());
+#  ifdef WITH_OPTIX
+  if (b.device->info.type == DEVICE_OPTIX)
+    check_production_queries(b);
+#  endif
+  Light *light = b.scene->create_node<PointLight>();
+  b.publish();
+  ASSERT_FALSE(::testing::Test::HasFatalFailure());
+  const size_t builds_before_light_delete = manager->geometry_distance_build_count();
+  b.scene->delete_node(light);
+  EXPECT_TRUE(manager->need_update());
+  EXPECT_FALSE(manager->geometry_distance_has_cache());
+  EXPECT_EQ(companion_bytes(b.scene->dscene), 0);
+  EXPECT_EQ(b.scene->dscene.data.geometry_distance.valid, 0);
+  b.publish();
+  ASSERT_FALSE(::testing::Test::HasFatalFailure());
+  EXPECT_TRUE(manager->geometry_distance_has_cache());
+  EXPECT_EQ(manager->geometry_distance_build_count(), builds_before_light_delete + 1);
+  EXPECT_GT(companion_bytes(b.scene->dscene), 0);
+  EXPECT_EQ(b.scene->dscene.data.geometry_distance.valid, 1);
+#  ifdef WITH_OPTIX
+  if (b.device->info.type == DEVICE_OPTIX)
+    check_production_queries(b);
+#  endif
+  b.scene->reset();
+  EXPECT_FALSE(manager->geometry_distance_has_cache());
+  EXPECT_EQ(companion_bytes(b.scene->dscene), 0);
+  EXPECT_EQ(b.scene->dscene.data.geometry_distance.valid, 0);
+  b.publish();
+  ASSERT_FALSE(::testing::Test::HasFatalFailure());
+#  ifdef WITH_OPTIX
+  if (b.device->info.type == DEVICE_OPTIX)
+    check_production_queries(b);
+#  endif
+  b.scene->device_free();
+  EXPECT_FALSE(manager->geometry_distance_has_cache());
+  EXPECT_EQ(companion_bytes(b.scene->dscene), 0);
+  EXPECT_EQ(b.scene->dscene.data.geometry_distance.valid, 0);
+  b.scene->reset();
+  b.source = Fixture();
+  b.meshes.clear();
+  b.pointclouds.clear();
+  b.publish();
+  ASSERT_FALSE(::testing::Test::HasFatalFailure());
+  EXPECT_FALSE(manager->geometry_distance_has_cache());
+  ASSERT_FALSE(::testing::Test::HasFailure());
+  std::printf("production_cleanup device=%d cancellation=pass deletion=pass reset=pass\n",
+              int(b.device->info.type));
+}
