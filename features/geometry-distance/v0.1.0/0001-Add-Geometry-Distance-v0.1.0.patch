+TEST(geometry_distance_scene, alternate_blas_lookup)
+{
+  BuiltScene b;
+  const int mesh = b.mesh(plane());
+  const int points = b.cloud({{make_float4(0, 0, 2, 0.25f)}});
+  b.object(mesh, transform_identity());
+  b.object(mesh, translation(0, 0, 4));
+  b.object(points, transform_identity());
+  b.object(points, translation(2, 0, 0));
+  b.publish();
+  ASSERT_FALSE(HasFatalFailure());
+
+  BVH *primary_top = b.scene->bvh.get();
+  vector<BVH *> primary_blas;
+  vector<unique_ptr<Object>> build_objects;
+  vector<unique_ptr<BVH2>> alternate_blas;
+  BVHParams params;
+  params.bvh_layout = BVH_LAYOUT_BVH2;
+  params.use_unaligned_nodes = false;
+  Progress progress;
+  for (Geometry *geometry : b.scene->geometry) {
+    primary_blas.push_back(geometry->bvh.get());
+    auto object = make_unique<Object>();
+    object->set_geometry(geometry);
+    object->set_visibility(PATH_RAY_VISIBILITY_ALL);
+    object->set_is_shadow_catcher(true);
+    vector<Geometry *> geometries = {geometry};
+    vector<Object *> objects = {object.get()};
+    auto blas = make_unique<BVH2>(params, geometries, objects);
+    blas->build(progress, &b.stats);
+    ASSERT_FALSE(progress.get_cancel());
+    build_objects.push_back(std::move(object));
+    alternate_blas.push_back(std::move(blas));
+  }
+  int lookups = 0;
+  params.top_level = true;
+  BVH2 alternate(params, b.scene->geometry, b.scene->objects, [&](Geometry *geometry) {
+    lookups++;
+    for (size_t i = 0; i < b.scene->geometry.size(); i++) {
+      if (b.scene->geometry[i] == geometry) {
+        return alternate_blas[i].get();
+      }
+    }
+    return static_cast<BVH2 *>(nullptr);
+  });
+  alternate.build(progress, &b.stats);
+  ASSERT_FALSE(progress.get_cancel());
+  EXPECT_GT(lookups, 0);
+  EXPECT_EQ(b.scene->bvh.get(), primary_top);
+  for (size_t i = 0; i < primary_blas.size(); i++) {
+    EXPECT_EQ(b.scene->geometry[i]->bvh.get(), primary_blas[i]);
+  }
+  const PackedBVH &pack = alternate.pack;
+  GeometryDistanceBVH view = b.view();
+  view.nodes = reinterpret_cast<const float4 *>(pack.nodes.data());
+  view.leaf_nodes = reinterpret_cast<const float4 *>(pack.leaf_nodes.data());
+  view.object_node = reinterpret_cast<const uint *>(pack.object_node.data());
+  view.prim_type = reinterpret_cast<const uint *>(pack.prim_type.data());
+  view.prim_index = reinterpret_cast<const uint *>(pack.prim_index.data());
+  view.prim_object = reinterpret_cast<const uint *>(pack.prim_object.data());
+  view.root = pack.root_index;
+  view.num_references = int(pack.prim_index.size());
+  for (const float3 query : {make_float3(0, 0, 1), make_float3(2, 0, 3), make_float3(0, 0, 5)}) {
+    for (const float radius : {0.1f, 1.0f, 10.0f}) {
+      const auto expected = oracle(b.source, query, -1, radius, 0.5f);
+      const auto actual = geometry_distance_other_geometry(view, query, -1, radius, 0.5f);
+      EXPECT_TRUE(actual.supported);
+      EXPECT_EQ(actual.found, expected.found);
+      EXPECT_EQ(actual.object, expected.object);
+      EXPECT_EQ(actual.primitive, expected.primitive);
+      EXPECT_EQ(actual.primitive_type, expected.primitive_type);
+      EXPECT_NEAR(actual.distance, expected.distance, 2e-5f);
+    }
+  }
+}
