+TEST(geometry_distance, deterministic_affine_queries)
+{
+  uint state = 0x831f43u;
+  const auto random = [&]() {
+    state = 1664525u * state + 1013904223u;
+    return float(state >> 8) * (1.0f / 16777216.0f);
+  };
+  float max_error = 0;
+  for (int iteration = 0; iteration < 300; iteration++) {
+    Fixture f;
+    std::vector<Triangle> triangles;
+    for (int i = 0; i < 6; i++) {
+      Triangle tri;
+      for (auto &v : tri) {
+        v = make_float3(random() * 4 - 2, random() * 4 - 2, random() * 4 - 2);
+      }
+      triangles.push_back(tri);
+    }
+    const int mesh = f.mesh(triangles);
+    for (int o = 0; o < 4; o++) {
+      Transform t = translation(random() * 10 - 5, random() * 10 - 5, random() * 10 - 5);
+      t.x.x = random() * 4 - 2;
+      t.y.y = random() * 3 + 0.1f;
+      t.z.z = random() * 2 + 0.1f;
+      t.x.y = random() - 0.5f;
+      t.y.z = random() - 0.5f;
+      t.z.x = random() - 0.5f;
+      f.object(mesh, t);
+    }
+    f.finish();
+    const float3 p = make_float3(random() * 10 - 5, random() * 10 - 5, random() * 10 - 5);
+    const float radius = iteration % 3 == 0 ? 0.2f : 20.0f;
+    const auto expected = oracle(f, p, iteration % 4, radius);
+    const auto actual = geometry_distance_other_geometry(f.view(), p, iteration % 4, radius, 0.5f);
+    ASSERT_TRUE(actual.supported);
+    ASSERT_EQ(actual.found, expected.found) << iteration;
+    EXPECT_NEAR(actual.distance, expected.distance, 2e-5f * std::max(1.0f, expected.distance));
+    EXPECT_EQ(actual.object, expected.object) << iteration;
+    EXPECT_EQ(actual.primitive, expected.primitive) << iteration;
+    compare_cuda(f, p, iteration % 4, radius, 0.5f, expected);
+    max_error = std::max(max_error, fabsf(actual.distance - expected.distance));
+  }
+  std::printf("affine_queries=300 max_absolute_error=%.9g\n", max_error);
+}
