@@ -0,0 +1,356 @@
+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+#include "kernel/geom/motion_point_data.h"
+#include "kernel/geom/motion_triangle_vertices.h"
+#include "kernel/types.h"
+#include "util/math_distance.h"
+
+CCL_NAMESPACE_BEGIN
+
+/* Non-owning view of aligned BVH2 triangle/point arrays with static object transforms. */
+struct GeometryDistanceBVH {
+  const ccl_global float4 *nodes;
+  const ccl_global float4 *leaf_nodes;
+  const ccl_global uint *object_node;
+  const ccl_global uint *prim_type;
+  const ccl_global uint *prim_index;
+  const ccl_global uint *prim_object;
+  const ccl_global KernelObject *objects;
+  const ccl_global uint *object_flag;
+  const ccl_global packed_uint3 *tri_vindex;
+  const ccl_global packed_float3 *tri_verts;
+  const ccl_global float2 *prim_time;
+  int root;
+  int num_objects;
+  int num_references;
+  const ccl_global float4 *points = nullptr;
+};
+
+struct GeometryDistanceResult {
+  bool supported;
+  bool found;
+  float distance;
+  int object;
+  int primitive;
+  int primitive_type = 0;
+};
+
+struct GeometryDistanceStats {
+  int nodes;
+  int leaves;
+  int triangles;
+  int points;
+};
+
+ccl_device_inline float geometry_distance_component(const float3 v, const int i)
+{
+  return i == 0 ? v.x : (i == 1 ? v.y : v.z);
+}
+
+ccl_device_inline float geometry_distance_component(const float4 v, const int i)
+{
+  return i == 3 ? v.w : (i == 0 ? v.x : (i == 1 ? v.y : v.z));
+}
+
+ccl_device_inline float geometry_distance_round_down(const float x)
+{
+  return nextafterf(x, -FLT_MAX);
+}
+
+ccl_device_inline float geometry_distance_round_up(const float x)
+{
+  return nextafterf(x, FLT_MAX);
+}
+
+/* Interval operations include rounding in affine transforms, including shear
+ * and negative scale. No inverse transform or local-space metric is needed. */
+ccl_device_inline void geometry_distance_transform_bounds(const Transform tfm,
+                                                          const float3 lower,
+                                                          const float3 upper,
+                                                          ccl_private float3 *lo,
+                                                          ccl_private float3 *hi)
+{
+  const float4 rows[3] = {tfm.x, tfm.y, tfm.z};
+  float low[3], high[3];
+  for (int axis = 0; axis < 3; axis++) {
+    float l = rows[axis].w;
+    float h = l;
+    for (int j = 0; j < 3; j++) {
+      const float a = geometry_distance_component(rows[axis], j) *
+                      geometry_distance_component(lower, j);
+      const float b = geometry_distance_component(rows[axis], j) *
+                      geometry_distance_component(upper, j);
+      l = geometry_distance_round_down(l + geometry_distance_round_down(min(a, b)));
+      h = geometry_distance_round_up(h + geometry_distance_round_up(max(a, b)));
+    }
+    low[axis] = l;
+    high[axis] = h;
+  }
+  *lo = make_float3(low[0], low[1], low[2]);
+  *hi = make_float3(high[0], high[1], high[2]);
+}
+
+ccl_device_inline float geometry_distance_bound(const float3 p,
+                                                const float3 lower,
+                                                const float3 upper)
+{
+  float result = 0.0f;
+  for (int i = 0; i < 3; i++) {
+    const float delta = max(
+        0.0f,
+        geometry_distance_round_down(
+            max(geometry_distance_component(lower, i) - geometry_distance_component(p, i),
+                geometry_distance_component(p, i) - geometry_distance_component(upper, i))));
+    const float square = max(0.0f, geometry_distance_round_down(delta * delta));
+    result = max(0.0f, geometry_distance_round_down(result + square));
+  }
+  return result;
+}
+
+ccl_device_inline void geometry_distance_triangle_vertices(const GeometryDistanceBVH bvh,
+                                                           const int object,
+                                                           const int prim,
+                                                           const float time,
+                                                           const bool motion,
+                                                           ccl_private float3 *v)
+{
+  const KernelObject ob = bvh.objects[object];
+  const uint3 index = bvh.tri_vindex[prim];
+  v[0] = bvh.tri_verts[ob.position_offset + index.x];
+  v[1] = bvh.tri_verts[ob.position_offset + index.y];
+  v[2] = bvh.tri_verts[ob.position_offset + index.z];
+  if (motion && ob.num_geom_steps > 1) {
+    const int maxstep = ob.num_geom_steps - 1;
+    const int step = min(int(time * maxstep), maxstep - 1);
+    const float t = time * maxstep - step;
+    motion_triangle_vertices_data(
+        bvh.tri_verts, index, ob.position_offset, ob.numverts, ob.num_geom_steps, step, t, v);
+  }
+  if (!(bvh.object_flag[object] & SD_OBJECT_TRANSFORM_APPLIED)) {
+    for (int i = 0; i < 3; i++) {
+      v[i] = transform_point(&ob.tfm, v[i]);
+    }
+  }
+}
+
+ccl_device_inline float4 geometry_distance_point(const GeometryDistanceBVH bvh,
+                                                 const int object,
+                                                 const int prim,
+                                                 const float time,
+                                                 const bool motion,
+                                                 const bool mesh_vertex = false)
+{
+  const KernelObject ob = bvh.objects[object];
+  if (mesh_vertex) {
+    float3 position = bvh.tri_verts[ob.position_offset + prim];
+    if (motion && ob.num_geom_steps > 1) {
+      const int maxstep = ob.num_geom_steps - 1;
+      const int step = min(int(time * maxstep), maxstep - 1);
+      float3 vertices[3];
+      motion_triangle_vertices_data(bvh.tri_verts,
+                                    make_uint3(prim, prim, prim),
+                                    ob.position_offset,
+                                    ob.numverts,
+                                    ob.num_geom_steps,
+                                    step,
+                                    time * maxstep - step,
+                                    vertices);
+      position = vertices[0];
+    }
+    return make_float4(position, 0.0f);
+  }
+  if (!motion || ob.num_geom_steps <= 1) {
+    return bvh.points[ob.position_offset + prim];
+  }
+  return motion_point_data(
+      bvh.points, ob.position_offset, ob.numverts, ob.num_geom_steps, prim, time);
+}
+
+ccl_device_inline GeometryDistanceResult
+geometry_distance_other_geometry(const GeometryDistanceBVH bvh,
+                                 const float3 p,
+                                 const int current_object,
+                                 const float max_distance,
+                                 const float time,
+                                 ccl_private GeometryDistanceStats *stats = nullptr)
+{
+  GeometryDistanceResult result = {true, false, max(0.0f, max_distance), OBJECT_NONE, PRIM_NONE};
+  if (stats) {
+    *stats = {0, 0, 0};
+  }
+  if (!isfinite_safe(max_distance) || !isfinite_safe(p) || !isfinite_safe(time) || time < 0.0f ||
+      time > 1.0f || !isfinite_safe(max_distance * max_distance))
+  {
+    result.supported = false;
+    return result;
+  }
+  if (max_distance <= 0.0f) {
+    return result;
+  }
+  if (max_distance * max_distance < FLT_MIN) {
+    result.supported = false;
+    return result;
+  }
+  /* Validate before pruning: a moving object must not disappear behind an
+   * unproven shutter bound and be mistaken for a valid no-hit result. */
+  for (int object = 0; object < bvh.num_objects; object++) {
+    if (bvh.object_flag[object] & SD_OBJECT_MOTION) {
+      result.supported = false;
+      return result;
+    }
+  }
+  if (bvh.num_references == 0) {
+    return result;
+  }
+
+  struct Entry {
+    int node;
+    int object;
+    float lower_bound;
+  };
+  /* BVHParams permits depth 64 at each of the scene and mesh levels. */
+  Entry stack[130];
+  int size = 1;
+  stack[0] = {bvh.root, OBJECT_NONE, 0.0f};
+  float best = max_distance * max_distance;
+  while (size) {
+    const Entry entry = stack[--size];
+    if (entry.lower_bound > best) {
+      continue;
+    }
+    if (entry.node >= 0) {
+      if (stats) {
+        stats->nodes++;
+      }
+      const float4 header = bvh.nodes[entry.node];
+      if (__float_as_uint(header.x) & PATH_RAY_VISIBILITY_NODE_UNALIGNED) {
+        result.supported = false;
+        return result;
+      }
+      const float4 x = bvh.nodes[entry.node + 1];
+      const float4 y = bvh.nodes[entry.node + 2];
+      const float4 z = bvh.nodes[entry.node + 3];
+      Entry children[2];
+      for (int child = 0; child < 2; child++) {
+        float3 lo = child == 0 ? make_float3(x.x, y.x, z.x) : make_float3(x.y, y.y, z.y);
+        float3 hi = child == 0 ? make_float3(x.z, y.z, z.z) : make_float3(x.w, y.w, z.w);
+        if (entry.object != OBJECT_NONE) {
+          geometry_distance_transform_bounds(bvh.objects[entry.object].tfm, lo, hi, &lo, &hi);
+        }
+        children[child] = {__float_as_int(child == 0 ? header.z : header.w),
+                           entry.object,
+                           geometry_distance_bound(p, lo, hi)};
+      }
+      if (children[0].lower_bound < children[1].lower_bound) {
+        const Entry tmp = children[0];
+        children[0] = children[1];
+        children[1] = tmp;
+      }
+      if (size + 2 > 130) {
+        result.supported = false;
+        return result;
+      }
+      for (int child = 0; child < 2; child++) {
+        if (children[child].lower_bound <= best) {
+          stack[size++] = children[child];
+        }
+      }
+      continue;
+    }
+    if (stats) {
+      stats->leaves++;
+    }
+    const float4 leaf = bvh.leaf_nodes[~entry.node];
+    const int start = __float_as_int(leaf.x);
+    if (start < 0) {
+      const int object = bvh.prim_object[~start];
+      if (object != current_object) {
+        if (entry.object != OBJECT_NONE || size == 130) {
+          result.supported = false;
+          return result;
+        }
+        stack[size++] = {int(bvh.object_node[object]), object, 0.0f};
+      }
+      continue;
+    }
+    for (int ref = start; ref < __float_as_int(leaf.y); ref++) {
+      const int type = bvh.prim_type[ref] & PRIMITIVE_ALL;
+      const bool point = type == PRIMITIVE_POINT || type == PRIMITIVE_MOTION_POINT;
+      const bool mesh_vertex = (bvh.prim_type[ref] & GEOMETRY_DISTANCE_LOOSE_VERTEX) ==
+                               GEOMETRY_DISTANCE_LOOSE_VERTEX;
+      if (!point && type != PRIMITIVE_TRIANGLE && type != PRIMITIVE_MOTION_TRIANGLE) {
+        continue;
+      }
+      if ((type & PRIMITIVE_MOTION) && bvh.prim_time &&
+          (time < bvh.prim_time[ref].x || time > bvh.prim_time[ref].y))
+      {
+        continue;
+      }
+      const int object = entry.object == OBJECT_NONE ? bvh.prim_object[ref] : entry.object;
+      if (object == current_object) {
+        continue;
+      }
+      const int prim = bvh.prim_index[ref];
+      float distance;
+      const int identity_type = point ? PRIMITIVE_POINT : PRIMITIVE_TRIANGLE;
+      if (point) {
+        const Transform identity = {
+            make_float4(1, 0, 0, 0), make_float4(0, 1, 0, 0), make_float4(0, 0, 1, 0)};
+        const Transform tfm = (bvh.object_flag[object] & SD_OBJECT_TRANSFORM_APPLIED) ?
+                                  identity :
+                                  bvh.objects[object].tfm;
+        float surface_distance;
+        if ((mesh_vertex ? !bvh.tri_verts : !bvh.points) ||
+            !point_affine_sphere_distance(
+                p,
+                geometry_distance_point(
+                    bvh, object, prim, time, type & PRIMITIVE_MOTION, mesh_vertex),
+                tfm,
+                &surface_distance))
+        {
+          result.supported = false;
+          result.found = false;
+          result.distance = max_distance;
+          result.object = OBJECT_NONE;
+          result.primitive = PRIM_NONE;
+          result.primitive_type = 0;
+          return result;
+        }
+        distance = surface_distance * surface_distance;
+        if (stats) {
+          stats->points++;
+        }
+      }
+      else {
+        float3 v[3];
+        geometry_distance_triangle_vertices(bvh, object, prim, time, type & PRIMITIVE_MOTION, v);
+        distance = point_triangle_distance_squared(p, v[0], v[1], v[2]);
+        if (stats) {
+          stats->triangles++;
+        }
+      }
+      /* Stable identity order: object, static primitive category, primitive index. */
+      const bool tie = !result.found || object < result.object ||
+                       (object == result.object &&
+                        (identity_type < result.primitive_type ||
+                         (identity_type == result.primitive_type && prim < result.primitive)));
+      if (distance < best || (distance == best && tie)) {
+        best = distance;
+        result.found = true;
+        result.object = object;
+        result.primitive = prim;
+        result.primitive_type = identity_type;
+      }
+    }
+  }
+  if (result.found) {
+    result.distance = sqrtf(best);
+  }
+  return result;
+}
+
+CCL_NAMESPACE_END
