new file mode 100644
--- /dev/null
+++ b/intern/cycles/kernel/geom/motion_triangle_vertices.h
@@ -0,0 +1,51 @@
+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+#include "util/math.h"
+
+CCL_NAMESPACE_BEGIN
+
+ccl_device_inline void motion_triangle_verts_for_step_data(
+    const ccl_global packed_float3 *positions,
+    const uint3 tri_vindex,
+    int offset,
+    const int numverts,
+    const int numsteps,
+    int step,
+    ccl_private float3 *verts)
+{
+  const int center_step = (numsteps - 1) / 2;
+  if (step != center_step) {
+    if (step < center_step) {
+      step++;
+    }
+    offset += step * numverts;
+  }
+  verts[0] = positions[offset + tri_vindex.x];
+  verts[1] = positions[offset + tri_vindex.y];
+  verts[2] = positions[offset + tri_vindex.z];
+}
+
+ccl_device_inline void motion_triangle_vertices_data(const ccl_global packed_float3 *positions,
+                                                     const uint3 tri_vindex,
+                                                     const int offset,
+                                                     const int numverts,
+                                                     const int numsteps,
+                                                     const int step,
+                                                     const float t,
+                                                     ccl_private float3 *verts)
+{
+  float3 next_verts[3];
+  motion_triangle_verts_for_step_data(
+      positions, tri_vindex, offset, numverts, numsteps, step, verts);
+  motion_triangle_verts_for_step_data(
+      positions, tri_vindex, offset, numverts, numsteps, step + 1, next_verts);
+  for (int i = 0; i < 3; i++) {
+    verts[i] = (1.0f - t) * verts[i] + t * next_verts[i];
+  }
+}
+
+CCL_NAMESPACE_END
