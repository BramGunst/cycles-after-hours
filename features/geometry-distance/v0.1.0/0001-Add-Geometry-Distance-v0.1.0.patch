+TEST(geometry_distance, deformation_at_time)
+{
+  for (int key_count : {3, 5}) {
+    Fixture f;
+    /* A preceding mesh exercises a nonzero vertex index base. */
+    f.mesh(plane());
+    std::vector<std::vector<Triangle>> keys;
+    for (int key = 0; key < key_count; key++) {
+      auto triangles = plane();
+      for (float3 &v : triangles[0]) {
+        v.z = 1.0f + 2.0f * key / (key_count - 1);
+      }
+      keys.push_back(triangles);
+    }
+    const int center = (key_count - 1) / 2;
+    const int mesh = f.mesh(keys[center]);
+    f.motion_keys[mesh] = keys;
+    for (int key = 0; key < key_count; key++) {
+      if (key != center) {
+        for (const Triangle &tri : keys[key]) {
+          for (float3 v : tri) {
+            f.vertices.push_back(v);
+          }
+        }
+      }
+    }
+    f.object(mesh, translation(0, 0, 10));
+    Transform tfm = transform_identity();
+    tfm.z.z = 2;
+    f.object(mesh, tfm);
+    f.roots[1] = f.roots[0];
+    if (key_count == 5) {
+      Bounds bounds;
+      for (const auto &key : keys) {
+        for (const auto &tri : key) {
+          for (const float3 v : tri) {
+            bounds.grow(v);
+          }
+        }
+      }
+      const int ref = int(f.indices.size());
+      f.indices.push_back(f.indices[0]);
+      f.owners.push_back(0);
+      f.types.push_back(PRIMITIVE_MOTION_TRIANGLE);
+      const Record duplicate = f.leaf(ref, ref + 1, bounds, PRIMITIVE_MOTION_TRIANGLE);
+      f.roots[0] = f.join({int(f.roots[0]), bounds}, duplicate).address;
+      f.roots[1] = f.roots[0];
+      f.times.assign(f.indices.size(), make_float2(0, 1));
+      f.times[0] = make_float2(0, 0.5f);
+      f.times[ref] = make_float2(0.5f, 1);
+    }
+    for (const float time : {0.0f, 0.25f, 0.5f, 0.75f, 1.0f}) {
+      compare("deformation_at_time", f, zero_float3(), 0, 10, 2 + 4 * time, true, time);
+      compare("deformation_bounded",
+              f,
+              zero_float3(),
+              0,
+              3,
+              std::min(3.0f, 2 + 4 * time),
+              time <= 0.25f,
+              time);
+    }
+  }
+}
