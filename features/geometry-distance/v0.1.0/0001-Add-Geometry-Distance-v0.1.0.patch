+static void check_production_updates(BuiltScene &b)
+{
+  auto verify = [&](const char *label) {
+    b.publish();
+    ASSERT_FALSE(::testing::Test::HasFatalFailure());
+    std::printf("production_update=%s\n", label);
+    check_production_queries(b);
+    ASSERT_FALSE(::testing::Test::HasFatalFailure());
+  };
+  auto update_points = [&](std::vector<float4> points, bool topology, const char *label) {
+    PointCloud *cloud = b.pointclouds[1];
+    if (topology)
+      cloud->resize(int(points.size()));
+    for (int i = 0; i < int(points.size()); i++) {
+      cloud->get_position_for_write()[i] = make_float3(points[i]);
+      cloud->get_radius_for_write()[i] = points[i].w;
+      cloud->get_shader()[i] = 0;
+    }
+    cloud->tag_position_modified();
+    cloud->tag_radius_modified();
+    cloud->tag_update(b.scene.get(), topology);
+    b.source.point_keys[1][0] = points;
+    verify(label);
+  };
+  update_points({make_float4(0.3f, 0, 2, 0.25f)}, false, "point_center");
+  update_points({make_float4(0.3f, 0, 2, 0.4f)}, false, "point_radius");
+  update_points({make_float4(0.3f, 0, 2, 0.4f), make_float4(1, 0, 1, 0.2f)}, true, "point_add");
+  update_points({make_float4(0.3f, 0, 2, 0.4f)}, true, "point_remove");
+  for (int i = 0; i < 3; i++) {
+    b.meshes[0]->get_position_for_write()[i].z -= 0.2f;
+    b.source.meshes[0][0][i].z -= 0.2f;
+  }
+  b.meshes[0]->tag_position_modified();
+  b.meshes[0]->tag_update(b.scene.get(), false);
+  verify("mesh_vertex");
+  for (int mode = 0; mode < 6; mode++) {
+    Transform tfm = translation(0.2f, 0, 0.1f);
+    const char *labels[] = {
+        "translation", "rotation", "uniform_scale", "reflection", "nonuniform_scale", "shear"};
+    if (mode == 1) {
+      tfm.x.x = 0;
+      tfm.x.y = -1;
+      tfm.y.x = 1;
+      tfm.y.y = 0;
+    }
+    if (mode == 2)
+      tfm.x.x = tfm.y.y = tfm.z.z = 2;
+    if (mode == 3)
+      tfm.x.x = -1;
+    if (mode == 4) {
+      tfm.x.x = 2;
+      tfm.y.y = 0.5f;
+    }
+    if (mode == 5)
+      tfm.x.y = 0.75f;
+    b.scene->objects[1]->set_tfm(tfm);
+    b.scene->objects[1]->tag_update(b.scene.get());
+    b.source.objects[1].tfm = tfm;
+    verify(labels[mode]);
+  }
+}
