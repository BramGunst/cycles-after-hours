+TEST(geometry_distance_scene, point_motion_temporal_bounds)
+{
+  BuiltScene b;
+  b.scene->params.num_bvh_time_steps = 1;
+  b.scene->integrator->set_motion_blur(true);
+  PointCloud *points = b.scene->create_node<PointCloud>();
+  points->resize(16);
+  points->set_motion_steps(5);
+  points->set_use_motion_blur(true);
+  for (int i = 0; i < 16; i++) {
+    points->get_position_for_write()[i] = make_float3(0, float(i) * 4, 0);
+    points->get_radius_for_write()[i] = 0.25f;
+    points->get_shader()[i] = 0;
+  }
+  Attribute *position = points->attributes.find(ATTR_STD_POSITION);
+  Attribute *radius = points->attributes.find(ATTR_STD_RADIUS);
+  position->add_motion(points);
+  radius->add_motion(points);
+  /* Five chronological keys: x = 0, 20, 0, 20, 0; center key is stored first. */
+  for (int step = 1; step < 5; step++) {
+    const float x = (step == 2 || step == 3) ? 20.0f : 0.0f;
+    for (int i = 0; i < 16; i++) {
+      position->data_for_write<packed_float3>(step)[i] = make_float3(x, float(i) * 4, 0);
+      radius->data_for_write<float>(step)[i] = 0.25f;
+    }
+  }
+  for (int instance = 0; instance < 2; instance++) {
+    Object *object = b.scene->create_node<Object>();
+    object->set_geometry(points);
+    object->set_tfm(translation(0, 0, float(instance) * 100));
+    object->tag_update(b.scene.get());
+  }
+  points->tag_update(b.scene.get(), true);
+  b.publish();
+  ASSERT_FALSE(HasFatalFailure());
+  ASSERT_NE(points->bvh, nullptr);
+  const PackedBVH &pack = static_cast<BVH2 *>(points->bvh.get())->pack;
+  ASSERT_GE(pack.root_index, 0);
+  ASSERT_GT(pack.nodes.size(), 0);
+  ASSERT_EQ(pack.prim_time.size(), pack.prim_index.size());
+  int active = 0;
+  for (size_t i = 0; i < pack.prim_time.size(); i++) {
+    active += pack.prim_time[i].x <= 0.25f && pack.prim_time[i].y >= 0.25f;
+  }
+  ASSERT_EQ(active, 16);
+  const int4 x = pack.nodes[pack.root_index + 1];
+  const float upper = std::max(__int_as_float(x.z), __int_as_float(x.w));
+  const float4 at_time = points->get_point(0).motion_key(
+      points->get_radius(), position, radius, 5, 0.25f, 0);
+  EXPECT_FLOAT_EQ(at_time.x, 20);
+  EXPECT_FLOAT_EQ(at_time.w, 0.25f);
+  DeviceScene &published = b.scene->dscene;
+  const KernelObject &object = published.objects[0];
+  ASSERT_EQ(object.num_geom_steps, 5);
+  ASSERT_EQ(object.numverts, 16);
+  EXPECT_EQ(published.object_flag[0] & SD_OBJECT_MOTION, 0);
+  EXPECT_EQ(published.object_node[0], published.object_node[1]);
+  const float4 packed_key = published.points[object.position_offset + 2 * object.numverts];
+  EXPECT_FLOAT_EQ(packed_key.x, 20);
+  EXPECT_FLOAT_EQ(packed_key.w, 0.25f);
+  const int root = published.object_node[0];
+  ASSERT_GE(root, 0);
+  const int4 packed_x = published.bvh_nodes[root + 1];
+  const float packed_upper = std::max(__int_as_float(packed_x.z), __int_as_float(packed_x.w));
+  EXPECT_FLOAT_EQ(packed_upper, upper);
+  std::printf(
+      "point_temporal_bounds keys=5 bvh_steps=1 active_refs=%d "
+      "root_child_max_x=%.9g center_x=%.9g radius=%.9g\n",
+      active,
+      upper,
+      at_time.x,
+      at_time.w);
+  /* Every primitive is under one of these children; their union must enclose it. */
+  EXPECT_GE(upper, at_time.x + at_time.w);
+
+  auto *globals = b.device->acquire_cpu_kernel_thread_globals();
+  ASSERT_NE(globals, nullptr);
+  ASSERT_FALSE(globals->empty());
+  for (int instance = 0; instance < 2; instance++) {
+    Ray ray = {};
+    ray.P = make_float3(20, 0, float(instance) * 100 - 2);
+    ray.D = make_float3(0, 0, 1);
+    ray.tmin = 0;
+    ray.tmax = 4;
+    ray.time = 0.25f;
+    ray.self.object = OBJECT_NONE;
+    ray.self.prim = PRIM_NONE;
+    ray.self.light_object = OBJECT_NONE;
+    ray.self.light_prim = PRIM_NONE;
+    Intersection hit = {};
+    EXPECT_TRUE(scene_intersect(&(*globals)[0], &ray, PATH_RAY_VISIBILITY_CAMERA, &hit));
+    EXPECT_EQ(hit.object, instance);
+    EXPECT_EQ(hit.prim, points->prim_offset);
+    EXPECT_FLOAT_EQ(hit.t, 1.75f);
+  }
+  b.device->release_cpu_kernel_thread_globals();
+}
+/* Source keys are chronological and independent of native attribute packing. */
+using PointKeys = std::vector<std::array<float, 4>>;
+
+std::array<float, 4> point_bound_sample(const PointKeys &keys, const float time)
+{
+  const float scaled = time * float(keys.size() - 1);
+  const int segment = std::min(int(scaled), int(keys.size()) - 2);
+  const float weight = scaled - float(segment);
+  const auto &a = keys[segment];
+  const auto &b = keys[segment + 1];
+  /* Use the renderer's vector arithmetic, without its key lookup or motion helper. */
+  const float4 value = (1.0f - weight) * make_float4(a[0], a[1], a[2], a[3]) +
+                       weight * make_float4(b[0], b[1], b[2], b[3]);
+  return {value.x, value.y, value.z, value.w};
+}
+
+void check_point_bounds(const int key_count, const int bvh_steps, const int motion_kind)
+{
+  SCOPED_TRACE(::testing::Message()
+               << "keys=" << key_count << " bvh_steps=" << bvh_steps << " motion=" << motion_kind);
+  BuiltScene b;
+  b.scene->params.num_bvh_time_steps = bvh_steps;
+  b.scene->params.use_bvh_spatial_split = true;
+  const bool moving = motion_kind != 0;
+  b.scene->integrator->set_motion_blur(moving);
+  PointCloud *points = b.scene->create_node<PointCloud>();
+  points->resize(16);
+  points->set_motion_steps(key_count);
+  points->set_use_motion_blur(moving);
+  Attribute *position = points->attributes.find(ATTR_STD_POSITION);
+  Attribute *radius = points->attributes.find(ATTR_STD_RADIUS);
+  if (moving) {
+    position->add_motion(points);
+    radius->add_motion(points);
+  }
+  std::vector<PointKeys> source(16);
+  for (int p = 0; p < 16; p++) {
+    points->get_shader()[p] = 0;
+    for (int k = 0; k < key_count; k++) {
+      const float peak = float(k % 2);
+      const bool move_center = motion_kind == 1 || motion_kind == 3;
+      const bool move_radius = motion_kind == 2 || motion_kind == 3;
+      source[p].push_back({move_center ? 20 * peak : 0,
+                           float(p) * 16 + (move_center ? -8 * peak : 0),
+                           move_center ? 4 * peak : 0,
+                           move_radius ? (peak ? 5.0f : 0.1f) : 0.25f});
+      if (moving || k == key_count / 2) {
+        const int slot = !moving || k == key_count / 2 ? 0 : k < key_count / 2 ? k + 1 : k;
+        const auto &v = source[p].back();
+        position->data_for_write<packed_float3>(slot)[p] = make_float3(v[0], v[1], v[2]);
+        radius->data_for_write<float>(slot)[p] = v[3];
+      }
+    }
+  }
+  if (moving) {
+    finalize_pointcloud_motion(points, key_count == 5 ? 1 : 0, true, true);
+    ASSERT_TRUE(position->has_motion());
+    ASSERT_TRUE(radius->has_motion());
+  }
+  for (int instance = 0; instance < 2; instance++) {
+    Object *object = b.scene->create_node<Object>();
+    object->set_geometry(points);
+    object->set_tfm(translation(0, 0, float(instance) * 100));
+    object->tag_update(b.scene.get());
+  }
+  points->tag_update(b.scene.get(), true);
+  b.publish();
+  ASSERT_FALSE(::testing::Test::HasFatalFailure());
+  DeviceScene &d = b.scene->dscene;
+  ASSERT_EQ(d.object_node[0], d.object_node[1]);
+  ASSERT_GE(d.object_node[0], 0);
+  EXPECT_EQ(d.points.size(), size_t(16 * (moving ? key_count : 1)));
+  EXPECT_EQ(d.objects[0].position_offset, d.objects[1].position_offset);
+  EXPECT_FLOAT_EQ(d.objects[1].tfm.z.w, 100);
+  EXPECT_EQ(d.object_flag[0] & SD_OBJECT_MOTION, 0);
+  for (int p = 0; p < 16; p++) {
+    for (int k = 0; k < key_count; k++) {
+      const int slot = !moving || k == key_count / 2 ? 0 : k < key_count / 2 ? k + 1 : k;
+      const float4 packed = d.points[d.objects[0].position_offset + slot * 16 + p];
+      for (int axis = 0; axis < 4; axis++) {
+        EXPECT_FLOAT_EQ(packed[axis], source[p][k][axis]);
+      }
+    }
+  }
+  const int intervals = moving && bvh_steps ? 2 * bvh_steps : 1;
+  std::vector<std::vector<float2>> ranges(16);
+  struct Work {
+    int node;
+    Bounds bounds;
+  };
+  std::vector<Work> stack;
+  Bounds infinite;
+  infinite.lo = make_float3(-FLT_MAX, -FLT_MAX, -FLT_MAX);
+  infinite.hi = make_float3(FLT_MAX, FLT_MAX, FLT_MAX);
+  stack.push_back({d.object_node[0], infinite});
+  int references = 0;
+  float total_width = 0;
+  while (!stack.empty()) {
+    const Work work = stack.back();
+    stack.pop_back();
+    if (work.node >= 0) {
+      const int4 header = d.bvh_nodes[work.node];
+      for (int child = 0; child < 2; child++) {
+        Bounds bounds;
+        for (int axis = 0; axis < 3; axis++) {
+          const int4 packed = d.bvh_nodes[work.node + 1 + axis];
+          bounds.lo[axis] = std::max(work.bounds.lo[axis],
+                                     __int_as_float(child ? packed.y : packed.x));
+          bounds.hi[axis] = std::min(work.bounds.hi[axis],
+                                     __int_as_float(child ? packed.w : packed.z));
+        }
+        stack.push_back({child ? header.w : header.z, bounds});
+      }
+      continue;
+    }
+    const int4 leaf = d.bvh_leaf_nodes[~work.node];
+    ASSERT_GE(leaf.x, 0);
+    for (int ref = leaf.x; ref < leaf.y; ref++) {
+      const int p = d.prim_index[ref] - points->prim_offset;
+      ASSERT_GE(p, 0);
+      ASSERT_LT(p, 16);
+      const float2 range = moving && bvh_steps ? d.prim_time[ref] : make_float2(0, 1);
+      ranges[p].push_back(range);
+      references++;
+      total_width += work.bounds.hi.x - work.bounds.lo.x;
+      std::vector<float> times = {range.x, range.y};
+      for (int k = 0; k < key_count; k++) {
+        const float t = float(k) / float(key_count - 1);
+        if (t > range.x && t < range.y) {
+          times.push_back(t);
+        }
+      }
+      std::sort(times.begin(), times.end());
+      const size_t endpoints = times.size();
+      for (size_t k = 1; k < endpoints; k++) {
+        for (const float fraction : {0.25f, 0.5f, 0.75f}) {
+          times.push_back(times[k - 1] + (times[k] - times[k - 1]) * fraction);
+        }
+      }
+      for (const float time : times) {
+        const auto value = point_bound_sample(source[p], time);
+        const float4 native = moving ?
+                                  points->get_point(p).motion_key(
+                                      points->get_radius(), position, radius, key_count, time, p) :
+                                  make_float4(points->get_position()[p], points->get_radius()[p]);
+        for (int axis = 0; axis < 3; axis++) {
+          EXPECT_LE(work.bounds.lo[axis], native[axis] - native.w);
+          EXPECT_GE(work.bounds.hi[axis], native[axis] + native.w);
+          EXPECT_LE(work.bounds.lo[axis], value[axis] - value[3])
+              << "time=" << time << " interval=" << range.x << "," << range.y << " axis=" << axis
+              << " native=" << native[axis] - native.w;
+          EXPECT_GE(work.bounds.hi[axis], value[axis] + value[3])
+              << "time=" << time << " interval=" << range.x << "," << range.y << " axis=" << axis
+              << " native=" << native[axis] + native.w;
+        }
+      }
+    }
+  }
+  EXPECT_EQ(references, 16 * intervals);
+  for (auto &point_ranges : ranges) {
+    ASSERT_EQ(point_ranges.size(), size_t(intervals));
+    std::sort(point_ranges.begin(), point_ranges.end(), [](const float2 a, const float2 b) {
+      return a.x < b.x;
+    });
+    EXPECT_FLOAT_EQ(point_ranges.front().x, 0);
+    EXPECT_FLOAT_EQ(point_ranges.back().y, 1);
+    for (size_t i = 1; i < point_ranges.size(); i++) {
+      EXPECT_FLOAT_EQ(point_ranges[i - 1].y, point_ranges[i].x);
+    }
+  }
+  std::printf("point_bounds keys=%d steps=%d motion=%d refs=%d mean_x_width=%.9g\n",
+              key_count,
+              bvh_steps,
+              motion_kind,
+              references,
+              total_width / references);
+}
+
+TEST(geometry_distance_scene, point_bounds_matrix)
+{
+  for (const int keys : {3, 5, 7}) {
+    for (const int steps : {0, 1, 2, 3, 4}) {
+      for (const int motion : {1, 2, 3}) {
+        check_point_bounds(keys, steps, motion);
+      }
+    }
+  }
+}
+
+TEST(geometry_distance_scene, static_point_bounds)
+{
+  for (const int steps : {0, 1, 2, 3, 4}) {
+    check_point_bounds(3, steps, 0);
+  }
+}
+
+TEST(geometry_distance_scene, point_motion_sync_retention)
+{
+  for (const int kind : {0, 1, 2, 3}) {
+    SCOPED_TRACE(kind);
+    PointCloud points;
+    points.resize(1);
+    points.set_motion_steps(5);
+    points.get_position_for_write()[0] = make_float3(1, 2, 3);
+    points.get_radius_for_write()[0] = 0.1f;
+    Attribute *position = points.attributes.find(ATTR_STD_POSITION);
+    Attribute *radius = points.attributes.find(ATTR_STD_RADIUS);
+    position->add_motion(&points);
+    radius->add_motion(&points);
+    /* Detect motion after an earlier unchanged sample was discarded. */
+    position->data_for_write<packed_float3>(2)[0] = make_float3(kind == 1 ? 20 : 1, 2, 3);
+    radius->data_for_write<float>(2)[0] = kind == 2 ? 5.0f : 0.1f;
+    finalize_pointcloud_motion(&points, 1, kind != 3, true);
+    const bool expected = kind == 1 || kind == 2;
+    EXPECT_EQ(position->has_motion(), expected);
+    EXPECT_EQ(radius->has_motion(), expected);
+    if (expected && position->has_motion() && radius->has_motion()) {
+      EXPECT_FLOAT_EQ(position->data<packed_float3>(1)[0].x, 1);
+      EXPECT_FLOAT_EQ(radius->data<float>(1)[0], 0.1f);
+      EXPECT_FLOAT_EQ(radius->data<float>(2)[0], kind == 2 ? 5.0f : 0.1f);
+      points.copy_center_to_motion_step(2);
+      finalize_pointcloud_motion(&points, 2, true, false);
+      EXPECT_TRUE(position->has_motion());
+      EXPECT_TRUE(radius->has_motion());
+    }
+  }
+}
+#endif
+
