+TEST(geometry_distance_scene, companion_production_matrix)
+{
+#  ifndef WITH_OPTIX
+  GTEST_SKIP();
+#  else
+  const char *runtime = std::getenv("GEOMETRY_DISTANCE_RUNTIME_DIR");
+  if (!runtime || !std::getenv("GEOMETRY_DISTANCE_PRODUCTION_PTX"))
+    GTEST_SKIP();
+  path_init(runtime, runtime);
+  const auto devices = Device::available_devices(DEVICE_MASK_OPTIX);
+  ASSERT_FALSE(devices.empty());
+  for (int mode = 0; mode < 7; mode++) {
+    SCOPED_TRACE(mode);
+    BuiltScene b(&devices.front());
+    if (mode == 0)
+      b.object(b.mesh(plane()), transform_identity());
+    else {
+      if (mode >= 3)
+        b.object(b.cloud({{make_float4(8, 0, 0, 0.1f)}}), transform_identity());
+      std::vector<float4> points;
+      for (int i = 0; i < (mode == 2 ? 512 : 3); i++) {
+        points.push_back(make_float4(float(i) * 0.5f, 0, 1, i == 1 ? 0 : 0.2f));
+      }
+      std::vector<std::vector<float4>> keys(mode >= 3 ? 5 : 1, points);
+      for (int k = 0; k < int(keys.size()); k++) {
+        for (auto &point : keys[k]) {
+          if (mode == 3 || mode == 5 || mode == 6)
+            point.x += float(k % 2) * 0.3f;
+          if (mode == 4 || mode == 5 || mode == 6)
+            point.w += float(k % 2) * 0.1f;
+        }
+      }
+      const int cloud = b.cloud(keys);
+      b.object(cloud, transform_identity());
+      if (mode == 6) {
+        Transform affine = translation(0, 0, 3);
+        affine.x.x = -2;
+        affine.y.y = 0.5f;
+        affine.x.y = 0.75f;
+        b.object(cloud, affine);
+      }
+    }
+    request_geometry_distance(b, true);
+    b.publish();
+    ASSERT_FALSE(HasFatalFailure());
+    std::printf("production_scene_mode=%d host_estimate=%zu\n",
+                mode,
+                b.scene->geometry_manager->geometry_distance_host_bytes());
+    check_production_queries(b);
+    ASSERT_FALSE(HasFatalFailure());
+    if (mode >= 3) {
+      PointCloud *cloud = b.pointclouds[1];
+      Attribute *position = cloud->attributes.find(ATTR_STD_POSITION);
+      Attribute *radius = cloud->attributes.find(ATTR_STD_RADIUS);
+      for (int k = 0; k < 5; k++) {
+        const int slot = k == 2 ? 0 : k < 2 ? k + 1 : k;
+        for (int i = 0; i < 3; i++) {
+          float4 &point = b.source.point_keys[1][k][i];
+          if (mode != 4)
+            point.z += 0.2f * float(k % 2);
+          if (mode != 3)
+            point.w += 0.03f;
+          position->data_for_write<packed_float3>(slot)[i] = make_float3(point);
+          radius->data_for_write<float>(slot)[i] = point.w;
+        }
+      }
+      cloud->tag_position_modified();
+      cloud->tag_radius_modified();
+      cloud->tag_update(b.scene.get(), false);
+      b.publish();
+      ASSERT_FALSE(HasFatalFailure());
+      std::printf("production_motion_update=%d\n", mode);
+      check_production_queries(b);
+      ASSERT_FALSE(HasFatalFailure());
+    }
+    if (mode == 3) {
+      for (int count : {2, 1}) {
+        PointCloud *first = b.pointclouds[0];
+        first->resize(count);
+        std::vector<float4> points;
+        for (int i = 0; i < count; i++) {
+          points.push_back(make_float4(8 + float(i), 0, 0, 0.1f));
+          first->get_position_for_write()[i] = make_float3(points.back());
+          first->get_radius_for_write()[i] = points.back().w;
+          first->get_shader()[i] = 0;
+        }
+        first->tag_position_modified();
+        first->tag_radius_modified();
+        first->tag_update(b.scene.get(), true);
+        b.source.point_keys[0][0] = points;
+        b.source.primitive_base[1] = count;
+        b.publish();
+        ASSERT_FALSE(HasFatalFailure());
+        EXPECT_EQ(b.pointclouds[1]->prim_offset, count);
+        std::printf("production_offset_update=%d\n", count);
+        check_production_queries(b);
+        ASSERT_FALSE(HasFatalFailure());
+      }
+    }
+    if (mode == 6) {
+      b.object(1, translation(0.5f, 0, -1));
+      b.publish();
+      ASSERT_FALSE(HasFatalFailure());
+      std::printf("production_instance=add\n");
+      check_production_queries(b);
+      ASSERT_FALSE(HasFatalFailure());
+      b.scene->delete_node(b.scene->objects.back());
+      b.source.objects.pop_back();
+      b.source.object_mesh.pop_back();
+      b.source.flags.pop_back();
+      b.publish();
+      ASSERT_FALSE(HasFatalFailure());
+      std::printf("production_instance=remove\n");
+      check_production_queries(b);
+      ASSERT_FALSE(HasFatalFailure());
+    }
+    if (mode == 0) {
+      Mesh *mesh = b.meshes[0];
+      mesh->resize_mesh(6, 2);
+      const auto triangles = plane();
+      b.source.meshes[0] = {triangles[0], triangles[0]};
+      for (int i = 0; i < 6; i++) {
+        auto v = triangles[0][i % 3];
+        if (i >= 3)
+          v.z += 2;
+        mesh->get_position_for_write()[i] = v;
+        mesh->get_triangles()[i] = i;
+        b.source.meshes[0][i / 3][i % 3] = v;
+      }
+      for (int i = 0; i < 2; i++) {
+        mesh->get_shader()[i] = 0;
+        mesh->get_smooth()[i] = false;
+      }
+      mesh->tag_position_modified();
+      mesh->tag_update(b.scene.get(), true);
+      b.publish();
+      ASSERT_FALSE(HasFatalFailure());
+      std::printf("production_update=mesh_topology\n");
+      check_production_queries(b);
+      ASSERT_FALSE(HasFatalFailure());
+    }
+  }
+#  endif
