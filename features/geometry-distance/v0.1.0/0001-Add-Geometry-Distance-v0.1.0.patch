+#  ifdef WITH_OPTIX
+struct ProductionOptixQuery {
+  OptixModule module = nullptr;
+  OptixProgramGroup raygen = nullptr;
+  OptixPipeline pipeline = nullptr;
+  CUdeviceptr record = 0, params = 0, output = 0;
+  ~ProductionOptixQuery()
+  {
+    if (pipeline)
+      optixPipelineDestroy(pipeline);
+    if (raygen)
+      optixProgramGroupDestroy(raygen);
+    if (module)
+      optixModuleDestroy(module);
+    if (record)
+      cuMemFree(record);
+    if (params)
+      cuMemFree(params);
+    if (output)
+      cuMemFree(output);
+  }
+};
