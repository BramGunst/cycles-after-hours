+
+struct GeometryManager::GeometryDistanceCache {
+  /* Keep the temporary BLAS objects alive for the lifetime of their BVHs. */
+  vector<unique_ptr<Object>> build_objects;
+  map<Geometry *, unique_ptr<BVH2>> blas;
+  unique_ptr<BVH2> top;
+};
+
+GeometryManager::GeometryManager()
+{
+  update_flags = UPDATE_ALL;
+  need_flags_update = true;
+}
+
+GeometryManager::~GeometryManager() = default;
+
+bool GeometryManager::geometry_distance_has_cache() const
+{
+  return geometry_distance_cache != nullptr;
+}
+
+size_t GeometryManager::geometry_distance_build_count() const
+{
+  return geometry_distance_builds;
+}
+
+size_t GeometryManager::geometry_distance_host_bytes() const
+{
+  if (!geometry_distance_cache) {
+    return 0;
+  }
+  size_t bytes = sizeof(GeometryDistanceCache);
+  for (const auto &entry : geometry_distance_cache->blas) {
+    const PackedBVH &p = entry.second->pack;
+    bytes += sizeof(BVH2) + sizeof(Object) + p.nodes.size() * sizeof(int4) +
+             p.leaf_nodes.size() * sizeof(int4) + p.object_node.size() * sizeof(int) +
+             p.prim_type.size() * sizeof(int) + p.prim_index.size() * sizeof(int) +
+             p.prim_object.size() * sizeof(int) + p.prim_visibility.size() * sizeof(uint) +
+             p.prim_time.size() * sizeof(float2);
+  }
+  return bytes + sizeof(BVH2);
+}
+
+void GeometryManager::geometry_distance_free(DeviceScene *dscene)
+{
+  dscene->data.geometry_distance = {};
+  if (geometry_distance_cache) {
+    update_flags |= GEOMETRY_DISTANCE_MODIFIED;
+    dscene->geometry_distance_nodes.device->const_copy_to(
+        "data", &dscene->data, sizeof(dscene->data));
+  }
+  geometry_distance_cache.reset();
+  dscene->geometry_distance_nodes.free();
+  dscene->geometry_distance_leaf_nodes.free();
+  dscene->geometry_distance_object_node.free();
+  dscene->geometry_distance_prim_type.free();
+  dscene->geometry_distance_prim_index.free();
+  dscene->geometry_distance_prim_object.free();
+  dscene->geometry_distance_prim_time.free();
+}
+
+void GeometryManager::device_update_geometry_distance(Device *device,
+                                                      DeviceScene *dscene,
+                                                      Scene *scene,
+                                                      Progress &progress)
+{
+  dscene->data.geometry_distance.valid = 0;
+  auto next = make_unique<GeometryDistanceCache>();
+  BVHParams params;
+  params.use_geometry_distance = true;
+  params.bvh_layout = BVH_LAYOUT_BVH2;
+  params.use_unaligned_nodes = false;
+  params.use_spatial_split = scene->params.use_bvh_spatial_split;
+  params.bvh_type = scene->params.bvh_type;
+  params.num_motion_triangle_steps = scene->params.num_bvh_time_steps;
+  params.num_motion_curve_steps = scene->params.num_bvh_time_steps;
+  params.num_motion_point_steps = scene->params.num_bvh_time_steps;
+  params.curve_subdivisions = scene->params.curve_subdivisions();
+  progress.set_status("Updating Geometry Distance", "Building companion BVH");
+  for (Geometry *geometry : scene->geometry) {
+    if (progress.get_cancel() || device->have_error()) {
+      return;
+    }
+    if (!geometry->need_build_bvh(BVH_LAYOUT_BVH2)) {
+      continue;
+    }
+    auto object = make_unique<Object>();
+    object->set_geometry(geometry);
+    object->set_visibility(PATH_RAY_VISIBILITY_ALL);
+    object->set_is_shadow_catcher(true);
+    vector<Geometry *> geometries = {geometry};
+    vector<Object *> objects = {object.get()};
+    auto blas = make_unique<BVH2>(params, geometries, objects);
+    blas->build(progress, nullptr);
+    next->build_objects.push_back(std::move(object));
+    next->blas.emplace(geometry, std::move(blas));
+  }
+  if (progress.get_cancel() || device->have_error()) {
+    return;
+  }
+  params.top_level = true;
+  GeometryDistanceCache *cache = next.get();
+  next->top = make_unique<BVH2>(
+      params, scene->geometry, scene->objects, [cache](Geometry *geometry) {
+        return cache->blas.at(geometry).get();
+      });
+  next->top->build(progress, nullptr);
+  if (progress.get_cancel() || device->have_error()) {
+    return;
+  }
+  PackedBVH &pack = next->top->pack;
+  const KernelGeometryDistance data = {
+      pack.root_index, int(pack.prim_index.size()), int(scene->objects.size()), 1};
+  /* Rendering is stopped during scene updates. Keep validity clear until every
+   * vector is uploaded, and let normal final Scene constant upload publish the root. */
+  dscene->geometry_distance_nodes.steal_data(pack.nodes);
+  dscene->geometry_distance_nodes.copy_to_device();
+  dscene->geometry_distance_leaf_nodes.steal_data(pack.leaf_nodes);
+  dscene->geometry_distance_leaf_nodes.copy_to_device();
+  dscene->geometry_distance_object_node.steal_data(pack.object_node);
+  dscene->geometry_distance_object_node.copy_to_device();
+  dscene->geometry_distance_prim_type.steal_data(pack.prim_type);
+  dscene->geometry_distance_prim_type.copy_to_device();
+  dscene->geometry_distance_prim_index.steal_data(pack.prim_index);
+  dscene->geometry_distance_prim_index.copy_to_device();
+  dscene->geometry_distance_prim_object.steal_data(pack.prim_object);
+  dscene->geometry_distance_prim_object.copy_to_device();
+  dscene->geometry_distance_prim_time.steal_data(pack.prim_time);
+  dscene->geometry_distance_prim_time.copy_to_device();
+  if (progress.get_cancel() || device->have_error()) {
+    geometry_distance_free(dscene);
+    return;
+  }
+  geometry_distance_cache = std::move(next);
+  dscene->data.geometry_distance = data;
+  geometry_distance_builds++;
+}
 
