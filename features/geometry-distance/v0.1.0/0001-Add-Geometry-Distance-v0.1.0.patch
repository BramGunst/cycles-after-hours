new file mode 100644
--- /dev/null
+++ b/intern/cycles/test/geometry_distance_optix.cpp
@@ -0,0 +1,447 @@
+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+/* Opt-in standalone runtime validation of a published BVH2 companion. */
+#define NOMINMAX
+#include <cuda.h>
+#include <cuda_runtime.h>
+#include <fstream>
+#include <iostream>
+#include <map>
+#include <optix_function_table_definition.h>
+#include <optix_stubs.h>
+#include <stdexcept>
+#include <string>
+#include <tuple>
+#include <vector>
+
+#include "test/geometry_distance_optix_launch.h"
+
+CCL_NAMESPACE_BEGIN
+
+static void check(const int result, const char *operation)
+{
+  if (result != 0) {
+    throw std::runtime_error(std::string(operation) + ": " + std::to_string(result));
+  }
+}
+#define CHECK(call) check(int(call), #call)
+
+struct Memory {
+  std::vector<std::pair<void *, size_t>> allocations;
+  size_t live = 0, peak = 0;
+  void *allocate(const size_t size)
+  {
+    if (!size) {
+      return nullptr;
+    }
+    void *pointer = nullptr;
+    CHECK(cudaMalloc(&pointer, size));
+    allocations.emplace_back(pointer, size);
+    live += size;
+    peak = std::max(peak, live);
+    return pointer;
+  }
+  template<typename T> T *upload(const std::vector<T> &values)
+  {
+    T *pointer = static_cast<T *>(allocate(values.size() * sizeof(T)));
+    if (pointer) {
+      CHECK(cudaMemcpy(pointer, values.data(), values.size() * sizeof(T), cudaMemcpyHostToDevice));
+    }
+    return pointer;
+  }
+  void release(void *pointer)
+  {
+    for (auto &allocation : allocations) {
+      if (allocation.first == pointer) {
+        CHECK(cudaFree(pointer));
+        live -= allocation.second;
+        allocation.first = nullptr;
+        return;
+      }
+    }
+  }
+  ~Memory()
+  {
+    for (auto allocation : allocations) {
+      if (allocation.first) {
+        cudaFree(allocation.first);
+      }
+    }
+  }
+};
+
+template<typename T> std::vector<T> read(std::ifstream &file, size_t count)
+{
+  std::vector<T> values(count);
+  if (count) {
+    file.read(reinterpret_cast<char *>(values.data()), count * sizeof(T));
+  }
+  if (!file.good()) {
+    throw std::runtime_error("Incomplete snapshot");
+  }
+  return values;
+}
+
+struct alignas(OPTIX_SBT_RECORD_ALIGNMENT) Record {
+  char header[OPTIX_SBT_RECORD_HEADER_SIZE];
+};
+
+static void run(const char *snapshot,
+                OptixDeviceContext context,
+                OptixPipeline pipeline,
+                const std::vector<OptixProgramGroup> &groups)
+{
+  std::ifstream file(snapshot, std::ios::binary);
+  const auto header = read<GeometryDistanceSnapshotHeader>(file, 1)[0];
+  if (header.magic != 0x47445031 || header.object_size != sizeof(KernelObject) ||
+      header.result_size != sizeof(GeometryDistanceResult))
+  {
+    throw std::runtime_error("Snapshot ABI mismatch");
+  }
+  const auto *count = header.counts;
+  const auto nodes = read<float4>(file, count[0]);
+  const auto leaves = read<float4>(file, count[1]);
+  const auto roots = read<uint>(file, count[2]);
+  const auto objects = read<KernelObject>(file, count[2]);
+  const auto flags = read<uint>(file, count[2]);
+  const auto bases = read<uint>(file, count[2]);
+  const auto types = read<uint>(file, count[3]);
+  const auto indices = read<uint>(file, count[3]);
+  const auto owners = read<uint>(file, count[3]);
+  const auto triangles = read<packed_uint3>(file, count[4]);
+  const auto vertices = read<packed_float3>(file, count[5]);
+  const auto points = read<float4>(file, count[6]);
+  const auto times = read<float2>(file, count[7]);
+  const auto queries = read<GeometryDistanceSnapshotQuery>(file, header.queries);
+  Memory memory;
+  GeometryDistanceBVH view = {};
+  view.nodes = memory.upload(nodes);
+  view.leaf_nodes = memory.upload(leaves);
+  view.object_node = memory.upload(roots);
+  view.objects = memory.upload(objects);
+  view.object_flag = memory.upload(flags);
+  view.prim_type = memory.upload(types);
+  view.prim_index = memory.upload(indices);
+  view.prim_object = memory.upload(owners);
+  view.tri_vindex = memory.upload(triangles);
+  view.tri_verts = memory.upload(vertices);
+  view.points = memory.upload(points);
+  view.prim_time = memory.upload(times);
+  view.root = header.root;
+  view.num_objects = count[2];
+  view.num_references = count[3];
+  size_t native_bytes = 0;
+  auto build = [&](OptixBuildInput &input, const int steps = 1) {
+    OptixAccelBuildOptions options = {};
+    options.operation = OPTIX_BUILD_OPERATION_BUILD;
+    options.motionOptions.numKeys = steps > 1 ? steps : 0;
+    options.motionOptions.timeBegin = 0;
+    options.motionOptions.timeEnd = 1;
+    OptixAccelBufferSizes sizes;
+    CHECK(optixAccelComputeMemoryUsage(context, &options, &input, 1, &sizes));
+    void *scratch = memory.allocate(sizes.tempSizeInBytes);
+    void *output = memory.allocate(sizes.outputSizeInBytes);
+    native_bytes += sizes.outputSizeInBytes;
+    OptixTraversableHandle handle;
+    CHECK(optixAccelBuild(context,
+                          nullptr,
+                          &options,
+                          &input,
+                          1,
+                          CUdeviceptr(scratch),
+                          sizes.tempSizeInBytes,
+                          CUdeviceptr(output),
+                          sizes.outputSizeInBytes,
+                          &handle,
+                          nullptr,
+                          0));
+    CHECK(cudaDeviceSynchronize());
+    memory.release(scratch);
+    return handle;
+  };
+  std::map<std::tuple<int, int, int>, OptixTraversableHandle> geometry;
+  std::vector<OptixInstance> instances;
+  for (size_t o = 0; o < objects.size(); o++) {
+    const auto &object = objects[o];
+    const int type = object.primitive_type & PRIMITIVE_ALL;
+    const bool point = (type & PRIMITIVE_POINT) != 0;
+    if (!point && type != PRIMITIVE_TRIANGLE) {
+      throw std::runtime_error("Unsupported native GAS primitive");
+    }
+    const auto key = std::make_tuple(type, int(bases[o]), object.position_offset);
+    OptixTraversableHandle handle;
+    auto found = geometry.find(key);
+    if (found != geometry.end()) {
+      handle = found->second;
+    }
+    else {
+      OptixBuildInput input = {};
+      unsigned int build_flags = OPTIX_GEOMETRY_FLAG_DISABLE_ANYHIT;
+      CUdeviceptr address;
+      std::vector<void *> aabbs;
+      std::vector<CUdeviceptr> addresses;
+      if (point) {
+        for (int step = 0; step < object.num_geom_steps; step++) {
+          std::vector<OptixAabb> bounds;
+          for (int p = 0; p < object.numverts; p++) {
+            const auto v = motion_point_for_step_data(points.data(),
+                                                      object.position_offset,
+                                                      object.numverts,
+                                                      object.num_geom_steps,
+                                                      step,
+                                                      bases[o] + p);
+            bounds.push_back({v.x - v.w, v.y - v.w, v.z - v.w, v.x + v.w, v.y + v.w, v.z + v.w});
+          }
+          aabbs.push_back(memory.upload(bounds));
+          addresses.push_back(CUdeviceptr(aabbs.back()));
+        }
+        input.type = OPTIX_BUILD_INPUT_TYPE_CUSTOM_PRIMITIVES;
+        auto &array = input.customPrimitiveArray;
+        array.aabbBuffers = addresses.data();
+        array.numPrimitives = object.numverts;
+        array.strideInBytes = sizeof(OptixAabb);
+        array.primitiveIndexOffset = bases[o];
+        array.numSbtRecords = 1;
+        array.flags = &build_flags;
+      }
+      else {
+        address = CUdeviceptr(view.tri_verts + object.position_offset);
+        input.type = OPTIX_BUILD_INPUT_TYPE_TRIANGLES;
+        auto &array = input.triangleArray;
+        array.vertexBuffers = &address;
+        array.numVertices = unsigned(vertices.size() - object.position_offset);
+        array.vertexFormat = OPTIX_VERTEX_FORMAT_FLOAT3;
+        array.vertexStrideInBytes = sizeof(packed_float3);
+        array.indexBuffer = CUdeviceptr(view.tri_vindex + bases[o]);
+        array.numIndexTriplets = object.numprims;
+        array.indexFormat = OPTIX_INDICES_FORMAT_UNSIGNED_INT3;
+        array.indexStrideInBytes = sizeof(packed_uint3);
+        array.primitiveIndexOffset = bases[o];
+        array.numSbtRecords = 1;
+        array.flags = &build_flags;
+      }
+      handle = build(input, object.num_geom_steps);
+      for (void *buffer : aabbs) {
+        memory.release(buffer);
+      }
+      geometry[key] = handle;
+    }
+    OptixInstance instance = {};
+    const Transform identity = {
+        make_float4(1, 0, 0, 0), make_float4(0, 1, 0, 0), make_float4(0, 0, 1, 0)};
+    const Transform tfm = flags[o] & SD_OBJECT_TRANSFORM_APPLIED ? identity : object.tfm;
+    std::memcpy(instance.transform, &tfm, sizeof(instance.transform));
+    instance.instanceId = unsigned(o);
+    instance.visibilityMask = 255;
+    instance.sbtOffset = point ? 1 : 0;
+    instance.traversableHandle = handle;
+    instances.push_back(instance);
+  }
+  OptixBuildInput ias_input = {};
+  ias_input.type = OPTIX_BUILD_INPUT_TYPE_INSTANCES;
+  auto *instance_data = memory.upload(instances);
+  ias_input.instanceArray.instances = CUdeviceptr(instance_data);
+  ias_input.instanceArray.numInstances = unsigned(instances.size());
+  const OptixTraversableHandle scene = build(ias_input);
+  memory.release(instance_data);
+  std::vector<Record> sbt_records(groups.size());
+  for (size_t i = 0; i < groups.size(); i++) {
+    CHECK(optixSbtRecordPackHeader(groups[i], &sbt_records[i]));
+  }
+  Record *records = memory.upload(sbt_records);
+  OptixShaderBindingTable sbt = {};
+  sbt.raygenRecord = CUdeviceptr(records);
+  sbt.missRecordBase = CUdeviceptr(records + 1);
+  sbt.missRecordStrideInBytes = sizeof(Record);
+  sbt.missRecordCount = 1;
+  sbt.hitgroupRecordBase = CUdeviceptr(records + 2);
+  sbt.hitgroupRecordStrideInBytes = sizeof(Record);
+  sbt.hitgroupRecordCount = 2;
+  const auto *gpu_queries = memory.upload(queries);
+  auto *gpu_output = static_cast<GeometryDistanceOptixOutput *>(
+      memory.allocate(queries.size() * sizeof(GeometryDistanceOptixOutput)));
+  const auto *gpu_view = memory.upload(std::vector<GeometryDistanceBVH>{view});
+  KernelData data = {};
+  data.kernel_features = KERNEL_FEATURE_NODE_BSDF | KERNEL_FEATURE_LIGHT_TREE |
+                         KERNEL_FEATURE_GEOMETRY_DISTANCE;
+  const auto *gpu_data = memory.upload(std::vector<KernelData>{data});
+  const GeometryDistanceOptixLaunch launch = {gpu_view, scene, gpu_queries, gpu_output, gpu_data};
+  auto *gpu_launch = memory.upload(std::vector<GeometryDistanceOptixLaunch>{launch});
+  CHECK(optixLaunch(pipeline,
+                    nullptr,
+                    CUdeviceptr(gpu_launch),
+                    sizeof(launch),
+                    &sbt,
+                    unsigned(queries.size()),
+                    1,
+                    1));
+  CHECK(cudaDeviceSynchronize());
+  std::vector<GeometryDistanceOptixOutput> results(queries.size());
+  CHECK(cudaMemcpy(
+      results.data(), gpu_output, results.size() * sizeof(results[0]), cudaMemcpyDeviceToHost));
+  int mismatch = 0, ray_mismatch = 0, repeated_ray_mismatch = 0;
+  int repeated_distance_mismatch = 0;
+  int supported_mismatch = 0, found_mismatch = 0, object_mismatch = 0;
+  int primitive_mismatch = 0, type_mismatch = 0;
+  size_t point_evaluations = 0, node_visits = 0;
+  float maximum_error = 0, maximum_relative_error = 0;
+  for (size_t i = 0; i < queries.size(); i++) {
+    if (results[i].feature_observation[0] != data.kernel_features ||
+        results[i].feature_observation[1] != sizeof(KernelData) ||
+        results[i].feature_observation[2] != offsetof(KernelData, cam) ||
+        results[i].feature_observation[3] != offsetof(KernelData, device_bvh)) {
+      throw std::runtime_error("OptiX feature mask or KernelData layout mismatch");
+    }
+    const auto &e = queries[i].expected;
+    for (int repeat = 0; repeat < 3; repeat++) {
+      const auto &a = results[i].distance[repeat];
+      const auto &first = results[i].distance[0];
+      repeated_distance_mismatch += a.supported != first.supported || a.found != first.found ||
+                                    a.distance != first.distance || a.object != first.object ||
+                                    a.primitive != first.primitive ||
+                                    a.primitive_type != first.primitive_type;
+      const float error = std::fabs(a.distance - e.distance);
+      maximum_error = std::max(maximum_error, error);
+      maximum_relative_error = std::max(maximum_relative_error,
+                                        e.distance > 0 ? error / e.distance : 0);
+      supported_mismatch += a.supported != e.supported;
+      found_mismatch += a.found != e.found;
+      object_mismatch += a.object != e.object;
+      primitive_mismatch += a.primitive != e.primitive;
+      type_mismatch += a.primitive_type != e.primitive_type;
+      point_evaluations += results[i].stats[repeat].points;
+      node_visits += results[i].stats[repeat].nodes;
+      mismatch += a.supported != e.supported || a.found != e.found || a.object != e.object ||
+                  a.primitive != e.primitive || a.primitive_type != e.primitive_type ||
+                  !std::isfinite(a.distance) || error > 2e-5f * std::max(1.0f, e.distance);
+    }
+    for (int pass = 0; pass < 4; pass++) {
+      repeated_ray_mismatch += results[i].ray_object[pass] != results[i].ray_object[0] ||
+                               results[i].ray_primitive[pass] != results[i].ray_primitive[0] ||
+                               results[i].ray_t[pass] != results[i].ray_t[0];
+      if (results[i].ray_object[pass] != queries[i].ray_object ||
+          results[i].ray_primitive[pass] != queries[i].ray_primitive ||
+          std::fabs(results[i].ray_t[pass] - queries[i].ray_t) > 2e-5f)
+      {
+        std::cout << "ray query=" << i << " pass=" << pass
+                  << " actual=" << results[i].ray_object[pass] << ','
+                  << results[i].ray_primitive[pass] << ',' << results[i].ray_t[pass]
+                  << " expected=" << queries[i].ray_object << ',' << queries[i].ray_primitive
+                  << ',' << queries[i].ray_t << '\n';
+      }
+      ray_mismatch += results[i].ray_object[pass] != queries[i].ray_object ||
+                      results[i].ray_primitive[pass] != queries[i].ray_primitive ||
+                      std::fabs(results[i].ray_t[pass] - queries[i].ray_t) > 2e-5f;
+    }
+  }
+  const size_t node_bytes = nodes.size() * sizeof(float4) + leaves.size() * sizeof(float4);
+  const size_t reference_bytes = indices.size() * 3 * sizeof(uint);
+  const size_t root_bytes = roots.size() * sizeof(uint),
+               time_bytes = times.size() * sizeof(float2);
+  std::cout << snapshot << " queries=" << queries.size() * 3 << " max_error=" << maximum_error
+            << " max_relative_error=" << maximum_relative_error
+            << " supported_mismatch=" << supported_mismatch << " found_mismatch=" << found_mismatch
+            << " object_mismatch=" << object_mismatch
+            << " primitive_mismatch=" << primitive_mismatch << " type_mismatch=" << type_mismatch
+            << " repeat_ray_mismatch=" << repeated_ray_mismatch << " node_visits=" << node_visits
+            << " repeat_distance_mismatch=" << repeated_distance_mismatch
+            << " point_evaluations=" << point_evaluations << " distance_mismatch=" << mismatch
+            << " native_ray_mismatch=" << ray_mismatch << " node_bytes=" << node_bytes
+            << " reference_bytes=" << reference_bytes << " root_bytes=" << root_bytes
+            << " time_bytes=" << time_bytes
+            << " companion_bytes=" << node_bytes + reference_bytes + root_bytes + time_bytes
+            << " native_accel_bytes=" << native_bytes << " managed_peak_bytes=" << memory.peak
+            << '\n';
+  if (mismatch || ray_mismatch || repeated_ray_mismatch || repeated_distance_mismatch) {
+    throw std::runtime_error("OptiX prototype comparison failed");
+  }
+}
+
+int run_optix_prototype(int argc, char **argv)
+{
+  try {
+    if (argc < 3) {
+      throw std::runtime_error("Usage: geometry_distance_optix kernel.ptx snapshot.bin ...");
+    }
+    CHECK(cudaFree(nullptr));
+    CHECK(optixInit());
+    CUcontext cuda_context;
+    CHECK(cuCtxGetCurrent(&cuda_context));
+    OptixDeviceContext context;
+    OptixDeviceContextOptions context_options = {};
+    CHECK(optixDeviceContextCreate(cuda_context, &context_options, &context));
+    std::ifstream ptx_file(argv[1], std::ios::binary);
+    const std::string ptx((std::istreambuf_iterator<char>(ptx_file)),
+                          std::istreambuf_iterator<char>());
+    OptixPipelineCompileOptions pipeline_options = {};
+    pipeline_options.usesMotionBlur = true;
+    pipeline_options.traversableGraphFlags =
+        OPTIX_TRAVERSABLE_GRAPH_FLAG_ALLOW_SINGLE_LEVEL_INSTANCING;
+    pipeline_options.numPayloadValues = 3;
+    pipeline_options.numAttributeValues = 2;
+    pipeline_options.pipelineLaunchParamsVariableName = "proximity_params";
+    pipeline_options.usesPrimitiveTypeFlags = OPTIX_PRIMITIVE_TYPE_FLAGS_TRIANGLE |
+                                              OPTIX_PRIMITIVE_TYPE_FLAGS_CUSTOM;
+    OptixModuleCompileOptions module_options = {};
+    OptixModule module;
+    char log[8192];
+    size_t log_size = sizeof(log);
+    const auto module_result = optixModuleCreate(context,
+                                                 &module_options,
+                                                 &pipeline_options,
+                                                 ptx.data(),
+                                                 ptx.size(),
+                                                 log,
+                                                 &log_size,
+                                                 &module);
+    if (module_result != OPTIX_SUCCESS) {
+      std::cerr << log << '\n';
+      CHECK(module_result);
+    }
+    std::vector<OptixProgramGroupDesc> descriptions(4);
+    descriptions[0].kind = OPTIX_PROGRAM_GROUP_KIND_RAYGEN;
+    descriptions[0].raygen = {module, "__raygen__proximity"};
+    descriptions[1].kind = OPTIX_PROGRAM_GROUP_KIND_MISS;
+    descriptions[1].miss = {module, "__miss__proximity"};
+    for (int i = 2; i < 4; i++) {
+      descriptions[i].kind = OPTIX_PROGRAM_GROUP_KIND_HITGROUP;
+      descriptions[i].hitgroup.moduleCH = module;
+      descriptions[i].hitgroup.entryFunctionNameCH = "__closesthit__proximity";
+    }
+    descriptions[3].hitgroup.moduleIS = module;
+    descriptions[3].hitgroup.entryFunctionNameIS = "__intersection__point";
+    OptixProgramGroupOptions group_options = {};
+    std::vector<OptixProgramGroup> groups(4);
+    CHECK(optixProgramGroupCreate(
+        context, descriptions.data(), 4, &group_options, nullptr, nullptr, groups.data()));
+    OptixPipelineLinkOptions link_options = {};
+    link_options.maxTraceDepth = 1;
+    OptixPipeline pipeline;
+    CHECK(optixPipelineCreate(
+        context, &pipeline_options, &link_options, groups.data(), 4, nullptr, nullptr, &pipeline));
+    CHECK(optixPipelineSetStackSize(pipeline, 0, 0, 4096, 2));
+    for (int i = 2; i < argc; i++) {
+      run(argv[i], context, pipeline, groups);
+    }
+    CHECK(optixPipelineDestroy(pipeline));
+    for (auto group : groups) {
+      CHECK(optixProgramGroupDestroy(group));
+    }
+    CHECK(optixModuleDestroy(module));
+    CHECK(optixDeviceContextDestroy(context));
+    return 0;
+  }
+  catch (const std::exception &error) {
+    std::cerr << error.what() << '\n';
+    return 1;
+  }
+}
+
+CCL_NAMESPACE_END
+
+int main(int argc, char **argv)
+{
+  return ccl::run_optix_prototype(argc, argv);
+}
