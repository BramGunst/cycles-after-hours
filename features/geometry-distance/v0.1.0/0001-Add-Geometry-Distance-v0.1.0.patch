diff --git a/intern/cycles/blender/pointcloud_motion.h b/intern/cycles/blender/pointcloud_motion.h
new file mode 100644
--- /dev/null
+++ b/intern/cycles/blender/pointcloud_motion.h
@@ -0,0 +1,48 @@
+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+#include <cstring>
+
+#include "scene/attribute.h"
+#include "scene/pointcloud.h"
+
+CCL_NAMESPACE_BEGIN
+
+/* Finalize a newly exported deformation sample after its buffers have been synchronized. */
+inline void finalize_pointcloud_motion(PointCloud *pointcloud,
+                                       const int motion_step,
+                                       const bool size_matches,
+                                       const bool new_attribute)
+{
+  if (!new_attribute) {
+    return;
+  }
+  Attribute *attr_P = pointcloud->attributes.find(ATTR_STD_POSITION);
+  Attribute *attr_R = pointcloud->attributes.find(ATTR_STD_RADIUS);
+  const int attr_step = motion_step + 1;
+  const size_t num_points = pointcloud->num_points();
+  const packed_float3 *motion_P = attr_P->data<packed_float3>(attr_step);
+  const packed_float3 *center_P = pointcloud->get_position();
+  const float *motion_R = attr_R->data<float>(attr_step);
+  const float *center_R = pointcloud->get_radius();
+  /* Shared unchanged buffers need no comparison. Radius is part of the moving primitive. */
+  const bool have_motion =
+      size_matches &&
+      ((motion_P != center_P &&
+        std::memcmp(motion_P, center_P, num_points * sizeof(packed_float3)) != 0) ||
+       (motion_R != center_R && std::memcmp(motion_R, center_R, num_points * sizeof(float)) != 0));
+  if (!have_motion) {
+    attr_P->remove_motion();
+    attr_R->remove_motion();
+  }
+  else {
+    for (int step = 0; step < motion_step; step++) {
+      pointcloud->copy_center_to_motion_step(step);
+    }
+  }
+}
+
+CCL_NAMESPACE_END
