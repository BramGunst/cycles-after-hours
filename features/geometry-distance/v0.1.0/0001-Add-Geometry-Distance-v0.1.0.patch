+TEST(geometry_distance_scene, loose_vertex_profiles_updates)
+{
+  BuiltScene b;
+  b.object(b.mesh(plane()), translation(0, 0, -10));
+  Mesh *mesh = add_loose_vertex(b, zero_float3());
+  b.object(1, transform_identity());
+  request_geometry_distance(b, true);
+  b.publish();
+  ASSERT_FALSE(HasFatalFailure());
+  auto verify = [&](const float3 center) {
+    auto *globals = b.device->acquire_cpu_kernel_thread_globals();
+    ShaderData sd = {};
+    sd.object = 0;
+    sd.time = 0.5f;
+    float stack[SVM_STACK_SIZE] = {};
+    SVMNodeGeometryDistance op = {};
+    op.max_distance.bits = __float_as_uint(1.0f);
+    op.position_offset = SVM_STACK_INVALID;
+    op.distance_offset = 0;
+    op.factor_offset = 1;
+    op.found_offset = 2;
+    for (const float radius : {0.0f, 0.25f, 0.5f, 0.75f, 1.0f}) {
+      sd.P = center + make_float3(radius, 0, 0);
+      for (const int mode : {0, 1, 2}) {
+        op.falloff = mode;
+        svm_node_geometry_distance(&(*globals)[0], &sd, stack, op);
+        EXPECT_NEAR(stack[0], radius, 1e-6f);
+        EXPECT_EQ(stack[2], 1.0f);
+        const float x = 1 - radius;
+        EXPECT_NEAR(stack[1], mode == 0 ? x : mode == 1 ? x * x * (3 - 2 * x) :
+                                             std::sqrt(1 - radius * radius), 1e-6f);
+        if (mode == 2) {
+          EXPECT_NEAR(stack[1] * stack[1] + radius * radius, 1.0f, 1e-6f);
+        }
+      }
+    }
+    GeometryDistanceStats stats;
+    const auto excluded = geometry_distance_scene(&(*globals)[0], center, 1, 1, 0.5f, &stats);
+    EXPECT_FALSE(excluded.found);
+    const auto pruned = geometry_distance_scene(&(*globals)[0], center + make_float3(2, 0, 0),
+                                                0, 0.5f, 0.5f, &stats);
+    EXPECT_FALSE(pruned.found);
+    EXPECT_EQ(stats.points, 0);
+    b.device->release_cpu_kernel_thread_globals();
+  };
+  verify(zero_float3());
+  mesh->get_position_for_write()[0] = make_float3(0.25f, 0.5f, 1);
+  mesh->tag_position_modified();
+  mesh->tag_update(b.scene.get(), false);
+  b.publish();
+  ASSERT_FALSE(HasFatalFailure());
+  verify(make_float3(0.25f, 0.5f, 1));
+  b.scene->objects[1]->set_tfm(translation(1, 2, 3));
+  b.scene->objects[1]->tag_update(b.scene.get());
+  b.publish();
+  ASSERT_FALSE(HasFatalFailure());
+  verify(make_float3(1.25f, 2.5f, 4));
+}
