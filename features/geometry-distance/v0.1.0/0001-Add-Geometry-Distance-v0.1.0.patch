+TEST(geometry_distance_scene, public_node_bump_position)
+{
+  for (const bool explicit_position : {false, true}) {
+    BuiltScene b;
+    ShaderGraph graph;
+    auto *distance = graph.create_node<GeometryDistanceNode>();
+    if (explicit_position) {
+      auto *geometry = graph.create_node<GeometryNode>();
+      graph.connect(geometry->output("Position"), distance->input("Position"));
+    }
+    auto *displacement = graph.create_node<DisplacementNode>();
+    graph.connect(distance->output("Factor"), displacement->input("Height"));
+    graph.connect(displacement->output("Displacement"), graph.output()->input("Displacement"));
+    auto *emission = graph.create_node<EmissionNode>();
+    graph.connect(emission->output("Emission"), graph.output()->input("Surface"));
+    graph.finalize(b.scene.get(), true);
+    bool dx = false, dy = false;
+    for (ShaderNode *node : graph.nodes) {
+      if (node->type != GeometryDistanceNode::get_node_type())
+        continue;
+      ShaderOutput *position = node->input("Position")->link;
+      ASSERT_NE(position, nullptr);
+      if (position) {
+        EXPECT_EQ(position->parent->type, GeometryNode::get_node_type());
+        EXPECT_EQ(position->name(), "Position");
+        EXPECT_EQ(position->parent->bump, node->bump);
+      }
+      dx |= node->bump == SHADER_BUMP_DX;
+      dy |= node->bump == SHADER_BUMP_DY;
+    }
+    EXPECT_TRUE(dx);
+    EXPECT_TRUE(dy);
+  }
+}
