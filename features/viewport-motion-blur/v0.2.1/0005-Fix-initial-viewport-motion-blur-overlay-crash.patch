From 2c58aabc79121df884358236b28d4a56468f0c6c Mon Sep 17 00:00:00 2001
From: Bram Gunst <bram.gunst@gmail.com>
Date: Tue, 22 Sep 2026 21:00:58 +0200
Subject: [PATCH] Fix initial viewport motion blur overlay crash

---
 .../draw/engines/external/external_engine.cc  | 31 ++++++++++---------
 1 file changed, 16 insertions(+), 15 deletions(-)

diff --git a/source/blender/draw/engines/external/external_engine.cc b/source/blender/draw/engines/external/external_engine.cc
index 7fc5811d450..b4a294d7079 100644
--- a/source/blender/draw/engines/external/external_engine.cc
+++ b/source/blender/draw/engines/external/external_engine.cc
@@ -210,6 +210,20 @@ class Instance : public DrawEngine {
   {
     draw_ctx = DRW_context_get();
     do_prepass = DRW_render_check_grease_pencil(draw_ctx->depsgraph, draw_ctx->v3d);
+
+    /* Synchronize the external renderer before populating draw caches. Its first update
+     * can evaluate geometry (for example, Cycles shutter samples), invalidating batches
+     * that the overlay and depth passes would otherwise already reference. */
+    RegionView3D *rv3d = draw_ctx->rv3d;
+    if (rv3d && !rv3d->view_render) {
+      RenderEngineType *engine_type = ED_view3d_engine_type(draw_ctx->scene,
+                                                           draw_ctx->v3d->shading.type);
+      if (engine_type->view_update && engine_type->view_draw) {
+        rv3d->view_render = RE_NewViewRender(engine_type);
+        RenderEngine *render_engine = RE_view_engine_get(rv3d->view_render);
+        engine_type->view_update(render_engine, draw_ctx->evil_C, draw_ctx->depsgraph);
+      }
+    }
   }
 
   void begin_sync() final
@@ -239,23 +253,10 @@ class Instance : public DrawEngine {
      * already applied. */
     GPU_apply_state();
 
-    /* Create render engine. */
-    RenderEngine *render_engine = nullptr;
     if (!rv3d->view_render) {
-      RenderEngineType *engine_type = ED_view3d_engine_type(draw_ctx->scene,
-                                                            draw_ctx->v3d->shading.type);
-
-      if (!(engine_type->view_update && engine_type->view_draw)) {
-        return;
-      }
-
-      rv3d->view_render = RE_NewViewRender(engine_type);
-      render_engine = RE_view_engine_get(rv3d->view_render);
-      engine_type->view_update(render_engine, draw_ctx->evil_C, draw_ctx->depsgraph);
-    }
-    else {
-      render_engine = RE_view_engine_get(rv3d->view_render);
+      return;
     }
+    RenderEngine *render_engine = RE_view_engine_get(rv3d->view_render);
 
     /* Rendered draw. */
     GPU_matrix_push_projection();
-- 
2.55.0.windows.5

