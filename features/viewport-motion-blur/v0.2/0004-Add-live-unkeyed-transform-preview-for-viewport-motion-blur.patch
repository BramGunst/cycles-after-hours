+/* Key only edited transform properties on private copies. Blender owns all interpolation,
+ * handle updates, rotation-channel handling, and evaluation of the resulting Action. */
+static blender::Main *viewport_transform_preview_begin(blender::Depsgraph &depsgraph,
+                                                       blender::Scene &scene,
+                                                       const float frame,
+                                                       blender::Vector<blender::ID *> &ids)
+{
+  using namespace blender;
+  Main *preview_main = nullptr;
+  const AnimationEvalContext context = BKE_animsys_eval_context_construct(
+      &depsgraph, frame * scene.r.framelen);
+  DEG_foreach_ID(&depsgraph, [&](ID *id) {
+    if (GS(id->name) != ID_OB) {
+      return;
+    }
+    blender::Object *object = reinterpret_cast<blender::Object *>(id);
+    AnimData *adt = object->adt;
+    /* Do not mistake NLA blending or driver results for an unkeyed user edit. */
+    if (!adt || !adt->action || !adt->nla_tracks.is_empty() || !adt->drivers.is_empty() ||
+        ID_IS_LINKED(id) || ID_IS_LINKED(adt->action))
+    {
+      return;
+    }
+    PointerRNA ptr = RNA_id_pointer_create(id);
+    const animrig::EvaluationResult evaluated = animrig::evaluate_action(
+        ptr, adt->action->wrap(), adt->slot_handle, context);
+    blender::Vector<RNAPath> paths;
+    for (const auto &item : evaluated.items()) {
+      const StringRefNull path = item.key.rna_path;
+      if (path != "location" && path != "rotation_euler" && path != "rotation_quaternion" &&
+          path != "rotation_axis_angle" && path != "scale")
+      {
+        continue;
+      }
+      float live_value;
+      PathResolvedRNA property = item.value.prop_rna;
+      if (BKE_animsys_read_from_rna_path(&property, &live_value) &&
+          fabsf(live_value - item.value.value) > 1e-6f)
+      {
+        paths.append_non_duplicates({path});
+      }
+    }
+    if (paths.is_empty()) {
+      return;
+    }
+    if (!preview_main) {
+      preview_main = BKE_main_new();
+    }
+    const int copy_flags = LIB_ID_CREATE_NO_DEG_TAG | LIB_ID_COPY_NO_PREVIEW;
+    blender::Object *preview_object = reinterpret_cast<blender::Object *>(
+        BKE_id_copy_ex(preview_main, id, nullptr, copy_flags));
+    bAction *action = reinterpret_cast<bAction *>(
+        BKE_id_copy_ex(preview_main, &adt->action->id, nullptr, copy_flags));
+    if (!animrig::assign_action(action, preview_object->id)) {
+      return;
+    }
+    preview_object->adt->slot_handle = adt->slot_handle;
+    PointerRNA preview_ptr = RNA_id_pointer_create(&preview_object->id);
+    const auto result = animrig::insert_keyframes(preview_main,
+                                                 &preview_ptr,
+                                                 std::nullopt,
+                                                 paths,
+                                                 frame,
+                                                 context,
+                                                 BEZT_KEYTYPE_KEYFRAME,
+                                                 animrig::get_keyframing_flags(&scene));
+    if (result.get_count(animrig::SingleKeyingResult::SUCCESS) > 0) {
+      DEG_set_action_eval_override(&depsgraph, id, action);
+      ids.append(id);
+    }
+  });
+  return preview_main;
+}
+
 void BlenderSync::sync_objects_and_motion(blender::RenderData &b_render,
                                           blender::Depsgraph &b_depsgraph,
                                           blender::bScreen *b_screen,
@@ -613,10 +696,14 @@ void BlenderSync::sync_objects_and_motion(blender::RenderData &b_render,
   float frame_center_delta = 0.0f;
 
   const bool graph_was_active = viewport_motion && DEG_is_active(&b_depsgraph);
+  blender::Vector<blender::ID *> preview_ids;
+  blender::Main *preview_main = nullptr;
   if (viewport_motion) {
     /* Like an offline graph, shutter evaluation must not write simulation state back to
      * originals. Do not call frame handlers or change the original scene's timeline. */
     DEG_make_inactive(&b_depsgraph);
+    preview_main = viewport_transform_preview_begin(
+        b_depsgraph, *b_scene, frame_center + subframe_center, preview_ids);
   }
   auto frame_set = [&](const int frame, const float subframe) {
     if (viewport_motion) {
@@ -633,6 +720,21 @@ void BlenderSync::sync_objects_and_motion(blender::RenderData &b_render,
       python_thread_state_restore(python_thread_state);
       frame_set(frame_center, subframe_center);
       python_thread_state_save(python_thread_state);
+      for (blender::ID *id : preview_ids) {
+        DEG_set_action_eval_override(&b_depsgraph, id, nullptr);
+      }
+      if (preview_main) {
+        /* Copies can reference geometry/materials in the user's Main. Balance those users
+         * individually; BKE_main_free intentionally skips reference counting. */
+        const int free_flags = blender::LIB_ID_FREE_NO_UI_USER | blender::LIB_ID_FREE_NO_DEG_TAG;
+        while (preview_main->objects.first) {
+          blender::BKE_id_free_ex(preview_main, preview_main->objects.first, free_flags, false);
+        }
+        while (preview_main->actions.first) {
+          blender::BKE_id_free_ex(preview_main, preview_main->actions.first, free_flags, false);
+        }
+        blender::BKE_main_free(preview_main);
+      }
       if (graph_was_active) {
         DEG_make_active(&b_depsgraph);
       }
