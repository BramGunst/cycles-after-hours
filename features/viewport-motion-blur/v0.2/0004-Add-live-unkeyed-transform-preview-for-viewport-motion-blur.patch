   const AnimationEvalContext anim_eval_context = BKE_animsys_eval_context_construct(depsgraph,
                                                                                     ctime);
+  if (adt) {
+    if (bAction *action = DEG_get_action_eval_override(depsgraph, DEG_get_original_id(id))) {
+      AnimData preview_adt = *adt;
+      preview_adt.action = action;
+      BKE_animsys_evaluate_animdata(id, &preview_adt, &anim_eval_context, ADT_RECALC_ANIM, false);
+      return;
+    }
+  }
   BKE_animsys_evaluate_animdata(id, adt, &anim_eval_context, ADT_RECALC_ANIM, flush_to_original);
 }
 
