   deg_flush_updates_and_refresh(deg_graph, sync_writeback);
 }
 
+void DEG_set_action_eval_override(Depsgraph *graph, const ID *id, bAction *action)
+{
+  deg::Depsgraph *deg_graph = reinterpret_cast<deg::Depsgraph *>(graph);
+  BLI_assert(!deg_graph->is_evaluating && !deg_graph->is_active);
+  if (action) {
+    deg_graph->action_eval_overrides.add_overwrite(id, action);
+  }
+  else {
+    deg_graph->action_eval_overrides.remove(id);
+  }
+}
+
+bAction *DEG_get_action_eval_override(const Depsgraph *graph, const ID *id)
+{
+  const deg::Depsgraph *deg_graph = reinterpret_cast<const deg::Depsgraph *>(graph);
+  return deg_graph->is_active ? nullptr : deg_graph->action_eval_overrides.lookup_default(id, nullptr);
+}
