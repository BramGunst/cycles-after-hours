+/**
+ * Borrow an Action for temporary evaluation of an original ID in an inactive graph.
+ * The caller owns the Action, must keep its slot handles compatible with the original,
+ * and must clear the override before freeing it. Never changes the original AnimData.
+ */
+void DEG_set_action_eval_override(Depsgraph *depsgraph, const ID *id, bAction *action);
+bAction *DEG_get_action_eval_override(const Depsgraph *depsgraph, const ID *id);
+
