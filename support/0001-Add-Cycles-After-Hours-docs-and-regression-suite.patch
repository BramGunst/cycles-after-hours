+import bpy
+import pathlib
+import os
+import hashlib
+import array
+import json
+
+root = (pathlib.Path(os.environ['CAH_TEST_OUTPUT_ROOT']) / 'viewport-motion-tests')
+results = {}
+for path in root.glob('*.png'):
+    image = bpy.data.images.load(str(path), check_existing=False)
+    width, height = image.size
+    if width != 1000:
+        continue
+    pixels = image.pixels[:]
+    xs, ys, crop = [], [], array.array('f')
+    for y in range(150, 620):
+        for x in range(100, 790):
+            offset = (y * width + x) * 4
+            r, g, b, a = pixels[offset:offset+4]
+            crop.extend((r, g, b, a))
+            if r - g > 0.06 and r - b > 0.06:
+                xs.append(x)
+                ys.append(y)
+    results[path.stem] = {
+        'bbox': [min(xs), max(xs), min(ys), max(ys)] if xs else None,
+        'colored_pixels': len(xs),
+        'pixel_hash': hashlib.sha256(crop.tobytes()).hexdigest(),
+    }
+(root / 'metrics.json').write_text(json.dumps(results, indent=2))
+def width(name):
+    box = results[name]['bbox']
+    return box[1] - box[0] + 1
+
+assert width('on') > width('off') * 2
+assert width('shutter1') > width('on')
+assert width('master_off') == width('off') == width('static')
+assert results['start']['bbox'][0] >= results['off']['bbox'][0] - 2
+assert results['end']['bbox'][1] <= results['off']['bbox'][1] + 2
+assert width('geometry_nodes') > width('static') * 2
+assert width('deform_on') > width('deform_off')
+assert width('scale') > width('static')
+assert results['rotation']['bbox'][3] - results['rotation']['bbox'][2] > 80
+assert results['deleted']['bbox'] is None
+for first, second in [
+    ('master_on', 'settled'),
+    ('camera_view', 'camera_settled'),
+    ('animated_camera', 'animated_camera_settled'),
+    ('orbit', 'orbit_settled'),
+    ('driver', 'return_frame'),
+]:
+    assert results[first]['pixel_hash'] == results[second]['pixel_hash'], (first, second)
+assert results['rolling_none']['pixel_hash'] != results['rolling_on']['pixel_hash']
+assert results['rolling_on']['pixel_hash'] != results['rolling_duration']['pixel_hash']
+assert results['rolling_duration']['pixel_hash'] != results['denoising']['pixel_hash']
+print('VIEWPORT_IMAGE_ASSERTIONS_PASS')
+print(json.dumps(results, indent=2))
