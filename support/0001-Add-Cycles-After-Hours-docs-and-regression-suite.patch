+import bpy
+import pathlib
+import os
+import sys
+import json
+
+case = next((a.split('=', 1)[1] for a in sys.argv if a.startswith('--case=')), 'before')
+root = (pathlib.Path(os.environ['CAH_TEST_OUTPUT_ROOT']) / 'motion-steps-tests') / case
+results = {}
+for path in sorted(root.glob('*.png')):
+    image = bpy.data.images.load(str(path), check_existing=False)
+    pixels = image.pixels[:]
+    width, height = image.size
+    counts = dict(A=0, B=0, C=0, D=0)
+    for y in range(150, min(650, height)):
+        for x in range(150, min(700, width)):
+            p = (y * width + x) * 4
+            r, g, b = pixels[p:p+3]
+            if r > g + .1 and r > b + .1:
+                counts['A'] += 1
+            elif g > r + .1 and g > b + .1:
+                counts['B'] += 1
+            elif b > r + .1 and b > g + .1:
+                counts['C'] += 1
+            elif r > b + .1 and g > b + .1:
+                counts['D'] += 1
+    results[path.stem] = counts
+    bpy.data.images.remove(image)
+reference = results['initial']
+failures = []
+for name, counts in results.items():
+    if name.startswith('slow') or name == 'fast_settled':
+        for obj in ['B', 'C', 'D']:
+            if abs(counts[obj] - reference[obj]) > max(5, reference[obj] * .03):
+                failures.append((name, obj, reference[obj], counts[obj]))
+    for obj, count in counts.items():
+        if count < 200:
+            failures.append((name, obj, 'object missing', count))
+report = {'counts': results, 'failures': failures}
+(root / 'metrics.json').write_text(json.dumps(report, indent=2))
+print(json.dumps(report, indent=2))
+if '--require-pass' in sys.argv:
+    assert not failures, failures
+    print('MOTION_STEPS_IMAGE_CHECK_PASS')
