+"""Check Cycles debug logs from accumulation-test.py, without custom source diagnostics.
+
+Run with the bundled Python: accumulation-check.py LOG [--require-pass].
+Screenshots supplement these scheduler checks with the visible GUI sample count.
+"""
+import json
+import pathlib
+import re
+import sys
+
+stages = {}
+stage = None
+divider = None
+pending_reset = False
+for line in pathlib.Path(sys.argv[1]).read_text(errors='replace').splitlines():
+    match = re.search(r'MBTEST BEGIN (\w+)', line)
+    if match:
+        stage = stages.setdefault(match[1], {
+            'resets': 0, 'samples_since_reset': 0, 'largest_batch': 0,
+            'captures': [], 'motion_times': [], 'resets_since_capture': 0,
+        })
+    if stage is None:
+        continue
+    if 'Calculated resolution divider is' in line:
+        pending_reset = True
+    match = re.search(r'Will path trace \d+ samples at the resolution divider (\d+)', line)
+    if match:
+        next_divider = int(match[1])
+        if pending_reset or (divider is not None and next_divider > divider):
+            stage['resets'] += 1
+            stage['resets_since_capture'] += 1
+            stage['samples_since_reset'] = 0
+        if next_divider != divider:
+            stage['samples_since_reset'] = 0
+        divider = next_divider
+        pending_reset = False
+    match = re.search(r'Rendered (\d+) samples in', line)
+    if match and divider == 1:
+        batch = int(match[1])
+        stage['samples_since_reset'] += batch
+        stage['largest_batch'] = max(stage['largest_batch'], batch)
+    match = re.search(r'Synchronizing motion for the relative time ([-\d.]+)', line)
+    if match:
+        stage['motion_times'].append(float(match[1].rstrip('.')))
+    if 'MBTEST CAPTURE' in line:
+        stage['captures'].append({
+            'samples': stage['samples_since_reset'],
+            'resets': stage['resets_since_capture'],
+        })
+        stage['resets_since_capture'] = 0
+
+print(json.dumps(stages, indent=2))
+if '--require-pass' in sys.argv:
+    assert stages, 'No test stages found'
+    for name, result in stages.items():
+        captures = result['captures']
+        assert len(captures) == 6, (name, 'incomplete', captures)
+        # Denoising can make a two-thread CPU run slow. Check convergence, not throughput.
+        assert captures[-1]['samples'] > 1, (name, result)
+        assert all(c['resets'] == 0 for c in captures[2:]), (name, result)
