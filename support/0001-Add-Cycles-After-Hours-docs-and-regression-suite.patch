+            run(name + '-check', [sys.executable, scripts / 'accumulation-check.py',
+                                  output / (name + '.log'), '--require-pass'],
+                'ACCUMULATION_CHECK_PASS')
+        report['status'] = 'passed'
+    except Exception as exc:
+        report['status'] = 'failed'
+        report['error'] = str(exc)
+        raise
+    finally:
+        (output / 'summary.json').write_text(json.dumps(report, indent=2))
+    print('FEATURE_001_REGRESSION_PASS', flush=True)
+
+
+if __name__ == '__main__':
+    main()
