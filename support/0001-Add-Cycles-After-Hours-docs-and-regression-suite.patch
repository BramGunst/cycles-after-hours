+"""Run existing Feature 001 regressions against one Blender, without rebuilding it."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--blender', required=True, type=Path)
+    parser.add_argument('--output-root', required=True, type=Path,
+                        help='New, nonexistent directory outside the source/build trees')
+    args = parser.parse_args()
+    blender = args.blender.resolve(strict=True)
+    output = args.output_root.resolve()
+    project = Path(__file__).resolve().parents[1]
+    if output.is_relative_to(project.parent) or output.is_relative_to(blender.parent):
+        parser.error('Results must be outside the source and executable directories')
+    output.mkdir(parents=True, exist_ok=False)
+    scripts = project / 'tests' / 'viewport-motion-blur' / 'scripts'
+    scene = project / 'tests' / 'viewport-motion-blur' / 'scenes' / 'motion-test.blend'
+    env = dict(os.environ, CAH_TEST_OUTPUT_ROOT=str(output), PYTHONDONTWRITEBYTECODE='1')
+    report = {'blender': str(blender), 'executable_sha256': hashlib.file_digest(
+        blender.open('rb'), 'sha256').hexdigest(), 'steps': [], 'status': 'running'}
+    (output / 'script-hashes.json').write_text(json.dumps({
+        str(p.relative_to(project)): hashlib.sha256(p.read_bytes()).hexdigest()
+        for p in [*scripts.glob('*.py'), Path(__file__).resolve(), scene]
+    }, indent=2))
+
+    def run(name, command, marker=None):
+        print('RUN', name, flush=True)
+        startup = None
+        if os.name == 'nt':
+            startup = subprocess.STARTUPINFO()
+            startup.dwFlags |= subprocess.STARTF_USESHOWWINDOW
+            startup.wShowWindow = 0
+        with (output / (name + '.log')).open('w', encoding='utf-8') as log:
+            proc = subprocess.run([str(x) for x in command], stdout=log,
+                                  stderr=subprocess.STDOUT, env=env, cwd=output,
+                                  startupinfo=startup, timeout=900)
+        if proc.returncode:
+            raise RuntimeError(f'{name}: exit {proc.returncode}; inspect its log')
+        errors = list(output.rglob('*error.txt'))
+        if errors:
+            raise RuntimeError(f'{name}: script failure: {errors}')
+        if marker and marker not in (output / (name + '.log')).read_text(errors='replace'):
+            raise RuntimeError(f'{name}: missing {marker}')
+        report['steps'].append(name)
+        print('PASS', name, flush=True)
+
+    def background(name, script, extra=(), marker=None):
+        run(name, [blender, '--background', '--factory-startup', '--python-exit-code', '1',
+                   '--python', scripts / script, '--', *extra], marker)
+
+    def gui(name, script, extra=(), large=False):
+        run(name, [blender, '--factory-startup', '--log', 'cycles', '--log-level', 'debug',
+                   '--window-geometry', '0', '0', '1800' if large else '1000',
+                   '1000' if large else '800', '--python-exit-code', '1',
+                   '--python', scripts / script, '--', *extra])
+
+    def stages(relative, count, key=None):
+        data = json.loads((output / relative).read_text())
+        found = data[key] if key else data
+        if len(found) != count:
+            raise RuntimeError(f'{relative}: expected {count} stages, got {len(found)}')
+
+    try:
+        run('version', [blender, '--version'])
+        run('scene', [blender, '--background', '--factory-startup', scene,
+                      '--python-exit-code', '1', '--python-expr',
+                      "import bpy; assert bpy.context.scene.cycles.use_viewport_motion_blur; "
+                      "assert bpy.context.scene.frame_current == 50; print('SCENE_LOAD_PASS')"],
+            'SCENE_LOAD_PASS')
+        background('f12', 'viewport-motion-test.py', marker='F12_REGRESSION_PASS')
+        gui('motion-steps', 'motion-steps-stress.py', ['--case=migration', '--extended'])
+        stages('motion-steps-tests/migration/result.json', 74)
+        background('motion-steps-metrics', 'motion-steps-metrics.py',
+                   ['--case=migration', '--require-pass'], 'MOTION_STEPS_IMAGE_CHECK_PASS')
+        gui('viewport', 'viewport-motion-test.py')
+        stages('viewport-motion-tests/viewport-result.json', 26, 'stages')
+        gui('rolling', 'viewport-motion-test.py', ['--rolling'])
+        stages('viewport-motion-tests/rolling-result.json', 5, 'stages')
+        background('viewport-metrics', 'viewport-motion-metrics.py',
+                   marker='VIEWPORT_IMAGE_ASSERTIONS_PASS')
+        for name, extra, count in [('accumulation', [], 14),
+                                   ('camera-denoise', ['--camera', '--end', '--denoise',
+                                                       '--diagnose'], 3)]:
+            gui(name, 'accumulation-test.py', ['--case=' + name, *extra], large=True)
