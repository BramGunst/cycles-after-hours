+"""Multi-object rendered viewport regression. Run in a Blender GUI process."""
+import bpy
+import json
+import math
+import pathlib
+import os
+import sys
+from mathutils import Quaternion
+
+case = next((a.split('=', 1)[1] for a in sys.argv if a.startswith('--case=')), 'baseline')
+root = (pathlib.Path(os.environ['CAH_TEST_OUTPUT_ROOT']) / 'motion-steps-tests') / case
+root.mkdir(parents=True, exist_ok=True)
+bpy.context.preferences.view.show_splash = False
+scene = bpy.context.scene
+bpy.ops.object.select_all(action='SELECT')
+bpy.ops.object.delete(use_global=False)
+scene.render.engine = 'CYCLES'
+scene.cycles.device = 'CPU'
+scene.cycles.preview_samples = 32 if '--denoise' in sys.argv else 64
+scene.cycles.use_preview_adaptive_sampling = False
+scene.cycles.use_preview_denoising = '--denoise' in sys.argv
+scene.render.use_motion_blur = True
+scene.render.motion_blur_shutter = .8
+scene.cycles.use_viewport_motion_blur = True
+scene.world.color = (0, 0, 0)
+
+def cube(name, location, color):
+    bpy.ops.mesh.primitive_cube_add(size=1, location=location)
+    obj = bpy.context.object
+    obj.name = name
+    mat = bpy.data.materials.new(name)
+    nodes = mat.node_tree.nodes
+    nodes.clear()
+    emission = nodes.new('ShaderNodeEmission')
+    emission.inputs['Color'].default_value = (*color, 1)
+    output = nodes.new('ShaderNodeOutputMaterial')
+    mat.node_tree.links.new(emission.outputs[0], output.inputs['Surface'])
+    obj.data.materials.append(mat)
+    return obj
+
+a = cube('A_Red_Rotor', (-2, 2, 0), (1, .01, .01))
+a.scale = (2.2, .25, .25)
+for frame, angle in [(49, -math.pi), (50, 0), (51, math.pi)]:
+    a.rotation_euler.z = angle
+    a.keyframe_insert(data_path='rotation_euler', frame=frame)
+a.cycles.motion_steps = 1
+b = cube('B_Green_Moving', (2, 2, 0), (.01, 1, .01))
+for frame, y in [(49, 1), (50, 2), (51, 3)]:
+    b.location.y = y
+    b.keyframe_insert(data_path='location', frame=frame)
+b.cycles.motion_steps = 3
+c = cube('C_Blue_Static', (-2, -2, 0), (.01, .01, 1))
+c.cycles.use_motion_blur = False
+d = cube('D_Yellow_Deforming', (2, -2, 0), (1, 1, .01))
+d.shape_key_add(name='Basis')
+key = d.shape_key_add(name='Stretch')
+for v in key.data:
+    v.co.x *= 2.5
+for frame, value in [(49, 0), (50, .5), (51, 1)]:
+    key.value = value
+    key.keyframe_insert(data_path='value', frame=frame)
+d.cycles.motion_steps = 2
+scene.frame_set(50)
+area = next(x for x in bpy.context.screen.areas if x.type == 'VIEW_3D')
+space = area.spaces.active
+space.region_3d.view_rotation = Quaternion((1, 0, 0, 0))
+space.region_3d.view_location = (0, 0, 0)
+space.region_3d.view_distance = 12
+space.region_3d.view_perspective = 'ORTHO'
+space.overlay.show_overlays = False
+space.show_gizmo = False
+space.shading.type = 'RENDERED'
+
+sequence = [1, 2, 4, 1, 3, 4, 2]
+stages = [('initial', lambda: None, 4.0)]
+for repeat in range(2):
+    for i, steps in enumerate(sequence):
+        stages.append((f'slow_{repeat}_{i}_{steps}',
+                       lambda s=steps: setattr(a.cycles, 'motion_steps', s), 3.0))
+for repeat in range(4):
+    for i, steps in enumerate(sequence):
+        stages.append((f'fast_{repeat}_{i}_{steps}',
+                       lambda s=steps: setattr(a.cycles, 'motion_steps', s), .12))
+stages.append(('fast_settled', lambda: None, 4.0))
+for name, obj in [('b', b), ('d', d), ('a', a), ('b_again', b)]:
+    for steps in [1, 4, 2]:
+        stages.append((f'multi_{name}_{steps}',
+                       lambda o=obj, s=steps: setattr(o.cycles, 'motion_steps', s), 2.0))
+stages.append(('final_settled', lambda: None, 4.0))
+if '--extended' in sys.argv:
+    def deform_transform():
+        for frame, x in [(49, 1.5), (50, 2), (51, 2.5)]:
+            d.location.x = x
+            d.keyframe_insert(data_path='location', frame=frame)
+        a.cycles.motion_steps = 1
+        d.cycles.motion_steps = 4
+        scene.frame_set(50)
+    def equal_size_swap(reverse=False):
+        a.cycles.motion_steps = 1 if reverse else 4
+        d.cycles.motion_steps = 4 if reverse else 1
+    def camera_motion():
+        bpy.ops.object.camera_add(location=(0, 0, 15))
+        camera = bpy.context.object
+        camera.data.type = 'ORTHO'
+        camera.data.ortho_scale = 12
+        for frame, x in [(49, -1), (50, 0), (51, 1)]:
+            camera.location.x = x
+            camera.keyframe_insert(data_path='location', frame=frame)
+        scene.camera = camera
+        scene.frame_set(50)
+        space.region_3d.view_perspective = 'CAMERA'
+    duplicate = None
+    def duplicate_object():
+        global duplicate
+        duplicate = b.copy()
+        duplicate.data = b.data.copy()
+        duplicate.delta_location = (0, 0, -1)
+        scene.collection.objects.link(duplicate)
+    def delete_duplicate():
+        bpy.data.objects.remove(duplicate, do_unlink=True)
+    stages += [
+        ('layout_setup', deform_transform, 4.0),
+        ('equal_size_swap', equal_size_swap, 4.0),
+        ('equal_size_swap_back', lambda: equal_size_swap(True), 4.0),
+        ('object_off', lambda: setattr(a.cycles, 'use_motion_blur', False), 4.0),
+        ('object_on', lambda: setattr(a.cycles, 'use_motion_blur', True), 4.0),
+        ('deformation_off', lambda: setattr(d.cycles, 'use_deform_motion', False), 4.0),
+        ('deformation_on', lambda: setattr(d.cycles, 'use_deform_motion', True), 4.0),
+        ('frame', lambda: scene.frame_set(51), 4.0),
+        ('subframe', lambda: scene.frame_set(50, subframe=.25), 4.0),
+        ('shutter', lambda: setattr(scene.render, 'motion_blur_shutter', .5), 4.0),
+        ('shutter_start', lambda: setattr(scene.render, 'motion_blur_position', 'START'), 4.0),
+        ('shutter_end', lambda: setattr(scene.render, 'motion_blur_position', 'END'), 4.0),
+        ('camera_motion', camera_motion, 4.0),
+        ('navigation', lambda: (setattr(space.region_3d, 'view_perspective', 'ORTHO'),
+             setattr(space.region_3d, 'view_rotation', Quaternion((1, 0, 0), .2))), 4.0),
+        ('duplicate', duplicate_object, 4.0),
+        ('delete_duplicate', delete_duplicate, 4.0),
+        ('end_settled', lambda: None, 4.0),
+    ]
+index = -1
+results = []
+expected_time = 50
+
+def tick():
+    global index, expected_time
+    try:
+        if index >= 0:
+            name, _, delay = stages[index]
+            if delay >= 2:
+                bpy.ops.screen.screenshot(filepath=str(root / f'{name}.png'))
+            assert scene.frame_current_final == expected_time
+            assert bpy.context.evaluated_depsgraph_get().scene_eval.frame_current_final == expected_time
+            print('STEPS_CAPTURE', name, flush=True)
+            results.append(name)
+        index += 1
+        if index == len(stages):
+            (root / 'result.json').write_text(json.dumps(results))
+            bpy.ops.wm.quit_blender()
+            return None
+        name, action, delay = stages[index]
+        print('STEPS_BEGIN', name, flush=True)
+        action()
+        expected_time = scene.frame_current_final
+        return delay
+    except Exception:
+        import traceback
+        (root / 'error.txt').write_text(traceback.format_exc())
+        bpy.ops.wm.quit_blender()
+        return None
+
+bpy.app.timers.register(tick, first_interval=2.0)
